diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7QemuVirtioBlk.cpp b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7QemuVirtioBlk.cpp
new file mode 100644
index 0000000..a7ecd81
--- /dev/null
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7QemuVirtioBlk.cpp
@@ -0,0 +1,268 @@
+#ifdef J1_QEMU_PL011
+/* QEMU "virt" bring-up root disk: virtio-blk over the legacy (v1) virtio-mmio transport, polled and read-only.
+ * Start QEMU with: -global virtio-mmio.force-legacy=true -drive file=root.img,if=none,format=raw,id=hd0
+ *                  -device virtio-blk-device,drive=hd0
+ * The disk is a raw HFS+ volume; IOS7QemuHFSDriver publishes it as an IOMedia with content "Apple_HFS", which is what
+ * the BSD root matcher waits for. */
+#include <IOKit/storage/IOBlockStorageDevice.h>
+#include <IOKit/storage/IOBlockStorageDriver.h>
+#include <IOKit/storage/IOMedia.h>
+#include <IOKit/IOCatalogue.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <kern/debug.h>
+#include "IOS7LabStoragePersonalities.h"
+
+#define VIO_BASE 0x0a000000U
+#define VIO_SLOT 0x200U
+#define VIO_SLOTS 32U
+#define VIO_MAGIC 0x74726976U /* "virt" */
+
+/* Legacy virtio-mmio registers. */
+#define R_MAGIC 0x000
+#define R_VERSION 0x004
+#define R_DEVICE_ID 0x008
+#define R_HOST_FEATURES 0x010
+#define R_GUEST_FEATURES 0x020
+#define R_GUEST_PAGE_SIZE 0x028
+#define R_QUEUE_SEL 0x030
+#define R_QUEUE_NUM_MAX 0x034
+#define R_QUEUE_NUM 0x038
+#define R_QUEUE_ALIGN 0x03c
+#define R_QUEUE_PFN 0x040
+#define R_QUEUE_NOTIFY 0x050
+#define R_INT_STATUS 0x060
+#define R_INT_ACK 0x064
+#define R_STATUS 0x070
+#define R_CONFIG 0x100
+
+#define ST_ACK 1U
+#define ST_DRIVER 2U
+#define ST_DRIVER_OK 4U
+
+#define QSIZE 16U
+#define VRING_DESC_F_NEXT 1U
+#define VRING_DESC_F_WRITE 2U
+#define MAX_XFER 0x10000U /* bytes per request */
+
+struct vring_desc { uint64_t addr; uint32_t len; uint16_t flags; uint16_t next; };
+
+static const char qemuPersonalities[] =
+ "<array>"
+ "<dict><key>IOClass</key><string>IOS7QemuHFSDriver</string><key>IOProviderClass</key><string>IOS7QemuVirtioBlk</string>"
+ "<key>IOProbeScore</key><integer>10000</integer></dict>"
+ "<dict><key>IOClass</key><string>IOMediaBSDClient</string><key>IOMatchCategory</key><string>IOMediaBSDClient</string>"
+ "<key>IOProbeScore</key><integer>30000</integer><key>IOProviderClass</key><string>IOMedia</string>"
+ "<key>IOResourceMatch</key><string>IOBSD</string></dict>"
+ "</array>";
+
+class IOS7QemuVirtioBlk : public IOBlockStorageDevice {
+ OSDeclareDefaultStructors(IOS7QemuVirtioBlk)
+ IOMemoryDescriptor *mmio; IOMemoryMap *map; volatile UInt8 *regs;
+ IOLock *mutex;
+ void *ring; IOPhysicalAddress ringPA;     /* descriptor table + avail + (aligned) used ring */
+ uint8_t *dma; IOPhysicalAddress dmaPA;    /* request header, status byte, data */
+ UInt64 sectors; UInt16 availIdx, usedSeen; bool initialized;
+ UInt32 rd(unsigned off) { __asm__ __volatile__("dsb sy":::"memory"); UInt32 v=*(volatile UInt32 *)(regs+off); return v; }
+ void wr(unsigned off,UInt32 v) { *(volatile UInt32 *)(regs+off)=v; __asm__ __volatile__("dsb sy":::"memory"); }
+ bool findSlot();
+ bool setupQueue();
+ IOReturn transfer(UInt64 sector,UInt32 count,uint8_t *buf,bool writing);
+public:
+ UInt64 sectorCount() const { return sectors; }
+ virtual bool init(OSDictionary *properties=0);
+ virtual bool start(IOService *provider);
+ virtual void free();
+ virtual IOReturn doAsyncReadWrite(IOMemoryDescriptor *,UInt64,UInt64,IOStorageAttributes *,IOStorageCompletion *);
+ virtual IOReturn doEjectMedia(){return kIOReturnUnsupported;}
+ virtual IOReturn doFormatMedia(UInt64){return kIOReturnUnsupported;}
+ virtual UInt32 doGetFormatCapacities(UInt64 *,UInt32)const{return 0;}
+ virtual IOReturn doLockUnlockMedia(bool){return kIOReturnUnsupported;}
+ virtual IOReturn doSynchronizeCache(){return kIOReturnSuccess;}
+ virtual char *getVendorString();virtual char *getProductString();
+ virtual char *getRevisionString();virtual char *getAdditionalDeviceInfoString();
+ virtual IOReturn reportBlockSize(UInt64 *);
+ virtual IOReturn reportMaxValidBlock(UInt64 *);
+ virtual IOReturn reportEjectability(bool *);
+ virtual IOReturn reportLockability(bool *);
+ virtual IOReturn reportRemovability(bool *);
+ virtual IOReturn reportMediaState(bool *,bool *);
+ virtual IOReturn reportPollRequirements(bool *,bool *);
+ virtual IOReturn reportWriteProtection(bool *);
+};
+OSDefineMetaClassAndStructors(IOS7QemuVirtioBlk,IOBlockStorageDevice)
+
+bool IOS7QemuVirtioBlk::init(OSDictionary *p)
+{
+ mmio=0; map=0; regs=0; mutex=0; ring=0; ringPA=0; dma=0; dmaPA=0; sectors=0; availIdx=0; usedSeen=0; initialized=false;
+ if(!IOBlockStorageDevice::init(p)) return false;
+ return true;
+}
+bool IOS7QemuVirtioBlk::findSlot()
+{
+ /* Map all 32 virtio-mmio transports once, then pick the first block device. */
+ mmio=IOMemoryDescriptor::withPhysicalAddress(VIO_BASE,VIO_SLOT*VIO_SLOTS,kIODirectionInOut);
+ if(!mmio) return false;
+ map=mmio->map(kIOMapInhibitCache);
+ if(!map||!map->getAddress()) return false;
+ volatile UInt8 *base=(volatile UInt8 *)map->getAddress();
+ for(UInt32 i=0;i<VIO_SLOTS;i++){
+  regs=base+i*VIO_SLOT;
+  if(rd(R_MAGIC)!=VIO_MAGIC) continue;
+  if(rd(R_DEVICE_ID)!=2U) continue; /* 2 = block device */
+  UInt32 ver=rd(R_VERSION);
+  IOLog("QEMU virtio-blk: slot %u version %u\n",(unsigned)i,(unsigned)ver);
+  if(ver!=1U){ IOLog("QEMU virtio-blk: need legacy transport (-global virtio-mmio.force-legacy=true)\n"); return false; }
+  return true;
+ }
+ IOLog("QEMU virtio-blk: no block device found\n");
+ return false;
+}
+bool IOS7QemuVirtioBlk::setupQueue()
+{
+ /* Legacy layout: descriptors, then avail ring, then the used ring on the next QueueAlign boundary. */
+ const vm_size_t ringBytes=8192, dmaBytes=0x1000+MAX_XFER;
+ ring=IOMallocContiguous(ringBytes,4096,&ringPA);
+ dma=(uint8_t *)IOMallocContiguous(dmaBytes,4096,&dmaPA);
+ if(!ring||!dma||!ringPA||!dmaPA) return false;
+ bzero(ring,ringBytes); bzero(dma,dmaBytes);
+ wr(R_STATUS,0);
+ wr(R_STATUS,ST_ACK); wr(R_STATUS,ST_ACK|ST_DRIVER);
+ wr(R_GUEST_FEATURES,0);
+ wr(R_GUEST_PAGE_SIZE,4096);
+ wr(R_QUEUE_SEL,0);
+ UInt32 max=rd(R_QUEUE_NUM_MAX);
+ if(max<QSIZE){ IOLog("QEMU virtio-blk: queue too small (%u)\n",(unsigned)max); return false; }
+ wr(R_QUEUE_NUM,QSIZE);
+ wr(R_QUEUE_ALIGN,4096);
+ wr(R_QUEUE_PFN,(UInt32)(ringPA>>12));
+ wr(R_STATUS,ST_ACK|ST_DRIVER|ST_DRIVER_OK);
+ /* config space: 64-bit capacity in 512-byte sectors. */
+ UInt32 lo=rd(R_CONFIG), hi=rd(R_CONFIG+4);
+ sectors=((UInt64)hi<<32)|lo;
+ return sectors!=0;
+}
+IOReturn IOS7QemuVirtioBlk::transfer(UInt64 sector,UInt32 count,uint8_t *out,bool writing)
+{
+ /* dma layout: [0..15] request header, [16] status, [0x1000..] data. */
+ uint8_t *hdr=dma, *status=dma+16, *data=dma+0x1000;
+ vring_desc *desc=(vring_desc *)ring;
+ volatile UInt16 *avail=(volatile UInt16 *)((uint8_t *)ring+QSIZE*16U);   /* flags, idx, ring[] */
+ volatile UInt8 *usedRing=(volatile UInt8 *)ring+4096;                    /* flags(2), idx(2), ring[] */
+ volatile UInt16 *usedIdx=(volatile UInt16 *)(usedRing+2);
+ UInt32 bytes=count*512U;
+ if(!count||bytes>MAX_XFER) return kIOReturnBadArgument;
+ ((UInt32 *)hdr)[0]=writing?1U:0U; /* VIRTIO_BLK_T_OUT / VIRTIO_BLK_T_IN */
+ ((UInt32 *)hdr)[1]=0;
+ ((UInt64 *)hdr)[1]=sector;
+ *status=0xff;
+ if(writing) bcopy(out,data,bytes);
+ desc[0].addr=dmaPA; desc[0].len=16; desc[0].flags=VRING_DESC_F_NEXT; desc[0].next=1;
+ desc[1].addr=dmaPA+0x1000; desc[1].len=bytes;
+ desc[1].flags=writing?VRING_DESC_F_NEXT:(VRING_DESC_F_NEXT|VRING_DESC_F_WRITE); desc[1].next=2;
+ desc[2].addr=dmaPA+16; desc[2].len=1; desc[2].flags=VRING_DESC_F_WRITE; desc[2].next=0;
+ avail[2+(availIdx%QSIZE)]=0; /* head descriptor 0 */
+ __asm__ __volatile__("dsb sy":::"memory");
+ availIdx++; avail[1]=availIdx;
+ __asm__ __volatile__("dsb sy":::"memory");
+ wr(R_QUEUE_NOTIFY,0);
+ for(UInt32 spin=0;spin<50000000U;spin++){
+  __asm__ __volatile__("dsb sy":::"memory");
+  if(*usedIdx!=usedSeen) break;
+ }
+ if(*usedIdx==usedSeen) return kIOReturnTimeout;
+ usedSeen++;
+ wr(R_INT_ACK,rd(R_INT_STATUS));
+ if(*status!=0) return kIOReturnIOError;
+ if(!writing) bcopy(data,out,bytes);
+ return kIOReturnSuccess;
+}
+bool IOS7QemuVirtioBlk::start(IOService *provider)
+{
+ if(!IOBlockStorageDevice::start(provider)) return false;
+ mutex=IOLockAlloc(); if(!mutex) return false;
+ if(!findSlot()||!setupQueue()) return false;
+ initialized=true;
+ IOLog("QEMU virtio-blk: sectors=%llu (%llu MB)\n",(unsigned long long)sectors,(unsigned long long)(sectors>>11));
+ /* Generic block driver + MBR (FDisk) partition scheme + BSD client: the 0xAF partitions become Apple_HFS disk0s1/s2. */
+ OSObject *dec=OSUnserializeXML(ios7labStoragePersonalities);
+ OSArray *drv=OSDynamicCast(OSArray,dec);
+ if(!drv||!gIOCatalogue->addDrivers(drv,false)){ if(dec)dec->release(); return false; }
+ dec->release();
+ return true;
+}
+void IOS7QemuVirtioBlk::free()
+{
+ if(mutex)IOLockFree(mutex);
+ if(map)map->release();
+ if(mmio)mmio->release();
+ IOBlockStorageDevice::free();
+}
+char *IOS7QemuVirtioBlk::getVendorString(){static char t[]="QEMU";return t;}
+char *IOS7QemuVirtioBlk::getProductString(){static char t[]="virtio-blk";return t;}
+char *IOS7QemuVirtioBlk::getRevisionString(){static char t[]="legacy";return t;}
+char *IOS7QemuVirtioBlk::getAdditionalDeviceInfoString(){static char t[]="virtio-mmio";return t;}
+IOReturn IOS7QemuVirtioBlk::reportBlockSize(UInt64 *v){if(!v)return kIOReturnBadArgument;*v=512;return kIOReturnSuccess;}
+IOReturn IOS7QemuVirtioBlk::reportMaxValidBlock(UInt64 *v){if(!v||!initialized)return kIOReturnNotReady;*v=sectors-1;return kIOReturnSuccess;}
+IOReturn IOS7QemuVirtioBlk::reportEjectability(bool *v){if(!v)return kIOReturnBadArgument;*v=false;return kIOReturnSuccess;}
+IOReturn IOS7QemuVirtioBlk::reportLockability(bool *v){if(!v)return kIOReturnBadArgument;*v=false;return kIOReturnSuccess;}
+IOReturn IOS7QemuVirtioBlk::reportRemovability(bool *v){if(!v)return kIOReturnBadArgument;*v=false;return kIOReturnSuccess;}
+IOReturn IOS7QemuVirtioBlk::reportMediaState(bool *p,bool *c){if(!p||!c)return kIOReturnBadArgument;*p=initialized;*c=false;return kIOReturnSuccess;}
+IOReturn IOS7QemuVirtioBlk::reportPollRequirements(bool *r,bool *e){if(!r||!e)return kIOReturnBadArgument;*r=false;*e=false;return kIOReturnSuccess;}
+IOReturn IOS7QemuVirtioBlk::reportWriteProtection(bool *v){if(!v)return kIOReturnBadArgument;*v=false;return kIOReturnSuccess;}
+IOReturn IOS7QemuVirtioBlk::doAsyncReadWrite(IOMemoryDescriptor *buffer,UInt64 block,UInt64 count,
+ IOStorageAttributes *attributes,IOStorageCompletion *completion)
+{
+ if(!buffer||!completion||!completion->action||!initialized||count==0||block>=sectors||block+count>sectors||
+    count*512U!=buffer->getLength()) return kIOReturnBadArgument;
+ bool writing=(buffer->getDirection()==kIODirectionOut);
+ IOStorageCompletion saved=*completion;
+ UInt64 done=0; IOReturn result=kIOReturnSuccess;
+ uint8_t *tmp=(uint8_t *)IOMalloc((unsigned)(count*512U));
+ if(!tmp) return kIOReturnNoMemory;
+ if(writing && buffer->readBytes(0,tmp,(unsigned)(count*512U))!=(unsigned)(count*512U)){
+  IOFree(tmp,(unsigned)(count*512U)); return kIOReturnUnderrun;
+ }
+ IOLockLock(mutex);
+ while(done<count*512U && result==kIOReturnSuccess){
+  UInt32 chunk=(UInt32)(count*512U-done); if(chunk>MAX_XFER) chunk=MAX_XFER;
+  result=transfer(block+done/512U,chunk/512U,tmp+done,writing);
+  if(result==kIOReturnSuccess) done+=chunk;
+ }
+ IOLockUnlock(mutex);
+ if(!writing && result==kIOReturnSuccess && buffer->writeBytes(0,tmp,(unsigned)(count*512U))!=(unsigned)(count*512U)) result=kIOReturnUnderrun;
+ IOFree(tmp,(unsigned)(count*512U));
+ IOStorage::complete(&saved,result,result==kIOReturnSuccess?count*512U:0);
+ return kIOReturnSuccess;
+}
+
+class IOS7QemuHFSDriver : public IOBlockStorageDriver {
+ OSDeclareDefaultStructors(IOS7QemuHFSDriver)
+protected:
+ virtual IOMedia *instantiateMediaObject(UInt64,UInt64,UInt32,char *);
+};
+OSDefineMetaClassAndStructors(IOS7QemuHFSDriver,IOBlockStorageDriver)
+IOMedia *IOS7QemuHFSDriver::instantiateMediaObject(UInt64 base,UInt64 bytes,UInt32 block,char *name)
+{
+ IOMedia *media=instantiateDesiredMediaObject();
+ if(!media) return 0;
+ IOMediaAttributeMask attributes=0;
+ if(!media->init(base,bytes,block,attributes,true,false,"Apple_HFS")){ media->release(); return 0; }
+ if(name) media->setName(name);
+ IOLog("QEMU virtio-blk: published Apple_HFS media, %llu bytes\n",(unsigned long long)bytes);
+ return media;
+}
+
+void ios7qemu_register_virtio(IOService *platform)
+{
+ IOS7QemuVirtioBlk *dev=new IOS7QemuVirtioBlk;
+ if(!dev){ panic("QEMU virtio-blk allocation failed"); return; }
+ bool attached=false,ok=false;
+ if(dev->init()) attached=dev->attach(platform);
+ if(attached&&dev->start(platform)){ dev->registerService(); ok=true; }
+ if(!ok) IOLog("QEMU virtio-blk: init/attach/start failed\n");
+ if(attached&&!ok) dev->detach(platform);
+ dev->release();
+}
+#endif
