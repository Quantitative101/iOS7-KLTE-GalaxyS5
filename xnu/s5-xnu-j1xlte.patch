+
+IOReturn IOS7S5SDHCI::doAsyncReadWrite(IOMemoryDescriptor *buffer, UInt64 block, UInt64 count,
+    IOStorageAttributes *, IOStorageCompletion *completion)
+{
+    /* the window: nothing outside userdata, ever */
+    if (!buffer || !completion || !completion->action || !initialized || count == 0 || block >= DISK_SECTORS ||
+        count > DISK_SECTORS - block || count * 512U != buffer->getLength())
+        return kIOReturnBadArgument;
+    bool writing = (buffer->getDirection() == kIODirectionOut);
+    IOStorageCompletion saved = *completion;
+    /* One fixed 64 KiB bounce buffer (used under the mutex) instead of an IOMalloc of the whole request: big page-ins
+     * from the 324 MB shared cache under memory pressure made that allocation fail silently (kIOReturnNoMemory), the
+     * page came back in error and launchd looped on __sigtramp with KERN_MEMORY_ERROR (S5 runs 22/25/26). */
+    static UInt8 bounce[65536] __attribute__((aligned(64)));
+    IOReturn result = kIOReturnSuccess;
+    UInt64 done = 0;
+    IOLockLock(mutex);
+    /* No sticky "faulted" state any more: one transient error used to fail every later request. Retry a failed chunk
+     * after resetting the controller's command/data lines and waiting for the card to settle back in TRAN. */
+    for (UInt64 i = 0; i < count && result == kIOReturnSuccess;) {
+        UInt32 n = (UInt32)((count - i) > 128 ? 128 : (count - i));
+        if (writing && buffer->readBytes(i * 512U, bounce, n * 512U) != n * 512U) {
+            result = kIOReturnUnderrun;
+            break;
+        }
+        for (unsigned attempt = 0; attempt < 4; ++attempt) {
+            result = transfer(DISK_FIRST + block + i, n, bounce, writing);
+            if (result == kIOReturnSuccess)
+                break;
+            {
+                static unsigned told;
+                if (told++ < 30)
+                    IOLog("S5MMC: %s blk=%llu n=%u attempt %u failed %08x\n", writing ? "write" : "read",
+                        (unsigned long long)(block + i), (unsigned)n, attempt, (unsigned)result);
+            }
+            resetLines(6);
+            spinUs(2000);
+            waitTran();
+        }
+        if (result == kIOReturnSuccess && !writing && buffer->writeBytes(i * 512U, bounce, n * 512U) != n * 512U)
+            result = kIOReturnUnderrun;
+        if (result == kIOReturnSuccess) {
+            i += n;
+            done += n * 512ULL;
+        }
+    }
+    IOLockUnlock(mutex);
+    {
+        static unsigned nrw;
+        if (nrw < 4 || (nrw & 0x3ff) == 0)
+            IOLog("S5MMC: io#%u %s blk=%llu n=%llu rc=%08x\n", nrw, writing ? "wr" : "rd", (unsigned long long)block,
+                (unsigned long long)count, (unsigned)result);
+        nrw++;
+    }
+    s5io_reqs++;
+    if (result != kIOReturnSuccess) {
+        s5io_fails++;
+        s5io_lastfail = block;
+        static unsigned told;
+        if (told++ < 30)
+            IOLog("S5MMC: %s blk=%llu n=%llu FAILED %08x\n", writing ? "write" : "read", (unsigned long long)block,
+                (unsigned long long)count, (unsigned)result);
+    }
+    IOStorage::complete(&saved, result, result == kIOReturnSuccess ? done : 0);
+    return kIOReturnSuccess;
+}
+
+/*
+ * The kernel's text log (the console ring: header 'J1LG' + count at phys 0x1f010000, 256 KiB of text after 16 bytes,
+ * J1B_RING_PA) has no other way off this phone: TWRP has neither /dev/mem nor /proc/kcore. So every 15 s it is copied to
+ * the last 1024 sectors of the userdata window, which the iOS disk image (2.2 GB at its start) never uses. From TWRP:
+ *   dd if=/dev/block/mmcblk0p26 bs=512 skip=24765407 count=520 > ring.bin   (then tools/s4mini/ringdump.py)
+ */
+#define LOG_PA 0x1f010000U
+#define LOG_BYTES 0x41000U
+#define LOG_SECTOR (DISK_FIRST + DISK_SECTORS - 1024ULL)
+void IOS7S5SDHCI::dumpLog(unsigned n)
+{
+    static IOMemoryMap *lm;
+    if (!lm) {
+        IOMemoryDescriptor *ld = IOMemoryDescriptor::withPhysicalAddress(LOG_PA, LOG_BYTES, kIODirectionInOut);
+        lm = ld ? ld->map(kIOMapInhibitCache) : 0;
+        if (!lm || !lm->getAddress()) {
+            IOLog("S5LOG: ring map failed\n");
+            return;
+        }
+    }
+    UInt8 *buf = (UInt8 *)IOMalloc(LOG_BYTES);
+    if (!buf)
+        return;
+    bcopy((const void *)lm->getAddress(), buf, LOG_BYTES);
+    IOReturn rc = kIOReturnSuccess;
+    IOLockLock(mutex);
+    for (UInt32 s = 0; s < LOG_BYTES / 512U && rc == kIOReturnSuccess;) {
+        UInt32 k = (LOG_BYTES / 512U - s) > 64 ? 64 : (LOG_BYTES / 512U - s);
+        rc = transfer(LOG_SECTOR + s, k, buf + s * 512U, true);
+        s += k;
+    }
+    IOLockUnlock(mutex);
+    IOFree(buf, LOG_BYTES);
+    if (1)
+        IOLog("S5LOG: dump %u -> %08x io=%u fails=%u last=%llu free=%u memerr=%u@%u vfp=%u/%u/%u\n", n, (unsigned)rc, s5io_reqs, s5io_fails, (unsigned long long)s5io_lastfail, vm_page_free_count, j1_memerr_count, j1_memerr_site, j1_vfp_traps, j1_vfp_else, j1_vfp_dup_notcur);
+    dumpFrame(n);
+}
+
+/*
+ * The last presented GUI frame (480x800 BGRA, 1920-byte rows; pe_exynos3475_j1.c s5_last_frame) goes to the 3001 sectors
+ * just before the log: a header sector ("S5SHOT01", frame count, width, height, row bytes, dump number) then the pixels.
+ * Only when a new frame was presented since the last dump. From TWRP:
+ *   dd if=/dev/block/mmcblk0p26 bs=512 skip=24761311 count=3001 > shot.bin   (then s5/tools/shot.py)
+ */
+#define SHOT_SECTOR (LOG_SECTOR - 4096ULL)
+#define SHOT_BYTES (480U * 800U * 4U)
+extern "C" const void *s5_last_frame(void);
+extern "C" unsigned int s5_frame_count(void);
+void IOS7S5SDHCI::dumpFrame(unsigned n)
+{
+    static unsigned last;
+    const UInt8 *src = (const UInt8 *)s5_last_frame();
+    unsigned count = s5_frame_count();
+    if (!src || count == last)
+        return;
+    UInt8 *buf = (UInt8 *)IOMalloc(512U + SHOT_BYTES);
+    if (!buf)
+        return;
+    bzero(buf, 512);
+    bcopy("S5SHOT01", buf, 8);
+    ((UInt32 *)buf)[2] = count;
+    ((UInt32 *)buf)[3] = 480;
+    ((UInt32 *)buf)[4] = 800;
+    ((UInt32 *)buf)[5] = 1920;
+    ((UInt32 *)buf)[6] = n;
+    bcopy(src, buf + 512, SHOT_BYTES);
+    IOReturn rc = kIOReturnSuccess;
+    UInt32 total = 1U + SHOT_BYTES / 512U;
+    IOLockLock(mutex);
+    for (UInt32 s = 0; s < total && rc == kIOReturnSuccess;) {
+        UInt32 k = (total - s) > 64 ? 64 : (total - s);
+        rc = transfer(SHOT_SECTOR + s, k, buf + s * 512U, true);
+        s += k;
+    }
+    IOLockUnlock(mutex);
+    IOFree(buf, 512U + SHOT_BYTES);
+    last = count;
+    IOLog("S5SHOT: frame %u dump %u -> %08x\n", count, n, (unsigned)rc);
+}
+/*
+ * Best frame: every second the presented frame is scored by how many sampled pixels are not black; the highest-scoring one
+ * is kept in RAM and written at each dump to the slot 4096 sectors below the shot ("S5BEST01", frame count, width, height,
+ * row bytes, dump number, score, then BGRA). Catches content that is only on screen for a few seconds.
+ */
+#define BEST_SECTOR (SHOT_SECTOR - 4096ULL)
+static UInt8 *s5_best_buf;
+static unsigned s5_best_score, s5_best_count, s5_best_written = ~0U;
+void IOS7S5SDHCI::sampleBest(void)
+{
+    static unsigned last_sampled;
+    const UInt32 *src = (const UInt32 *)s5_last_frame();
+    unsigned count = s5_frame_count(), score = 0, black = 0;
+    /* only new frames; score = bright pixels (white UI text), and at least half the frame black so the fbtest
+     * colour-bar pattern never wins */
+    if (!src || count == last_sampled)
+        return;
+    last_sampled = count;
+    for (unsigned i = 0; i < 480U * 800U; i += 4) {
+        UInt32 v = src[i];
+        if ((v & 0x80U) && (v & 0x8000U) && (v & 0x800000U))
+            score++;
+        else if (!(v & 0x00e0e0e0U))
+            black++;
+    }
+    if (black < 48000U)
+        return;
+    if (score <= s5_best_score)
+        return;
+    if (!s5_best_buf && !(s5_best_buf = (UInt8 *)IOMalloc(512U + SHOT_BYTES)))
+        return;
+    bcopy(src, s5_best_buf + 512, SHOT_BYTES);
+    s5_best_score = score;
+    s5_best_count = count;
+}
+void IOS7S5SDHCI::dumpBest(unsigned n)
+{
+    if (!s5_best_buf || s5_best_written == s5_best_count)
+        return;
+    UInt8 *buf = s5_best_buf;
+    bzero(buf, 512);
+    bcopy("S5BEST01", buf, 8);
+    ((UInt32 *)buf)[2] = s5_best_count;
+    ((UInt32 *)buf)[3] = 480;
+    ((UInt32 *)buf)[4] = 800;
+    ((UInt32 *)buf)[5] = 1920;
+    ((UInt32 *)buf)[6] = n;
+    ((UInt32 *)buf)[7] = s5_best_score;
+    IOReturn rc = kIOReturnSuccess;
+    UInt32 total = 1U + SHOT_BYTES / 512U;
+    IOLockLock(mutex);
+    for (UInt32 s = 0; s < total && rc == kIOReturnSuccess;) {
+        UInt32 k = (total - s) > 64 ? 64 : (total - s);
+        rc = transfer(BEST_SECTOR + s, k, buf + s * 512U, true);
+        s += k;
+    }
+    IOLockUnlock(mutex);
+    s5_best_written = s5_best_count;
+    IOLog("S5BEST: frame %u score %u/96000 dump %u -> %08x\n", s5_best_count, s5_best_score, n, (unsigned)rc);
+}
+extern "C" void s4_dump_threads(void);
+void s5LogThread(void *arg)
+{
+    IOS7S5SDHCI *dev = (IOS7S5SDHCI *)arg;
+    for (unsigned n = 0;; ++n) {
+        if (n == 0)
+            IOSleep(3000);
+        else
+            for (unsigned t = 0; t < 75; t++) {
+                IOSleep(200);
+                dev->sampleBest();
+            }
+        if (n == 6 || n == 12 || n == 24 || n == 36)
+            s4_dump_threads(); /* user threads with wait state; SpringBoard/backboardd with user pc + frames (S5U) */
+        dev->dumpLog(n);
+        dev->dumpBest(n);
+    }
+}
+
+void ios7s5_register_mmc(IOService *platform)
+{
+    IOS7S5SDHCI *dev = new IOS7S5SDHCI;
+    if (!dev) {
+        IOLog("S5MMC: allocation failed\n");
+        return;
+    }
+    bool attached = false, ok = false;
+    if (dev->init())
+        attached = dev->attach(platform);
+    if (attached && dev->start(platform)) {
+        dev->registerService();
+        ok = true;
+    }
+    if (!ok)
+        IOLog("S5MMC: init/attach/start failed\n");
+    if (attached && !ok)
+        dev->detach(platform);
+    dev->release();
+}
+#endif
