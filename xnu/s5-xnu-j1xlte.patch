new file mode 100644
index 0000000..591babd
--- /dev/null
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7S5Touch.cpp
@@ -0,0 +1,705 @@
+#if defined(J1_S5)
+/*
+ * Galaxy S5 (SM-G900M klte) touchscreen transport for the iOS 7 HID touch service (IOS7LeoHIDTouch.cpp, J1_S5 path):
+ * ios7s5_touch_poll() powers the controller on first use, then returns the first finger in GUI pixels.
+ * It grew out of a probe (runs 69-74); the history below is how each fact was established.
+ *
+ * From the stock device tree (ref/s5-backup/boot.img QCDT, all board revisions agree):
+ *   Synaptics RMI4 ("synaptics,rmi4-ts") at I2C address 0x20 on BLSP1 QUP2 (i2c@f9924000, 400 kHz),
+ *   SDA = TLMM GPIO 6, SCL = TLMM GPIO 7, interrupt = PMA8084 GPIO 8 (on the PMIC, not the TLMM),
+ *   supplies "max77826_ldo13" (sub-PMIC, registered by Samsung board code) and "8084_lvs2" (RPM SMD resource vsa 2).
+ *   Panel coordinates 1079 x 1919.
+ *
+ * What the probe did, once, 30 s after boot, all lines tagged "S5TOUCH" (power-up and PDT steps live on in bring-up):
+ *   1. Reads the GCC branch registers for the BLSP1 AHB clock and the QUP2 I2C core clock (GCC is always clocked).
+ *   2. Reads the TLMM config and level of GPIO 6/7 (as LK left them) and the idle line levels.
+ *   3. Takes the two pins as GPIOs (function 0, pull-up, open drain emulated with OE) and bit-bangs I2C at about 100 kHz.
+ *      The QUP block itself is never accessed: reading it with its clock off would hang the bus.
+ *   4. Scans the bus (0x08-0x77), then if 0x20 answers: page 0 RMI4 PDT (functions, register bases), F01 query
+ *      (product id) and control/data, then polls the finger data for 120 s and logs every change (touch the screen).
+ *   5. Puts GPIO 6/7 back as they were.
+ * If nothing answers, the chip is most likely unpowered (LK does not turn LVS2 / MAX77826 LDO13 on): that is the answer.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOService.h>
+
+#define GCC_PA 0xfc400000U
+#define GCC_BLSP1_AHB_CBCR 0x05c4U
+#define GCC_BLSP1_QUP2_I2C_CBCR 0x0688U
+#define GCC_BRANCH_VOTE 0x1484U /* APCS clock branch enable vote; BLSP1 AHB is bit 17 */
+#define TLMM_PA 0xfd511000U     /* TLMM + 0x1000: GPIO n config at 0x10 * n, in/out at 0x10 * n + 4 */
+static UInt32 PIN_SDA = 6, PIN_SCL = 7; /* current bus: touch on 6/7, MAX77826 sub-PMIC on 29/30 */
+#define TS_ADDR 0x20U
+
+static volatile UInt32 *s5t_gcc, *s5t_tlmm;
+extern "C" int ios7s5_rpm_enable(UInt32 type, UInt32 id); /* IOS7S5RPM.cpp */
+
+/* IODelay always sleeps a whole 10 ms tick on this port (run 70 stalled in the bus scan): spin on the timebase. */
+extern "C" void machine_delay_until(uint64_t interval, uint64_t deadline);
+extern "C" uint64_t mach_absolute_time(void);
+static void spinUs(unsigned us)
+{
+    uint64_t abs = (uint64_t)us * 20U; /* generic timer 19.2 MHz */
+    machine_delay_until(abs, mach_absolute_time() + abs);
+}
+
+static inline UInt32 cfg_rd(UInt32 n) { return s5t_tlmm[(0x10U * n) / 4]; }
+static inline void cfg_wr(UInt32 n, UInt32 v) { s5t_tlmm[(0x10U * n) / 4] = v; __asm__ volatile("dsb" ::: "memory"); }
+static inline UInt32 io_rd(UInt32 n) { return s5t_tlmm[(0x10U * n + 4) / 4]; }
+static inline void io_wr(UInt32 n, UInt32 v) { s5t_tlmm[(0x10U * n + 4) / 4] = v; __asm__ volatile("dsb" ::: "memory"); }
+
+/* TLMM config: pull [1:0] (3 = up), function [5:2], drive [8:6], output enable [9]. Line low = OE on with out 0. */
+#define CFG_GPIO_PU 0x3U
+#define CFG_OE (1U << 9)
+static inline void line_low(UInt32 n) { cfg_wr(n, CFG_GPIO_PU | CFG_OE); }
+static inline void line_rel(UInt32 n) { cfg_wr(n, CFG_GPIO_PU); }
+static inline int line_in(UInt32 n) { return (int)(io_rd(n) & 1); }
+
+static void hdelay(void) { spinUs(5); }
+
+static int scl_rel(void)
+{
+    line_rel(PIN_SCL);
+    for (int i = 0; i < 1000; i++) { /* clock stretching, up to ~1 ms */
+        if (line_in(PIN_SCL))
+            return 1;
+        spinUs(1);
+    }
+    return 0;
+}
+
+static void i2c_start(void)
+{
+    line_rel(PIN_SDA);
+    scl_rel();
+    hdelay();
+    line_low(PIN_SDA);
+    hdelay();
+    line_low(PIN_SCL);
+    hdelay();
+}
+
+static void i2c_stop(void)
+{
+    line_low(PIN_SDA);
+    hdelay();
+    scl_rel();
+    hdelay();
+    line_rel(PIN_SDA);
+    hdelay();
+}
+
+/* Returns 1 on ACK. */
+static int i2c_wbyte(UInt8 b)
+{
+    int ack;
+    for (int i = 7; i >= 0; i--) {
+        if ((b >> i) & 1)
+            line_rel(PIN_SDA);
+        else
+            line_low(PIN_SDA);
+        hdelay();
+        scl_rel();
+        hdelay();
+        line_low(PIN_SCL);
+    }
+    line_rel(PIN_SDA);
+    hdelay();
+    scl_rel();
+    hdelay();
+    ack = !line_in(PIN_SDA);
+    line_low(PIN_SCL);
+    hdelay();
+    return ack;
+}
+
+static UInt8 i2c_rbyte(int ack)
+{
+    UInt8 b = 0;
+    line_rel(PIN_SDA);
+    for (int i = 0; i < 8; i++) {
+        hdelay();
+        scl_rel();
+        hdelay();
+        b = (UInt8)((b << 1) | line_in(PIN_SDA));
+        line_low(PIN_SCL);
+    }
+    if (ack)
+        line_low(PIN_SDA);
+    hdelay();
+    scl_rel();
+    hdelay();
+    line_low(PIN_SCL);
+    line_rel(PIN_SDA);
+    hdelay();
+    return b;
+}
+
+static int i2c_probe(UInt8 a)
+{
+    int ack;
+    i2c_start();
+    ack = i2c_wbyte((UInt8)(a << 1));
+    i2c_stop();
+    return ack;
+}
+
+static int i2c_read(UInt8 a, UInt8 reg, UInt8 *buf, int n)
+{
+    i2c_start();
+    if (!i2c_wbyte((UInt8)(a << 1)) || !i2c_wbyte(reg)) {
+        i2c_stop();
+        return 0;
+    }
+    i2c_start(); /* repeated start */
+    if (!i2c_wbyte((UInt8)((a << 1) | 1))) {
+        i2c_stop();
+        return 0;
+    }
+    for (int i = 0; i < n; i++)
+        buf[i] = i2c_rbyte(i < n - 1);
+    i2c_stop();
+    return 1;
+}
+
+static int i2c_write1(UInt8 a, UInt8 reg, UInt8 v)
+{
+    int ok;
+    i2c_start();
+    ok = i2c_wbyte((UInt8)(a << 1)) && i2c_wbyte(reg) && i2c_wbyte(v);
+    i2c_stop();
+    return ok;
+}
+
+struct rmi_fn {
+    UInt8 query, cmd, ctrl, data, ints, num;
+};
+
+static int s5t_state;           /* 0 not tried, 1 ready, -1 failed (no retry) */
+static int s5t_last_down;      /* last report had a finger down (keep reading every poll while down) */
+static UInt8 s5t_f01_data, s5t_f12_data;
+
+/* Power the controller and find its registers. Called from the HID service's work loop (first poll), so the
+ * ~0.5 s it takes never blocks boot. Run 74 established every step on the device. */
+static int s5_touch_bringup(void)
+{
+    IOMemoryDescriptor *gd, *td;
+    IOMemoryMap *gm, *tm;
+    struct rmi_fn fn[8];
+    int nfn = 0;
+
+    gd = IOMemoryDescriptor::withPhysicalAddress(GCC_PA, 0x2000, kIODirectionInOut);
+    td = IOMemoryDescriptor::withPhysicalAddress(TLMM_PA, 0x1000, kIODirectionInOut);
+    gm = gd ? gd->map(kIOMapInhibitCache) : 0;
+    tm = td ? td->map(kIOMapInhibitCache) : 0;
+    if (!gm || !tm || !gm->getAddress() || !tm->getAddress()) {
+        IOLog("S5TOUCH: map failed\n");
+        return 0;
+    }
+    s5t_gcc = (volatile UInt32 *)gm->getAddress();
+    s5t_tlmm = (volatile UInt32 *)tm->getAddress();
+
+    /* AVDD: MAX77826 LDO13 (GPIO 29/30 bus, address 0x60, enable = register 0x13 bit 1, voltage register 0x2c).
+     * LK leaves every MAX77826 LDO off (run 70). Only switched on when the voltage code is Linux's 3.3 V (0x64). */
+    {
+        UInt8 op = 0, vs = 0;
+        UInt32 c29 = cfg_rd(29), c30 = cfg_rd(30), i29 = io_rd(29), i30 = io_rd(30);
+        PIN_SDA = 29;
+        PIN_SCL = 30;
+        io_wr(29, 0);
+        io_wr(30, 0);
+        line_rel(29);
+        line_rel(30);
+        spinUs(100);
+        i2c_stop();
+        if (i2c_read(0x60, 0x13, &op, 1) && i2c_read(0x60, 0x2c, &vs, 1) && (vs & 0x7f) == 0x64) {
+            if (!(op & 0x02))
+                i2c_write1(0x60, 0x13, (UInt8)(op | 0x02));
+            IOLog("S5TOUCH: ldo13 on (reg13 was %02x)\n", op);
+        } else
+            IOLog("S5TOUCH: ldo13 not switched: reg13=%02x volt=%02x\n", op, vs);
+        cfg_wr(29, c29); cfg_wr(30, c30); io_wr(29, i29); io_wr(30, i30);
+        PIN_SDA = 6;
+        PIN_SCL = 7;
+    }
+    /* VDDIO: PMA8084 LVS2, owned by the RPM: SMD request (IOS7S5RPM.cpp), resource "vsa" id 2 (run 74). */
+    IOLog("S5TOUCH: lvs2 request -> %d\n", ios7s5_rpm_enable(0x00617376U, 2));
+    IOSleep(300); /* power-on reset of the controller */
+
+    /* Touch bus GPIO 6/7 as bit-banged I2C for good (the QUP2 core clock is off and the QUP is never touched). */
+    io_wr(PIN_SDA, 0);
+    io_wr(PIN_SCL, 0);
+    line_rel(PIN_SDA);
+    line_rel(PIN_SCL);
+    spinUs(100);
+    i2c_stop();
+    if (!line_in(PIN_SDA) || !line_in(PIN_SCL) || !i2c_probe(TS_ADDR)) {
+        IOLog("S5TOUCH: controller not answering (sda=%d scl=%d)\n", line_in(PIN_SDA), line_in(PIN_SCL));
+        return 0;
+    }
+    i2c_write1(TS_ADDR, 0xff, 0); /* page 0 */
+    for (int a = 0xe9; a >= 0x0a && nfn < 8; a -= 6) {
+        UInt8 e[6];
+        if (!i2c_read(TS_ADDR, (UInt8)a, e, 6) || e[5] == 0 || e[5] == 0xff)
+            break;
+        fn[nfn].query = e[0]; fn[nfn].cmd = e[1]; fn[nfn].ctrl = e[2];
+        fn[nfn].data = e[3]; fn[nfn].ints = e[4]; fn[nfn].num = e[5];
+        nfn++;
+    }
+    s5t_f01_data = s5t_f12_data = 0;
+    for (int i = 0; i < nfn; i++) {
+        if (fn[i].num == 0x01)
+            s5t_f01_data = fn[i].data;
+        if (fn[i].num == 0x12)
+            s5t_f12_data = fn[i].data;
+    }
+    {
+        UInt8 id[10] = {0};
+        for (int i = 0; i < nfn; i++)
+            if (fn[i].num == 0x01)
+                i2c_read(TS_ADDR, (UInt8)(fn[i].query + 11), id, 9);
+        IOLog("S5TOUCH: ready: %d functions, product '%.9s', f01 data %02x, f12 data %02x\n", nfn, (const char *)id,
+              s5t_f01_data, s5t_f12_data);
+    }
+    return s5t_f12_data != 0;
+}
+
+/*
+ * Hardware keys (Home, volume down/up) for the HID service: PMA8084 GPIO 3 / 2 / 5 (stock DT gpio_keys, active low;
+ * gpio@c200/c100/c400 = digital input, 30 uA pull-up). PMIC registers are reached over SPMI: arbiter v1 at
+ * 0xfc4cf000 ("core"), apps channel 0 at +0x800: CMD +0x00, STATUS +0x08 (bit 0 done, 1 failure, 2 denied,
+ * 3 dropped), RDATA0 +0x18. Command = opcode << 27 | sid << 20 | addr << 4 | (bytes - 1); EXT_READL (16-bit address)
+ * = opcode 1. Read only. Pin input level = STATUS1 (pin base + 0x08) bit 0.
+ */
+#define SPMI_CORE_PA 0xfc4cf000U
+#define SPMI_CHAN 0x800U
+static volatile UInt32 *s5k_spmi;
+
+static int spmi_read(UInt32 sid, UInt32 addr, UInt8 *buf, UInt32 len)
+{
+    UInt32 st = 0, d;
+    if (!s5k_spmi || len < 1 || len > 4)
+        return -1;
+    s5k_spmi[(SPMI_CHAN + 0x00) / 4] = 1U << 27 | (sid & 0xf) << 20 | (addr & 0xffff) << 4 | ((len - 1) & 7);
+    __asm__ volatile("dsb" ::: "memory");
+    for (int i = 0; i < 1000; i++) {
+        st = s5k_spmi[(SPMI_CHAN + 0x08) / 4];
+        if (st)
+            break;
+        spinUs(1);
+    }
+    if (!(st & 1) || (st & 0xe))
+        return -(int)(st ? st : 0x100);
+    d = s5k_spmi[(SPMI_CHAN + 0x18) / 4];
+    for (UInt32 i = 0; i < len; i++)
+        buf[i] = (UInt8)(d >> (8 * i));
+    return 0;
+}
+
+/* EXT_WRITEL (opcode 0): data goes to WDATA0 (+0x10) before the command. Used only for the Home pin's pull. */
+static int spmi_write(UInt32 sid, UInt32 addr, UInt8 val)
+{
+    UInt32 st = 0;
+    if (!s5k_spmi)
+        return -1;
+    s5k_spmi[(SPMI_CHAN + 0x10) / 4] = val;
+    __asm__ volatile("dsb" ::: "memory");
+    s5k_spmi[(SPMI_CHAN + 0x00) / 4] = 0U << 27 | (sid & 0xf) << 20 | (addr & 0xffff) << 4;
+    __asm__ volatile("dsb" ::: "memory");
+    for (int i = 0; i < 1000; i++) {
+        st = s5k_spmi[(SPMI_CHAN + 0x08) / 4];
+        if (st)
+            break;
+        spinUs(1);
+    }
+    return (st & 1) && !(st & 0xe) ? 0 : -(int)(st ? st : 0x100);
+}
+
+static int s5k_state; /* SPMI: 0 not tried, 1 ok, -1 failed */
+
+/* Touch interrupt line, PMA8084 GPIO 8 (stock DT synaptics,irq-gpio, active low, gpio@c700 digital input):
+ * 1 asserted (new data), 0 idle, -1 unknown. */
+#ifndef J1_S5_SPMI
+#define J1_S5_SPMI 1 /* J1_KFLAGS=-DJ1_S5_SPMI=0 builds without any SPMI access */
+#endif
+static int s5_touch_irq(void)
+{
+    UInt8 st1 = 1;
+    if (!J1_S5_SPMI || s5k_state != 1 || spmi_read(0, 0xc708, &st1, 1) != 0)
+        return -1;
+    return !(st1 & 1);
+}
+
+/*
+ * CPU0 clock (run 128). LK leaves CPU0 on its HFPLL at L=50 (19.2 MHz x 50 = 960 MHz). Mainline Linux
+ * drivers/clk/qcom (hfpll.c, clk-hfpll.c, clk-krait.c, krait-cc.c): HFPLL mode 0x00 (bit0 OUTCTRL, bit1 BYPASSNL,
+ * bit2 RESET_N), L 0x04, user 0x10 (VCO select bit 20 above 1248 MHz), status 0x1c (bit 16 lock); CPU0 clock mux =
+ * Krait L2 indirect register 0x4501 (mcr/mrc p15, 3, .., c15, c0, 6/7): primary [1:0] 1 HFPLL / 0 secondary,
+ * secondary [3:2] 2 = acpu_aux (GPLL0/2), both mirrored 8 bits up. CPU0 HFPLL at 0xF908A000. Runs once, from the
+ * first keys poll (backboardd up). Nothing is written unless the PLL is on, L is 30..70 and the mux is on the HFPLL.
+ * The core voltage is not changed. J1_KFLAGS=-DJ1_S5_CPU_L=0 only logs.
+ */
+#ifndef J1_S5_CPU_L
+#define J1_S5_CPU_L 78 /* 1497.6 MHz (stable, runs 128-129). 90 = 1728 MHz ran on the developer's phone but above the
+                        * bootloader's voltage for that rate: build with J1_KFLAGS=-DJ1_S5_CPU_L=90 at your own risk */
+#endif
+#define J1_S5_CPU_L_SAFE 78 /* fallback when the self-test fails at J1_S5_CPU_L */
+/* Self-test: a fixed integer + memory workload whose result must not depend on the clock. A mismatch after a
+ * clock change means the core is not stable at that frequency/voltage. */
+static UInt32 cpu_selftest(void)
+{
+    static UInt32 buf[4096];
+    UInt32 h = 2166136261U, x = 12345U;
+    for (UInt32 r = 0; r < 64; r++)
+        for (UInt32 i = 0; i < 4096; i++) {
+            x = x * 1664525U + 1013904223U;
+            buf[i] ^= x + (buf[(i * 7U + r) & 4095U] >> 3);
+            h = (h ^ buf[i]) * 16777619U;
+            h ^= (UInt32)(((unsigned long long)x * h) >> 32);
+        }
+    for (UInt32 i = 0; i < 4096; i++)
+        buf[i] = 0;
+    return h;
+}
+static UInt32 krait_l2_get(UInt32 off)
+{
+    UInt32 v;
+    __asm__ volatile("mcr p15, 3, %1, c15, c0, 6\n isb\n mrc p15, 3, %0, c15, c0, 7\n isb" : "=r"(v) : "r"(off) : "memory");
+    return v;
+}
+static void krait_l2_set(UInt32 off, UInt32 v)
+{
+    __asm__ volatile("mcr p15, 3, %0, c15, c0, 6\n isb\n mcr p15, 3, %1, c15, c0, 7\n isb" :: "r"(off), "r"(v) : "memory");
+}
+static void krait_set_pri(UInt32 sel)
+{
+    UInt32 v = krait_l2_get(0x4501);
+    v &= ~(3U | (3U << 8));
+    v |= sel | (sel << 8);
+    krait_l2_set(0x4501, v);
+    __asm__ volatile("dsb" ::: "memory");
+    spinUs(1);
+}
+/* CPU MHz from PMU cycles over 1 ms of the 19.2 MHz CNTPCT */
+static UInt32 measure_mhz(void)
+{
+    UInt32 pmcr, c0, c1, lo, hi, t0;
+    __asm__ volatile("mrc p15, 0, %0, c9, c12, 0" : "=r"(pmcr));
+    pmcr |= 1U; pmcr &= ~8U;
+    __asm__ volatile("mcr p15, 0, %0, c9, c12, 0" :: "r"(pmcr));
+    __asm__ volatile("mcr p15, 0, %0, c9, c12, 1" :: "r"(0x80000000U));
+    __asm__ volatile("isb\n mrrc p15, 0, %0, %1, c14" : "=r"(lo), "=r"(hi));
+    t0 = lo;
+    __asm__ volatile("mrc p15, 0, %0, c9, c13, 0" : "=r"(c0));
+    do { __asm__ volatile("isb\n mrrc p15, 0, %0, %1, c14" : "=r"(lo), "=r"(hi)); } while (lo - t0 < 19200U);
+    __asm__ volatile("mrc p15, 0, %0, c9, c13, 0" : "=r"(c1));
+    return (c1 - c0) / 1000U;
+}
+static void ios7s5_cpu_clock(void)
+{
+    static int done;
+    UInt32 mux, mode, l, user, i, mhz0, res = 0;
+    volatile UInt32 *pll;
+    if (done)
+        return;
+    done = 1;
+    IOMemoryDescriptor *d = IOMemoryDescriptor::withPhysicalAddress(0xF908A000U, 0x1000, kIODirectionInOut);
+    IOMemoryMap *m = d ? d->map(kIOMapInhibitCache) : 0;
+    pll = (m && m->getAddress()) ? (volatile UInt32 *)m->getAddress() : 0;
+    mux = krait_l2_get(0x4501);
+    mhz0 = measure_mhz();
+    if (!pll) {
+        IOLog("S5CLK: no HFPLL mapping, mux %08x %u MHz\n", (unsigned)mux, (unsigned)mhz0);
+        return;
+    }
+    mode = pll[0]; l = pll[1]; user = pll[4];
+    IOLog("S5CLK: before mux %08x mode %08x L %u user %08x status %08x %u MHz\n", (unsigned)mux, (unsigned)mode,
+          (unsigned)l, (unsigned)user, (unsigned)pll[7], (unsigned)mhz0);
+    if (!J1_S5_CPU_L || (mode & 7U) != 7U || l < 30U || l > 70U || (mux & 3U) != 1U) {
+        IOLog("S5CLK: not changing the clock\n");
+        return;
+    }
+    UInt32 ref = cpu_selftest(); /* at the boot clock */
+    UInt32 target = J1_S5_CPU_L;
+again:
+    {
+        boolean_t was = ml_set_interrupts_enabled(FALSE);
+        UInt32 v = krait_l2_get(0x4501);
+        v &= ~((3U << 2) | (3U << 10));
+        v |= (2U << 2) | (2U << 10); /* secondary mux -> acpu_aux */
+        krait_l2_set(0x4501, v);
+        __asm__ volatile("dsb" ::: "memory");
+        spinUs(1);
+        krait_set_pri(0); /* run from the secondary mux */
+        pll[0] = mode & ~7U;
+        __asm__ volatile("dsb" ::: "memory");
+        if (target * 192U / 10U > 1248U) user |= 0x100000U; else user &= ~0x100000U;
+        pll[4] = user;
+        pll[1] = target;
+        __asm__ volatile("dsb" ::: "memory");
+        pll[0] = (pll[0] & ~7U) | 2U; /* BYPASSNL */
+        __asm__ volatile("dsb" ::: "memory");
+        spinUs(10);
+        pll[0] |= 4U; /* RESET_N */
+        __asm__ volatile("dsb" ::: "memory");
+        for (i = 0; i < 1000U && !(pll[7] & (1U << 16)); i++)
+            spinUs(1);
+        spinUs(60);
+        pll[0] |= 1U; /* OUTCTRL */
+        __asm__ volatile("dsb" ::: "memory");
+        spinUs(1);
+        if (pll[7] & (1U << 16)) {
+            krait_set_pri(1);
+            res = 1;
+        } else {
+            /* no lock: back to the old L */
+            pll[0] &= ~7U;
+            pll[1] = l;
+            pll[4] = (l * 192U / 10U > 1248U) ? (user | 0x100000U) : (user & ~0x100000U);
+            __asm__ volatile("dsb" ::: "memory");
+            pll[0] |= 2U; spinUs(10); pll[0] |= 4U; spinUs(100); pll[0] |= 1U; spinUs(1);
+            krait_set_pri(1);
+        }
+        ml_set_interrupts_enabled(was);
+    }
+    IOLog("S5CLK: %s after %u us, mux %08x L %u status %08x, now %u MHz\n", res ? "locked" : "NO LOCK, restored",
+          (unsigned)i, (unsigned)krait_l2_get(0x4501), (unsigned)pll[1], (unsigned)pll[7], (unsigned)measure_mhz());
+    if (res) {
+        UInt32 bad = 0;
+        for (int k = 0; k < 8; k++)
+            if (cpu_selftest() != ref)
+                bad++;
+        IOLog("S5CLK: self-test at L %u: %u of 8 runs wrong (ref %08x)\n", (unsigned)target, (unsigned)bad, (unsigned)ref);
+        if (bad && target != J1_S5_CPU_L_SAFE) {
+            target = J1_S5_CPU_L_SAFE;
+            mode = pll[0] | 7U; /* the switch below expects the PLL running */
+            res = 0;
+            goto again;
+        }
+    }
+}
+
+/*
+ * Secondary core bring-up, stage 1 (run 129): wake CPU1 into a self-contained loop that only writes a mailbox
+ * (magic 'S5C1', then a counter it increments forever). XNU itself stays single-core. From mainline Linux v6.1
+ * (arch/arm/mach-qcom/platsmp.c kpssv2_release_secondary, drivers/firmware/qcom_scm*.c, qcom-msm8974.dtsi):
+ *  - boot address: legacy atomic SCM call, smc #0 with r0 = 0x401222 (svc 1 boot, cmd 1 set_addr, 2 args),
+ *    r1 = &dummy, r2 = cold-boot flags (CPU1 = 0x01), r3 = physical entry; r0 returns 0 on success.
+ *  - power-up: ACC1 0xF9098000: +0x14 = 0x403f0001, 1 us, 0x403f007f, 1 us, 0x403f3f7f; L2 SAW 0xF9012000 + 0x1c =
+ *    0x10003, 50 us; +0x04 = 0x21, 2 us, 0x20, 2 us, 0x00, 0x80.
+ *  - then a wakeup SGI to CPU1 (GIC distributor 0xF9000000 + 0xF00).
+ * CPU1 enters in ARM state with the MMU and caches off, so the loop only uses PC-relative addresses.
+ */
+extern "C" void s5_cpu1_entry(void);
+extern "C" addr64_t kvtophys(vm_offset_t va);
+extern "C" UInt32 s5_cpu1_mailbox[4];
+__asm__(
+    ".text\n"
+    ".align 6\n"
+    ".arm\n"
+    ".globl _s5_cpu1_entry\n"
+    "_s5_cpu1_entry:\n"
+    "    cpsid if\n"
+    "    adr r0, 4f\n"
+    "    ldr r1, 1f\n"
+    "    str r1, [r0]\n"
+    "    mrc p15, 0, r1, c0, c0, 5\n" /* MPIDR */
+    "    str r1, [r0, #8]\n"
+    "    dsb\n"
+    "2:  ldr r2, [r0, #4]\n"
+    "    add r2, r2, #1\n"
+    "    str r2, [r0, #4]\n"
+    "    dsb\n"
+    "    mov r3, #0x100000\n"
+    "3:  subs r3, r3, #1\n"
+    "    bne 3b\n"
+    "    b 2b\n"
+    "1:  .word 0x53354331\n"
+    ".align 6\n"
+    ".globl _s5_cpu1_mailbox\n"
+    "_s5_cpu1_mailbox:\n"
+    "4:\n"
+    "    .word 0, 0, 0, 0\n"
+    ".thumb\n");
+
+static int s5_smp_state; /* 0 not tried, 1 released, -1 failed */
+static UInt32 s5_mailbox_read(int i)
+{
+    volatile UInt32 *mb = (volatile UInt32 *)s5_cpu1_mailbox;
+    /* CPU1 writes RAM directly (caches off on that core): drop any stale line on this core first */
+    __asm__ volatile("mcr p15, 0, %0, c7, c6, 1\n dsb" :: "r"((UInt32)(uintptr_t)mb & ~63U) : "memory");
+    return mb[i];
+}
+extern "C" UInt32 s5_helper_prepare(UInt32 (*v2p)(UInt32));
+extern "C" UInt32 s5_helper_word(int i);
+extern "C" int s5_helper_enable(void);
+static UInt32 s5_v2p(UInt32 va) { return (UInt32)kvtophys((vm_offset_t)va); }
+static void ios7s5_wake_cpu1(void)
+{
+    /* run 131: CPU1 boots into s5_helper.c's trampoline (MMU on with the kernel's tables) and runs the panel mirror */
+    UInt32 entry = s5_helper_prepare(s5_v2p);
+    UInt32 dummy = 0, ret;
+    IOMemoryDescriptor *d1 = IOMemoryDescriptor::withPhysicalAddress(0xF9098000U, 0x1000, kIODirectionInOut);
+    IOMemoryDescriptor *d2 = IOMemoryDescriptor::withPhysicalAddress(0xF9012000U, 0x1000, kIODirectionInOut);
+    IOMemoryDescriptor *d3 = IOMemoryDescriptor::withPhysicalAddress(0xF9000000U, 0x1000, kIODirectionInOut);
+    IOMemoryMap *m1 = d1 ? d1->map(kIOMapInhibitCache) : 0;
+    IOMemoryMap *m2 = d2 ? d2->map(kIOMapInhibitCache) : 0;
+    IOMemoryMap *m3 = d3 ? d3->map(kIOMapInhibitCache) : 0;
+    volatile UInt32 *acc = m1 ? (volatile UInt32 *)m1->getAddress() : 0;
+    volatile UInt32 *l2saw = m2 ? (volatile UInt32 *)m2->getAddress() : 0;
+    volatile UInt32 *gicd = m3 ? (volatile UInt32 *)m3->getAddress() : 0;
+    s5_smp_state = -1;
+    if (!acc || !l2saw || !gicd || !entry || (entry & 3U)) {
+        IOLog("S5SMP: setup failed acc %p saw %p gicd %p entry %08x\n", acc, l2saw, gicd, (unsigned)entry);
+        return;
+    }
+    IOLog("S5SMP: entry pa %08x, ACC1 pwr %08x gate %08x, mailbox %08x %08x\n", (unsigned)entry, (unsigned)acc[1],
+          (unsigned)acc[5], (unsigned)s5_mailbox_read(0), (unsigned)s5_mailbox_read(1));
+    {
+        register UInt32 r0 __asm__("r0") = 0x401222U;
+        register UInt32 r1 __asm__("r1") = (UInt32)(uintptr_t)&dummy;
+        register UInt32 r2 __asm__("r2") = 0x01U; /* cold boot, CPU1 */
+        register UInt32 r3 __asm__("r3") = entry;
+        register UInt32 r4 __asm__("r4") = 0;
+        register UInt32 r5 __asm__("r5") = 0;
+        register UInt32 r6 __asm__("r6") = 0;
+        __asm__ volatile(".arch_extension sec\n smc #0" : "+r"(r0), "+r"(r1), "+r"(r2), "+r"(r3), "+r"(r4), "+r"(r5), "+r"(r6)
+                         :: "r12", "lr", "memory");
+        ret = r0;
+    }
+    IOLog("S5SMP: SCM set_boot_addr ret %d\n", (int)ret);
+    if (ret != 0)
+        return;
+    acc[5] = 0x403f0001U; __asm__ volatile("dsb" ::: "memory"); spinUs(1);
+    acc[5] = 0x403f007fU; __asm__ volatile("dsb" ::: "memory"); spinUs(1);
+    acc[5] = 0x403f3f7fU;
+    l2saw[7] = 0x10003U; __asm__ volatile("dsb" ::: "memory"); spinUs(50);
+    acc[1] = 0x21U; __asm__ volatile("dsb" ::: "memory"); spinUs(2);
+    acc[1] = 0x20U; __asm__ volatile("dsb" ::: "memory"); spinUs(2);
+    acc[1] = 0x00U; __asm__ volatile("dsb" ::: "memory");
+    acc[1] = 0x80U; __asm__ volatile("dsb" ::: "memory");
+    gicd[0xF00 / 4] = (1U << 17) | 1U; /* SGI 1 to CPU1 (target list bit 1) */
+    __asm__ volatile("dsb" ::: "memory");
+    s5_smp_state = 1;
+    for (int i = 0; i < 1000 && s5_helper_word(3) != 2U && s5_helper_word(3) != 9U; i++)
+        spinUs(100);
+    IOLog("S5SMP: released: helper state %u mpidr %08x fault %x lr %08x far %08x fsr %08x, enable %d\n",
+          (unsigned)s5_helper_word(3), (unsigned)s5_helper_word(2), (unsigned)s5_helper_word(12),
+          (unsigned)s5_helper_word(13), (unsigned)s5_helper_word(14), (unsigned)s5_helper_word(15), s5_helper_enable());
+}
+#ifndef J1_S5_SMP
+#define J1_S5_SMP 1 /* J1_KFLAGS=-DJ1_S5_SMP=0 builds without the CPU1 wake */
+#endif
+
+/* Bitmask of pressed keys (bit 0 Home, 1 volume down, 2 volume up), or -1 when SPMI is not usable. */
+extern "C" int ios7s5_keys_poll(void)
+{
+    static int &state = s5k_state;
+    static const UInt16 pin_base[3] = {0xc200, 0xc100, 0xc400}; /* GPIO 3 (Home), 2 (vol down), 5 (vol up) */
+    int mask = 0;
+    if (state == 0) {
+        IOMemoryDescriptor *d = IOMemoryDescriptor::withPhysicalAddress(SPMI_CORE_PA, 0x1000, kIODirectionInOut);
+        IOMemoryMap *m = d ? d->map(kIOMapInhibitCache) : 0;
+        s5k_spmi = (m && m->getAddress()) ? (volatile UInt32 *)m->getAddress() : 0;
+        state = s5k_spmi ? 1 : -1;
+        for (int k = 0; k < 3 && state == 1; k++) {
+            UInt8 st1 = 0, mode = 0, pull = 0, en = 0;
+            int r = spmi_read(0, pin_base[k] + 0x08, &st1, 1);
+            spmi_read(0, pin_base[k] + 0x40, &mode, 1);
+            spmi_read(0, pin_base[k] + 0x42, &pull, 1);
+            spmi_read(0, pin_base[k] + 0x46, &en, 1);
+            IOLog("S5KEY: pin %04x read=%d status1=%02x mode=%02x pull=%02x en=%02x\n", pin_base[k], r, st1, mode, pull, en);
+            if (r)
+                state = -1;
+            /* Run 101: Home (c200) came up with pull 4 (10 uA pull-down) instead of the stock DT's 0 (30 uA pull-up),
+             * read "pressed" for the whole run. Restore the stock pull-up, as Linux's qpnp-pin driver does at boot. */
+            if (r == 0 && k == 0 && pull != 0) {
+                int w = spmi_write(0, pin_base[k] + 0x42, 0);
+                spinUs(100);
+                spmi_read(0, pin_base[k] + 0x42, &pull, 1);
+                spmi_read(0, pin_base[k] + 0x08, &st1, 1);
+                IOLog("S5KEY: pin %04x pull-up write=%d pull=%02x status1=%02x\n", pin_base[k], w, pull, st1);
+            }
+        }
+    }
+    ios7s5_cpu_clock(); /* once */
+    if (J1_S5_SMP && !s5_smp_state)
+        ios7s5_wake_cpu1();
+    else if (s5_smp_state == 1) {
+        static unsigned polls, logs;
+        if ((++polls % 300 == 0 || polls == 20) && logs < 12) { /* keys poll is every 100 ms: 2 s, then every 30 s */
+            logs++;
+            IOLog("S5SMP: CPU1 state %u idle-loops %u jobs %u (posted %u) rows %u busy %u ms fault %x lr %08x far %08x\n",
+                  (unsigned)s5_helper_word(3), (unsigned)s5_helper_word(1), (unsigned)s5_helper_word(20),
+                  (unsigned)s5_helper_word(16), (unsigned)s5_helper_word(21), (unsigned)(s5_helper_word(23) / 19200U),
+                  (unsigned)s5_helper_word(12), (unsigned)s5_helper_word(13), (unsigned)s5_helper_word(14));
+        }
+    }
+    if (state != 1)
+        return -1;
+    for (int k = 0; k < 3; k++) {
+        UInt8 st1 = 1;
+        if (spmi_read(0, pin_base[k] + 0x08, &st1, 1) == 0 && !(st1 & 1))
+            mask |= 1 << k;
+    }
+    return mask;
+}
+
+/* 1 = report filled (x, y in GUI pixels 0..479 / 0..799, down 0/1), 0 = nothing (not ready), <0 = read error.
+ * The GUI is mirrored at 9/4 scale to panel rows 60..1859 (pe_exynos3475_j1.c): GUI = (x * 4/9, (y - 60) * 4/9).
+ * Only the first finger object (F12 data 1: type, x lo/hi, y lo/hi, z, wx, wy) is used. */
+extern "C" int ios7s5_touch_poll(uint16_t *x, uint16_t *y, uint8_t *down)
+{
+    UInt8 st[2], f[8];
+    UInt32 px, py;
+    if (s5t_state == 0)
+        s5t_state = s5_touch_bringup() ? 1 : -1;
+    if (s5t_state != 1)
+        return 0;
+    {
+        /* Skip the ~1.5 ms bit-banged read while the interrupt line says nothing changed and no finger is down;
+         * read anyway every 10th poll (200 ms) in case the line misbehaves. Without SPMI: read every poll. */
+        static unsigned polls, irq_logs;
+        static int last_irq = -2;
+        int irq = s5_touch_irq();
+        polls++;
+        if (irq != last_irq && irq_logs < 20) {
+            irq_logs++;
+            IOLog("S5TOUCH: irq line %d -> %d (poll %u)\n", last_irq, irq, polls);
+        }
+        last_irq = irq;
+        if (irq == 0 && !s5t_last_down && polls % 10U != 0)
+            return 0;
+    }
+    if (!i2c_read(TS_ADDR, s5t_f01_data, st, 2) || !i2c_read(TS_ADDR, s5t_f12_data, f, 8))
+        return -1;
+    *down = f[0] == 1 ? 1 : 0;
+    s5t_last_down = *down;
+    {
+        /* A lifted finger's object is cleared to zeros: report the release where the finger last was, not at (0,0)
+         * (run 83: every up jumped to the top-left corner, cancelling slides; the jump's huge velocity also drove
+         * CoreAnimation to infinite coordinates and crashed backboardd in CGPathMoveToPoint). */
+        static uint16_t last_x, last_y;
+        if (*down) {
+            px = (UInt32)f[1] | (UInt32)f[2] << 8;
+            py = (UInt32)f[3] | (UInt32)f[4] << 8;
+            px = px * 4U / 9U;
+            py = py < 60U ? 0U : (py - 60U) * 4U / 9U;
+            last_x = (uint16_t)(px > 479U ? 479U : px);
+            last_y = (uint16_t)(py > 799U ? 799U : py);
+        }
+        *x = last_x;
+        *y = last_y;
+    }
+    {
+        static unsigned logs;
+        if (*down && logs < 24) {
+            logs++;
+            IOLog("S5TOUCH: finger panel %u,%u -> gui %u,%u (status %02x int %02x)\n", (unsigned)(f[1] | f[2] << 8),
+                  (unsigned)(f[3] | f[4] << 8), (unsigned)*x, (unsigned)*y, st[0], st[1]);
+        }
+    }
+    return 1;
+}
+#endif
diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Tab2HSMMC.cpp b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Tab2HSMMC.cpp
new file mode 100644
index 0000000..f06f683
--- /dev/null
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Tab2HSMMC.cpp
@@ -0,0 +1,494 @@
+#if defined(J1_TAB2)
+/*
+ * Galaxy Tab 2 10.1 (GT-P5110, OMAP4430): the internal eMMC (Samsung MAG2GA, 16 GB) on MMCHS2, polled PIO, read/write.
+ *
+ * The disk iOS sees is ONE partition of the eMMC, never the whole device: Android's DATAFS (GPT entry 10, sectors
+ * 4448256 + 25280478, read from TWRP's /sys/block/mmcblk0/mmcblk0p10). Block 0 of this disk is eMMC sector 4448256 and
+ * every request outside the window is refused, so the bootloaders, EFS, the Android system and TWRP cannot be touched.
+ * DATAFS carries the same MBR + 0xAF (HFS) layout as the S4 Mini's card, so the FDisk scheme personalities publish
+ * disk0s1 (root) and disk0s2 (var) as on that phone.
+ *
+ * The bootloader reads the kernel from this eMMC, so the controller, its clock and the card are left set up: the
+ * driver first asks the card for its status (CMD13) at RCA 1 (what Linux used: mmc0:0001) and only does a full eMMC
+ * identification, at 400 kHz, when that fails. No DMA, no interrupts.
+ */
+#include <IOKit/storage/IOBlockStorageDevice.h>
+#include <IOKit/storage/IOBlockStorageDriver.h>
+#include <IOKit/storage/IOMedia.h>
+#include <IOKit/IOCatalogue.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <pexpert/pexpert.h>
+#include "IOS7LabStoragePersonalities.h"
+
+#define MMC2_PA 0x480b4000U         /* MMCHS2: OMAP4 TRM register offsets are from this base (the HL_ block at +0x100) */
+#define DISK_FIRST 4448256ULL       /* DATAFS, in eMMC sectors */
+#define DISK_SECTORS 25280478ULL
+
+/* MMCHS registers */
+#define SYSCONFIG 0x110
+#define SYSSTATUS 0x114
+#define CON 0x12c
+#define BLK 0x204
+#define ARG 0x208
+#define CMD 0x20c
+#define RSP10 0x210
+#define RSP32 0x214
+#define RSP54 0x218
+#define RSP76 0x21c
+#define DATA 0x220
+#define PSTATE 0x224
+#define HCTL 0x228
+#define SYSCTL 0x22c
+#define STAT 0x230
+#define IE 0x234
+#define ISE 0x238
+#define CAPA 0x240
+#define REV 0x2fc
+
+/* CMD register fields */
+#define C_DE (1U << 0)              /* DMA enable */
+#define C_BCE (1U << 1)             /* block count enable */
+#define C_ACEN (1U << 2)            /* auto CMD12 */
+#define C_DDIR_READ (1U << 4)
+#define C_MSBS (1U << 5)            /* multi-block */
+#define C_RSP_NONE (0U << 16)
+#define C_RSP_136 (1U << 16)
+#define C_RSP_48 (2U << 16)
+#define C_RSP_48B (3U << 16)
+#define C_CCCE (1U << 19)           /* CRC check */
+#define C_CICE (1U << 20)           /* index check */
+#define C_DP (1U << 21)             /* data present */
+
+/* STAT bits */
+#define S_CC (1U << 0)
+#define S_TC (1U << 1)
+#define S_BWR (1U << 4)
+#define S_BRR (1U << 5)
+#define S_ERRI (1U << 15)
+#define S_ERRMASK 0xffff8000U
+
+enum { R_NONE, R_48, R_48B, R_136 };
+
+class IOS7Tab2HSMMC : public IOBlockStorageDevice {
+    OSDeclareDefaultStructors(IOS7Tab2HSMMC)
+    IOMemoryDescriptor *mmio;
+    IOMemoryMap *map;
+    volatile UInt8 *regs;
+    IOLock *mutex;
+    UInt32 rca;
+    bool initialized, faulted;
+    UInt32 rd(unsigned off) { __asm__ __volatile__("dsb sy" ::: "memory"); return *(volatile UInt32 *)(regs + off); }
+    void wr(unsigned off, UInt32 v) { *(volatile UInt32 *)(regs + off) = v; __asm__ __volatile__("dsb sy" ::: "memory"); }
+    void resetLines(UInt32 which);
+    IOReturn command(UInt32 index, UInt32 arg, int resp, UInt32 flags, UInt32 out[4]);
+    IOReturn waitTran();
+    IOReturn identify();
+    void setClock(UInt32 clkd);
+    IOReturn widen();
+    IOReturn transfer(UInt64 sector, UInt32 count, UInt8 *bytes, bool writing);
+public:
+    virtual bool init(OSDictionary *properties = 0);
+    virtual bool start(IOService *provider);
+    virtual void free();
+    virtual IOReturn doAsyncReadWrite(IOMemoryDescriptor *, UInt64, UInt64, IOStorageAttributes *, IOStorageCompletion *);
+    virtual IOReturn doEjectMedia() { return kIOReturnUnsupported; }
+    virtual IOReturn doFormatMedia(UInt64) { return kIOReturnUnsupported; }
+    virtual UInt32 doGetFormatCapacities(UInt64 *, UInt32) const { return 0; }
+    virtual IOReturn doLockUnlockMedia(bool) { return kIOReturnUnsupported; }
+    virtual IOReturn doSynchronizeCache() { return kIOReturnSuccess; }
+    virtual char *getVendorString();
+    virtual char *getProductString();
+    virtual char *getRevisionString();
+    virtual char *getAdditionalDeviceInfoString();
+    virtual IOReturn reportBlockSize(UInt64 *);
+    virtual IOReturn reportMaxValidBlock(UInt64 *);
+    virtual IOReturn reportEjectability(bool *);
+    virtual IOReturn reportLockability(bool *);
+    virtual IOReturn reportRemovability(bool *);
+    virtual IOReturn reportMediaState(bool *, bool *);
+    virtual IOReturn reportPollRequirements(bool *, bool *);
+    virtual IOReturn reportWriteProtection(bool *);
+};
+OSDefineMetaClassAndStructors(IOS7Tab2HSMMC, IOBlockStorageDevice)
+
+static const unsigned pollLimit = 4000000;
+
+bool IOS7Tab2HSMMC::init(OSDictionary *p)
+{
+    mmio = 0; map = 0; regs = 0; mutex = 0; rca = 1 << 16; initialized = faulted = false;
+    return IOBlockStorageDevice::init(p);
+}
+
+/* SYSCTL SRC (bit 25, command line) / SRD (bit 26, data line) soft resets after an error */
+void IOS7Tab2HSMMC::resetLines(UInt32 which)
+{
+    wr(SYSCTL, rd(SYSCTL) | which);
+    for (unsigned i = 0; i < pollLimit && (rd(SYSCTL) & which); i++)
+        ;
+}
+
+IOReturn IOS7Tab2HSMMC::command(UInt32 index, UInt32 arg, int resp, UInt32 flags, UInt32 out[4])
+{
+    unsigned i;
+    for (i = 0; i < pollLimit && (rd(PSTATE) & 1U); i++) /* CMDI: command line busy */
+        ;
+    if (i == pollLimit)
+        return kIOReturnBusy;
+    wr(STAT, 0xffffffffU);
+    UInt32 c = (index << 24) | flags;
+    if (resp == R_48)
+        c |= C_RSP_48 | C_CCCE | C_CICE;
+    else if (resp == R_48B)
+        c |= C_RSP_48B | C_CCCE | C_CICE;
+    else if (resp == R_136)
+        c |= C_RSP_136 | C_CCCE;
+    wr(ARG, arg);
+    wr(CMD, c);
+    UInt32 s = 0;
+    for (i = 0; i < pollLimit; i++) {
+        s = rd(STAT);
+        if (s & (S_CC | S_ERRI))
+            break;
+    }
+    if (i == pollLimit || (s & S_ERRI)) {
+        wr(STAT, 0xffffffffU);
+        resetLines(1U << 25);
+        if (flags & C_DP)
+            resetLines(1U << 26);
+        return i == pollLimit ? kIOReturnTimeout : (kIOReturnIOError | (s >> 16));
+    }
+    wr(STAT, S_CC);
+    if (out) {
+        out[0] = rd(RSP10); out[1] = rd(RSP32); out[2] = rd(RSP54); out[3] = rd(RSP76);
+    }
+    return kIOReturnSuccess;
+}
+
+/* CMD13 until the card is in the transfer state (current state, bits 12:9, = 4) */
+IOReturn IOS7Tab2HSMMC::waitTran()
+{
+    UInt32 r[4];
+    for (unsigned i = 0; i < 100000; i++) {
+        IOReturn rc = command(13, rca, R_48, 0, r);
+        if (rc != kIOReturnSuccess)
+            return rc;
+        if (((r[0] >> 9) & 15) == 4 && (r[0] & (1U << 8)))      /* tran, READY_FOR_DATA */
+            return kIOReturnSuccess;
+    }
+    return kIOReturnTimeout;
+}
+
+/*
+ * Full controller + eMMC bring-up, as U-Boot's omap_hsmmc does it (the first boot found the card silent: CMD13 timed
+ * out and CMD1 returned no OCR, so the bootloader leaves the module or the card clock off). Module clock on
+ * (CM_L3INIT_MMC2_CLKCTRL MODULEMODE = 2), controller soft reset, 1.8 V + 3.0 V capabilities, bus power at 1.8 V (eMMC),
+ * 400 kHz, the 80-clock init stream, then CMD0/CMD1/CMD2/CMD3/CMD7 with RCA 1, 1-bit.
+ */
+IOReturn IOS7Tab2HSMMC::identify()
+{
+    UInt32 r[4];
+    {
+        IOMemoryDescriptor *cd = IOMemoryDescriptor::withPhysicalAddress(0x4a009000U, 4096, kIODirectionInOut);
+        IOMemoryMap *cm = cd ? cd->map(kIOMapInhibitCache) : 0;
+        if (cm && cm->getAddress()) {
+            volatile UInt32 *clk = (volatile UInt32 *)(cm->getAddress() + 0x330);
+            IOLog("T2MMC: CM_L3INIT_MMC2_CLKCTRL %08x\n", (unsigned)*clk);
+            *clk = (*clk & ~3U) | 2U;
+            __asm__ __volatile__("dsb sy" ::: "memory");
+            for (unsigned i = 0; i < pollLimit && (*clk & (3U << 16)); i++)
+                ;
+            IOLog("T2MMC: CM_L3INIT_MMC2_CLKCTRL now %08x\n", (unsigned)*clk);
+        }
+    }
+    wr(SYSCONFIG, rd(SYSCONFIG) | 2U);                          /* SOFTRESET */
+    for (unsigned i = 0; i < pollLimit && !(rd(SYSSTATUS) & 1U); i++)
+        ;
+    wr(SYSCTL, rd(SYSCTL) | (1U << 24));                        /* SRA */
+    for (unsigned i = 0; i < pollLimit && (rd(SYSCTL) & (1U << 24)); i++)
+        ;
+    wr(CAPA, rd(CAPA) | (1U << 25) | (1U << 26));               /* VS30, VS18 */
+    wr(CON, 0);                                                 /* 1-bit, open drain off, no init stream yet */
+    wr(SYSCTL, (240U << 6) | (14U << 16) | 1U);                 /* CLKD 240 -> 400 kHz from 96 MHz, DTO, ICE */
+    for (unsigned i = 0; i < pollLimit && !(rd(SYSCTL) & 2U); i++)
+        ;
+    wr(SYSCTL, rd(SYSCTL) | (1U << 2));                         /* CEN */
+    wr(HCTL, (5U << 9));                                        /* SDVS 1.8 V, 1-bit */
+    wr(HCTL, rd(HCTL) | (1U << 8));                             /* SDBP bus power on */
+    for (unsigned i = 0; i < pollLimit && !(rd(HCTL) & (1U << 8)); i++)
+        ;
+    wr(IE, 0xffffffffU);
+    wr(ISE, 0);
+    /* init stream: CON.INIT and a dummy command, 80 clocks */
+    wr(CON, rd(CON) | (1U << 1));
+    wr(CMD, 0);
+    for (unsigned i = 0; i < pollLimit && !(rd(STAT) & S_CC); i++)
+        ;
+    wr(STAT, 0xffffffffU);
+    wr(CON, rd(CON) & ~(1U << 1));
+    IOLog("T2MMC: after reset con %08x hctl %08x sysctl %08x pstate %08x capa %08x\n", (unsigned)rd(CON), (unsigned)rd(HCTL),
+        (unsigned)rd(SYSCTL), (unsigned)rd(PSTATE), (unsigned)rd(CAPA));
+    command(0, 0, R_NONE, 0, 0);
+    IOSleep(2);
+    UInt32 ocr = 0;
+    for (unsigned n = 0; n < 1000; n++) {
+        command(1, 0x40ff8080U, R_NONE, C_RSP_48, r);          /* R3: no CRC or index to check */
+        ocr = rd(RSP10);
+        if (ocr & 0x80000000U)
+            break;
+        IOSleep(1);
+    }
+    IOLog("T2MMC: identify: OCR %08x\n", (unsigned)ocr);
+    if (!(ocr & 0x80000000U))
+        return kIOReturnNotReady;
+    if (command(2, 0, R_136, 0, r) != kIOReturnSuccess)
+        return kIOReturnNotReady;
+    rca = 1U << 16;
+    if (command(3, rca, R_48, 0, r) != kIOReturnSuccess)
+        return kIOReturnNotReady;
+    if (command(7, rca, R_48B, 0, r) != kIOReturnSuccess)
+        return kIOReturnNotReady;
+    command(16, 512, R_48, 0, r);
+    /* back to the transfer clock: CLKD 8 (12-16 MHz), safe in 1-bit mode */
+    wr(SYSCTL, rd(SYSCTL) & ~(1U << 2));
+    wr(SYSCTL, (rd(SYSCTL) & ~(0x3ffU << 6)) | (8U << 6));
+    for (unsigned i = 0; i < pollLimit && !(rd(SYSCTL) & 2U); i++)
+        ;
+    wr(SYSCTL, rd(SYSCTL) | (1U << 2));
+    IOReturn rc = waitTran();
+    if (rc != kIOReturnSuccess)
+        return rc;
+    return widen();
+}
+
+void IOS7Tab2HSMMC::setClock(UInt32 clkd)
+{
+    wr(SYSCTL, rd(SYSCTL) & ~(1U << 2));
+    wr(SYSCTL, (rd(SYSCTL) & ~(0x3ffU << 6)) | (clkd << 6));
+    for (unsigned i = 0; i < pollLimit && !(rd(SYSCTL) & 2U); i++)
+        ;
+    wr(SYSCTL, rd(SYSCTL) | (1U << 2));
+}
+
+/*
+ * 8-bit bus (EXT_CSD BUS_WIDTH, byte 183 = 2) and 24 MHz (CLKD 4 from 96 MHz: below the 26 MHz legacy limit, so no
+ * HS_TIMING). A sector read before and after must match; if not, back to 1-bit at the identification-time rate.
+ */
+IOReturn IOS7Tab2HSMMC::widen()
+{
+    static UInt8 before[512] __attribute__((aligned(4))), after[512] __attribute__((aligned(4)));
+    UInt32 r[4];
+    /* inside DATAFS, in the middle of the root volume's first blocks: not all zeros */
+    const UInt64 probe = DISK_FIRST + 2048 + 2;
+    IOReturn rc = transfer(probe, 1, before, false);
+    if (rc != kIOReturnSuccess)
+        return rc;
+    rc = command(6, (3U << 24) | (183U << 16) | (2U << 8), R_48B, 0, r);
+    if (rc == kIOReturnSuccess)
+        rc = waitTran();
+    if (rc != kIOReturnSuccess) {
+        IOLog("T2MMC: CMD6 8-bit failed %08x, staying 1-bit\n", (unsigned)rc);
+        return waitTran();
+    }
+    wr(CON, rd(CON) | (1U << 5));                               /* DW8 */
+    setClock(4);
+    rc = transfer(probe, 1, after, false);
+    if (rc == kIOReturnSuccess && memcmp(before, after, 512) == 0) {
+        IOLog("T2MMC: 8-bit bus, 24 MHz\n");
+        return kIOReturnSuccess;
+    }
+    IOLog("T2MMC: 8-bit read check failed (%08x), back to 1-bit\n", (unsigned)rc);
+    setClock(8);
+    wr(CON, rd(CON) & ~(1U << 5));
+    command(6, (3U << 24) | (183U << 16) | (0U << 8), R_48B, 0, r);
+    return waitTran();
+}
+
+/* count sectors at eMMC sector `sector` (absolute), CMD17/18 or CMD24/25 with auto CMD12, PIO through DATA */
+IOReturn IOS7Tab2HSMMC::transfer(UInt64 sector, UInt32 count, UInt8 *bytes, bool writing)
+{
+    IOReturn rc = waitTran();
+    if (rc != kIOReturnSuccess)
+        return rc;
+    wr(BLK, (count << 16) | 512U);
+    UInt32 flags = C_DP | (writing ? 0 : C_DDIR_READ) | (count > 1 ? (C_MSBS | C_BCE | C_ACEN) : 0);
+    UInt32 index = writing ? (count > 1 ? 25 : 24) : (count > 1 ? 18 : 17);
+    rc = command(index, (UInt32)sector, R_48, flags, 0);
+    if (rc != kIOReturnSuccess)
+        return rc;
+    UInt32 want = writing ? S_BWR : S_BRR;
+    for (UInt32 b = 0; b < count; b++) {
+        UInt32 s = 0;
+        unsigned i;
+        for (i = 0; i < pollLimit; i++) {
+            s = rd(STAT);
+            if (s & (want | S_ERRI))
+                break;
+        }
+        if (i == pollLimit || (s & S_ERRI)) {
+            wr(STAT, 0xffffffffU);
+            resetLines((1U << 25) | (1U << 26));
+            return i == pollLimit ? kIOReturnTimeout : (kIOReturnIOError | (s >> 16));
+        }
+        wr(STAT, want);
+        UInt32 *w = (UInt32 *)(bytes + b * 512U);
+        if (writing)
+            for (unsigned k = 0; k < 128; k++)
+                wr(DATA, w[k]);
+        else
+            for (unsigned k = 0; k < 128; k++)
+                w[k] = rd(DATA);
+    }
+    UInt32 s = 0;
+    unsigned i;
+    for (i = 0; i < pollLimit; i++) {
+        s = rd(STAT);
+        if (s & (S_TC | S_ERRI))
+            break;
+    }
+    wr(STAT, 0xffffffffU);
+    if (i == pollLimit || (s & S_ERRI)) {
+        resetLines((1U << 25) | (1U << 26));
+        return i == pollLimit ? kIOReturnTimeout : (kIOReturnIOError | (s >> 16));
+    }
+    return kIOReturnSuccess;
+}
+
+bool IOS7Tab2HSMMC::start(IOService *provider)
+{
+    if (!IOBlockStorageDevice::start(provider))
+        return false;
+    mutex = IOLockAlloc();
+    mmio = IOMemoryDescriptor::withPhysicalAddress(MMC2_PA, 4096, kIODirectionInOut);
+    map = mmio ? mmio->map(kIOMapInhibitCache) : 0;
+    if (!mutex || !map || !map->getAddress()) {
+        IOLog("T2MMC: map failed\n");
+        return false;
+    }
+    regs = (volatile UInt8 *)map->getAddress();
+    IOLog("T2MMC: rev %08x sysconfig %08x sysstatus %08x con %08x hctl %08x sysctl %08x pstate %08x capa %08x\n",
+        (unsigned)rd(REV), (unsigned)rd(SYSCONFIG), (unsigned)rd(SYSSTATUS), (unsigned)rd(CON), (unsigned)rd(HCTL),
+        (unsigned)rd(SYSCTL), (unsigned)rd(PSTATE), (unsigned)rd(CAPA));
+    wr(IE, 0xffffffffU);                    /* status bits latch in STAT; no interrupt line is enabled (ISE stays 0) */
+    wr(ISE, 0);
+    UInt32 r[4];
+    IOReturn rc = command(13, rca, R_48, 0, r);
+    IOLog("T2MMC: CMD13 rca 1 -> %08x status %08x\n", (unsigned)rc, (unsigned)r[0]);
+    if (rc != kIOReturnSuccess || waitTran() != kIOReturnSuccess) {
+        rc = identify();
+        IOLog("T2MMC: identify -> %08x\n", (unsigned)rc);
+        if (rc != kIOReturnSuccess)
+            return false;
+    }
+    /* check the window: the first sector of DATAFS */
+    static UInt8 first[512] __attribute__((aligned(4)));
+    rc = transfer(DISK_FIRST, 1, first, false);
+    IOLog("T2MMC: read DATAFS sector 0 -> %08x, signature %02x%02x, first words %02x%02x%02x%02x\n", (unsigned)rc,
+        first[510], first[511], first[0], first[1], first[2], first[3]);
+    if (rc != kIOReturnSuccess)
+        return false;
+    initialized = true;
+    OSObject *dec = OSUnserializeXML(ios7labStoragePersonalities);
+    OSArray *drv = OSDynamicCast(OSArray, dec);
+    if (!drv || !gIOCatalogue->addDrivers(drv, false)) {
+        if (dec)
+            dec->release();
+        return false;
+    }
+    dec->release();
+    return true;
+}
+
+void IOS7Tab2HSMMC::free()
+{
+    if (mutex)
+        IOLockFree(mutex);
+    if (map)
+        map->release();
+    if (mmio)
+        mmio->release();
+    IOBlockStorageDevice::free();
+}
