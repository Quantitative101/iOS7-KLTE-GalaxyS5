+IOReturn IOS7Tab2HSMMC::doAsyncReadWrite(IOMemoryDescriptor *buffer, UInt64 block, UInt64 count,
+    IOStorageAttributes *, IOStorageCompletion *completion)
+{
+    /* the window: nothing outside DATAFS, ever */
+    if (!buffer || !completion || !completion->action || !initialized || count == 0 || block >= DISK_SECTORS ||
+        count > DISK_SECTORS - block || count * 512U != buffer->getLength())
+        return kIOReturnBadArgument;
+    bool writing = (buffer->getDirection() == kIODirectionOut);
+    IOStorageCompletion saved = *completion;
+    unsigned bytes = (unsigned)(count * 512U);
+    UInt8 *tmp = (UInt8 *)IOMalloc(bytes);
+    if (!tmp)
+        return kIOReturnNoMemory;
+    IOReturn result = kIOReturnSuccess;
+    UInt64 done = 0;
+    if (writing && buffer->readBytes(0, tmp, bytes) != bytes)
+        result = kIOReturnUnderrun;
+    IOLockLock(mutex);
+    if (faulted)
+        result = kIOReturnNotReady;
+    for (UInt64 i = 0; i < count && result == kIOReturnSuccess;) {
+        UInt32 n = (UInt32)((count - i) > 128 ? 128 : (count - i));
+        result = transfer(DISK_FIRST + block + i, n, tmp + i * 512U, writing);
+        if (result == kIOReturnSuccess) {
+            i += n;
+            done += n * 512ULL;
+        } else {
+            IOLog("T2MMC: %s blk=%llu n=%u failed %08x\n", writing ? "write" : "read", (unsigned long long)(block + i),
+                (unsigned)n, (unsigned)result);
+            faulted = true;
+        }
+    }
+    IOLockUnlock(mutex);
+    {
+        static unsigned nrw;
+        if (nrw < 4 || (nrw & 0x3ff) == 0)
+            IOLog("T2MMC: io#%u %s blk=%llu n=%llu rc=%08x\n", nrw, writing ? "wr" : "rd", (unsigned long long)block,
+                (unsigned long long)count, (unsigned)result);
+        nrw++;
+    }
+    if (!writing && result == kIOReturnSuccess && buffer->writeBytes(0, tmp, bytes) != bytes)
+        result = kIOReturnUnderrun;
+    IOFree(tmp, bytes);
+    IOStorage::complete(&saved, result, result == kIOReturnSuccess ? done : 0);
+    return kIOReturnSuccess;
+}
+
+void ios7tab2_register_mmc(IOService *platform)
+{
+    IOS7Tab2HSMMC *dev = new IOS7Tab2HSMMC;
+    if (!dev) {
+        IOLog("T2MMC: allocation failed\n");
+        return;
+    }
+    bool attached = false, ok = false;
+    if (dev->init())
+        attached = dev->attach(platform);
+    if (attached && dev->start(platform)) {
+        dev->registerService();
+        ok = true;
+    }
+    if (!ok)
+        IOLog("T2MMC: init/attach/start failed\n");
+    if (attached && !ok)
+        dev->detach(platform);
+    dev->release();
+}
+#endif
