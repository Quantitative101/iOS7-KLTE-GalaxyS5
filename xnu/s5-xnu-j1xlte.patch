+                  unsigned int rows, unsigned int rowbytes)
+{
+	unsigned int y;
+	for (y = 0; y < rows; y++)
+		s5_copy_words((volatile uint32_t *)((volatile uint8_t *)dst + y * dpitch),
+		              (const uint32_t *)(src + y * spitch), rowbytes / 4U);
+}
diff --git a/xnu/pexpert/arm/s5_helper.c b/xnu/pexpert/arm/s5_helper.c
new file mode 100644
index 0000000..46757f1
--- /dev/null
+++ b/xnu/pexpert/arm/s5_helper.c
@@ -0,0 +1,331 @@
+/*
+ * Galaxy S5: helper core (stage 2, run 131). XNU stays single-core on CPU0; CPU1 runs this file's loop outside the
+ * scheduler and takes over the per-frame panel mirror (GUI frame -> 1080x1920 packed-24-bit panel buffer + MDP kick).
+ *
+ * Boot: IOS7S5Touch.cpp sets CPU1's cold-boot address (SCM) to s5_tramp (its physical address) and powers the core up.
+ * s5_tramp runs with the MMU and caches off: it invalidates its own L1 data cache and TLB, loads the translation
+ * registers CPU0 left in the parameter block (TTBR1 = the kernel's live table, TTBCR N=2 so every kernel address goes
+ * through it; TTBR0 = a private one-page table holding a single identity section for the trampoline itself), sets
+ * VBAR to s5_vectors (a fault recorder), turns the MMU and caches on with CPU0's SCTLR, and jumps to s5_helper_main
+ * on its own stack.
+ *
+ * Coherency without shareable attributes: all RAM on this port is mapped write-through, so every store reaches memory;
+ * a reader drops its possibly stale lines (DCIMVAC) before reading data the other core wrote. CPU1 also flushes its
+ * TLB before each job (CPU0's TLB maintenance is not broadcast).
+ *
+ * Built -O2 (pexpert/conf/Makefile.template).
+ */
+#include <stdint.h>
+
+#if defined(J1_S5) /* files.arm builds this for every board; the S4 Mini / Tab 2 kernels have no s4_early_mdp (2026-11-08) */
+#define FB_ROW 3240U /* J1B_FB_ROW: 1080 * 3 */
+#define FB_H 1920U
+
+extern uint32_t s4_early_fb, s4_early_mdp; /* vm_offset_t in pe_exynos3475_j1.c */
+uint32_t s5_row_hash(const uint32_t *w, unsigned int n);
+void s5_expand_bgr(uint8_t *line, const uint8_t *src, const unsigned short *xmap, unsigned int n);
+void s5_copy_words(volatile uint32_t *d, const uint32_t *s, unsigned int n);
+
+/* parameter block / mailbox, word offsets */
+enum {
+    B_MAGIC = 0, B_HEART = 1, B_MPIDR = 2, B_STATE = 3,
+    B_TTBR0 = 4, B_TTBR1 = 5, B_TTBCR = 6, B_DACR = 7, B_SCTLR = 8, B_VBAR = 9, B_SP = 10, B_ENTRY = 11,
+    B_FTYPE = 12, B_FLR = 13, B_FFAR = 14, B_FFSR = 15,
+    B_JSEQ = 16, B_JPX = 17, B_JROW = 18, B_DONE = 19, B_JOBS = 20, B_ROWS = 21, B_WAIT = 22, B_BUSY = 23,
+    B_WORDS = 32
+};
+
+extern uint32_t s5_tramp_box[B_WORDS];
+extern void s5_tramp(void);
+
+
+/* Trampoline and its parameter block live in __DATA: CPU0 fills the block through its normal mapping, CPU1 reads it
+ * PC-relative with the MMU off. */
+__asm__(
+    ".section __DATA,__s5tramp\n"
+    ".align 6\n"
+    ".arm\n"
+    ".globl _s5_tramp\n"
+    "_s5_tramp:\n"
+    "    cpsid aif\n"
+    "    adr r0, 9f\n"
+    "    mov r1, #0\n"
+    "    mcr p15, 0, r1, c7, c5, 0\n"    /* ICIALLU */
+    "    mcr p15, 0, r1, c8, c7, 0\n"    /* TLBIALL */
+    "    mcr p15, 2, r1, c0, c0, 0\n"    /* CSSELR = L1 data */
+    "    isb\n"
+    "    mrc p15, 1, r2, c0, c0, 0\n"    /* CCSIDR */
+    "    and r3, r2, #7\n"
+    "    add r3, r3, #4\n"               /* log2(line bytes) */
+    "    ubfx r4, r2, #3, #10\n"         /* ways - 1 */
+    "    clz r5, r4\n"
+    "    ubfx r6, r2, #13, #15\n"        /* sets - 1 */
+    "1:  mov r7, r4\n"
+    "2:  lsl r8, r7, r5\n"
+    "    orr r8, r8, r6, lsl r3\n"
+    "    mcr p15, 0, r8, c7, c6, 2\n"    /* DCISW, L1 only */
+    "    subs r7, r7, #1\n"
+    "    bge 2b\n"
+    "    subs r6, r6, #1\n"
+    "    bge 1b\n"
+    "    dsb\n"
+    "    isb\n"
+    "    mov r1, #1\n"
+    "    str r1, [r0, #12]\n"            /* state 1: trampoline */
+    "    ldr r1, [r0, #28]\n"
+    "    mcr p15, 0, r1, c3, c0, 0\n"    /* DACR */
+    "    ldr r1, [r0, #24]\n"
+    "    mcr p15, 0, r1, c2, c0, 2\n"    /* TTBCR */
+    "    ldr r1, [r0, #16]\n"
+    "    mcr p15, 0, r1, c2, c0, 0\n"    /* TTBR0 */
+    "    ldr r1, [r0, #20]\n"
+    "    mcr p15, 0, r1, c2, c0, 1\n"    /* TTBR1 */
+    "    mov r1, #0\n"
+    "    mcr p15, 0, r1, c13, c0, 1\n"   /* CONTEXTIDR */
+    "    ldr r1, [r0, #36]\n"
+    "    mcr p15, 0, r1, c12, c0, 0\n"   /* VBAR */
+    "    mcr p15, 0, r1, c8, c7, 0\n"    /* TLBIALL again */
+    "    dsb\n"
+    "    isb\n"
+    "    ldr r1, [r0, #32]\n"
+    "    mcr p15, 0, r1, c1, c0, 0\n"    /* SCTLR: MMU + caches on, still at the identity address */
+    "    isb\n"
+    "    ldr sp, [r0, #40]\n"
+    "    ldr r1, [r0, #44]\n"
+    "    bx r1\n"                        /* s5_helper_main (Thumb, kernel address) */
+    ".align 6\n"
+    ".globl _s5_tramp_box\n"
+    "_s5_tramp_box:\n"
+    "9:  .space 128\n"
+    ".text\n");
+
+/* The vector table proper: 8 entries, each records its index. */
+__asm__(
+    ".text\n"
+    ".align 5\n"
+    ".arm\n"
+    ".globl _s5_vectab\n"
+    "_s5_vectab:\n"
+    "    b 70f\n"
+    "    b 71f\n"
+    "    b 72f\n"
+    "    b 73f\n"
+    "    b 74f\n"
+    "    b 75f\n"
+    "    b 76f\n"
+    "    b 77f\n"
+    "70: mov r0, #0\n    b 79f\n"
+    "71: mov r0, #1\n    b 79f\n"
+    "72: mov r0, #2\n    b 79f\n"
+    "73: mov r0, #3\n    b 79f\n"
+    "74: mov r0, #4\n    b 79f\n"
+    "75: mov r0, #5\n    b 79f\n"
+    "76: mov r0, #6\n    b 79f\n"
+    "77: mov r0, #7\n"
+    "79: ldr r1, 78f\n"
+    "    add r0, r0, #0x100\n"
+    "    str r0, [r1, #48]\n"
+    "    str lr, [r1, #52]\n"
+    "    mrc p15, 0, r2, c6, c0, 0\n"    /* DFAR */
+    "    str r2, [r1, #56]\n"
+    "    mrc p15, 0, r2, c5, c0, 0\n"    /* DFSR */
+    "    str r2, [r1, #60]\n"
+    "    mov r2, #9\n"
+    "    str r2, [r1, #12]\n"            /* state 9: faulted */
+    "    dsb\n"
+    "80: wfi\n"
+    "    b 80b\n"
+    ".align 2\n"
+    "78: .word _s5_tramp_box\n"
+    ".thumb\n");
+extern void s5_vectab(void);
+
+/* one-page TTBR0 table (TTBCR N=2 -> 1024 entries, 4 KiB aligned) and the helper stack */
+static uint32_t s5_ttbr0[1024] __attribute__((aligned(4096)));
+static uint32_t s5_stack[4096] __attribute__((aligned(16)));
+
+static inline void inval_line(const volatile void *p)
+{
+    __asm__ volatile("mcr p15, 0, %0, c7, c6, 1\n dsb" :: "r"((uint32_t)(uintptr_t)p & ~63U) : "memory");
+}
+static inline uint32_t cntpct_lo(void)
+{
+    uint32_t lo, hi;
+    __asm__ volatile("isb\n mrrc p15, 0, %0, %1, c14" : "=r"(lo), "=r"(hi));
+    return lo;
+}
+
+/* ---- the mirror (run by whichever core owns it) ---- */
+static uint32_t m_rowhash[800];
+static int m_hashed, m_cleared;
+static unsigned char m_line[1080U * 3U] __attribute__((aligned(4)));
+static unsigned short m_xmap[1080];
+static uint32_t m_last_kick;
+
+static void mdp_kick(void)
+{
+    uint32_t m = s4_early_mdp;
+    /* at most one command-mode transfer per 50 ms (restarting one in flight leaves parts of the panel white) */
+    while (m_last_kick && cntpct_lo() - m_last_kick < 960000U)
+        ;
+    m_last_kick = cntpct_lo();
+    __asm__ volatile("dsb sy" ::: "memory");
+    if (m)
+        *(volatile uint32_t *)(m + 0x61cU) = 1U;
+}
+
+/* returns the number of changed GUI rows */
+uint32_t s5_mirror_frame(const uint8_t *px, uint32_t row, int kick)
+{
+    uint32_t fb = s4_early_fb, y, x, i, changed = 0;
+    if (!fb || !px || row < 1920U)
+        return 0;
+    if (!m_cleared) {
+        volatile uint32_t *all = (volatile uint32_t *)fb;
+        for (i = 0; i < FB_ROW * FB_H / 4U; i++)
+            all[i] = 0;
+        for (x = 0; x < 1080U; x++)
+            m_xmap[x] = (unsigned short)((x * 4U) / 9U);
+        m_cleared = 1;
+    }
+    for (y = 0; y < 800U; y++) {
+        const uint8_t *s = px + y * row;
+        uint32_t d0 = (y * 9U + 3U) / 4U, d1 = ((y + 1U) * 9U + 3U) / 4U, h = s5_row_hash((const uint32_t *)s, 480U);
+        if (m_hashed && m_rowhash[y] == h)
+            continue;
+        m_rowhash[y] = h;
+        changed++;
+        s5_expand_bgr(m_line, s, m_xmap, 1080U);
+        for (i = d0; i < d1 && i < 1800U; i++)
+            s5_copy_words((volatile uint32_t *)(fb + (60U + i) * FB_ROW), (const uint32_t *)m_line, 1080U * 3U / 4U);
+    }
+    m_hashed = 1;
+    if (kick && changed)
+        mdp_kick();
+    return changed;
+}
+
+/* ---- CPU1 ---- */
+void s5_helper_main(void)
+{
+    volatile uint32_t *b = s5_tramp_box;
+    uint32_t mpidr;
+    __asm__ volatile("mrc p15, 0, %0, c0, c0, 5" : "=r"(mpidr));
+    b[B_MPIDR] = mpidr;
+    b[B_STATE] = 2; /* in C */
+    __asm__ volatile("dsb" ::: "memory");
+    for (;;) {
+        uint32_t seq, done;
+        inval_line(&b[B_JSEQ]);
+        seq = b[B_JSEQ];
+        done = b[B_DONE];
+        if (seq != done) {
+            const uint8_t *px = (const uint8_t *)(uintptr_t)b[B_JPX];
+            uint32_t rowb = b[B_JROW], t0 = cntpct_lo(), a, n;
+            __asm__ volatile("mcr p15, 0, %0, c8, c7, 0\n dsb\n isb" :: "r"(0) : "memory"); /* TLBIALL */
+            for (a = (uint32_t)(uintptr_t)px & ~63U, n = (uint32_t)(uintptr_t)px + rowb * 800U; a < n; a += 64U)
+                __asm__ volatile("mcr p15, 0, %0, c7, c6, 1" :: "r"(a)); /* DCIMVAC: CPU0's frame */
+            __asm__ volatile("dsb" ::: "memory");
+            b[B_ROWS] += s5_mirror_frame(px, rowb, 1);
+            b[B_BUSY] += cntpct_lo() - t0;
+            b[B_JOBS]++;
+            b[B_DONE] = seq;
+            __asm__ volatile("dsb" ::: "memory");
+        } else {
+            b[B_HEART]++;
+            for (volatile int k = 0; k < 2000; k++)
+                ;
+        }
+    }
+}
+
+/* ---- CPU0 side ---- */
+static int h_active, h_dead;
+static uint32_t h_posted, h_post_tick;
+
+/* Fill the parameter block; returns the trampoline's physical address (0 on failure). kvtophys from the caller. */
+uint32_t s5_helper_prepare(uint32_t (*v2p)(uint32_t))
+{
+    volatile uint32_t *b = s5_tramp_box;
+    uint32_t tramp_pa = v2p((uint32_t)(uintptr_t)&s5_tramp), ttbr0_pa = v2p((uint32_t)(uintptr_t)s5_ttbr0);
+    uint32_t r, i;
+    if (!tramp_pa || !ttbr0_pa || (ttbr0_pa & 0xfffU))
+        return 0;
+    for (i = 0; i < 1024U; i++)
+        s5_ttbr0[i] = 0;
+    /* identity section (strongly ordered, privileged RW, executable) for the trampoline's 1 MiB */
+    s5_ttbr0[tramp_pa >> 20] = (tramp_pa & 0xfff00000U) | (1U << 10) | 2U;
+    for (i = 0; i < B_WORDS; i++)
+        b[i] = 0;
+    __asm__ volatile("mrc p15, 0, %0, c2, c0, 0" : "=r"(r));
+    b[B_TTBR0] = ttbr0_pa | (r & 0x7fU);
+    __asm__ volatile("mrc p15, 0, %0, c2, c0, 1" : "=r"(r));
+    b[B_TTBR1] = r;
+    __asm__ volatile("mrc p15, 0, %0, c2, c0, 2" : "=r"(r));
+    b[B_TTBCR] = r;
+    __asm__ volatile("mrc p15, 0, %0, c3, c0, 0" : "=r"(r));
+    b[B_DACR] = r;
+    __asm__ volatile("mrc p15, 0, %0, c1, c0, 0" : "=r"(r));
+    b[B_SCTLR] = r;
+    b[B_VBAR] = (uint32_t)(uintptr_t)&s5_vectab & ~1U;
+    b[B_SP] = (uint32_t)(uintptr_t)&s5_stack[4096];
+    b[B_ENTRY] = (uint32_t)(uintptr_t)&s5_helper_main | 1U;
+    __asm__ volatile("dsb" ::: "memory");
+    return tramp_pa;
+}
+
+uint32_t s5_helper_word(int i)
+{
+    volatile uint32_t *b = s5_tramp_box;
+    inval_line(&b[i]);
+    return b[i];
+}
+
+/* After the core is up: use it if it reached C with TTBCR N=2 (TTBR1 must cover the kernel) */
+int s5_helper_enable(void)
+{
+    if (s5_helper_word(B_STATE) == 2 && (s5_tramp_box[B_TTBCR] & 7U) == 2U)
+        h_active = 1;
+    return h_active;
+}
+
+/* CPU0 present path: hand the frame to CPU1, or mirror it here when the helper is not usable. */
+void s5_present_mirror(const uint8_t *px, uint32_t row)
+{
+    volatile uint32_t *b = s5_tramp_box;
+    if (h_active && !h_dead) {
+        static uint32_t last_done, progress_tick;
+        uint32_t done = s5_helper_word(B_DONE), now = cntpct_lo();
+        uint32_t st = s5_helper_word(B_STATE);
+        if (done != last_done || done == h_posted) {
+            last_done = done;
+            progress_tick = now;
+        }
+        if (st == 9 || (done != h_posted && now - progress_tick > 19200000U)) { /* fault, or 1 s without progress */
+            h_dead = 1;
+        } else {
+            /* run 132: always post the newest frame (run 131 dropped frames while CPU1 was busy, so the last frame of an
+             * animation could stay unmirrored); CPU1 mirrors again whenever the sequence moved on */
+            /* run 132: the frame surface is mapped write-back (kIOMapCopybackCache): backboardd's newest pixels can sit
+             * dirty in this core's cache. Clean them to RAM so CPU1 reads this frame, not the previous one (run 131:
+             * CPU1 saw 0 changed rows on every job). */
+            {
+                uint32_t a = (uint32_t)(uintptr_t)px & ~63U, e = (uint32_t)(uintptr_t)px + row * 800U;
+                for (; a < e; a += 64U)
+                    __asm__ volatile("mcr p15, 0, %0, c7, c10, 1" :: "r"(a)); /* DCCMVAC */
+                __asm__ volatile("dsb" ::: "memory");
+            }
+            b[B_JPX] = (uint32_t)(uintptr_t)px;
+            b[B_JROW] = row;
+            __asm__ volatile("dsb" ::: "memory");
+            b[B_JSEQ] = ++h_posted;
+            __asm__ volatile("dsb" ::: "memory");
+            (void)h_post_tick;
+            return;
+        }
+    }
+    s5_mirror_frame(px, row, 1);
+}
+
+int s5_helper_state(void) { return h_dead ? -1 : h_active; }
+#endif /* J1_S5 */
