+IOReturn IOS7S5SDHCI::reportLockability(bool *v) { if (!v) return kIOReturnBadArgument; *v = false; return kIOReturnSuccess; }
+IOReturn IOS7S5SDHCI::reportRemovability(bool *v) { if (!v) return kIOReturnBadArgument; *v = false; return kIOReturnSuccess; }
