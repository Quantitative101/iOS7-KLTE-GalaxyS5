diff --git a/xnu/osfmk/kern/j1_sampler.c b/xnu/osfmk/kern/j1_sampler.c
new file mode 100644
index 0000000..4e580fd
--- /dev/null
+++ b/xnu/osfmk/kern/j1_sampler.c
@@ -0,0 +1,118 @@
+#ifdef J1_QEMU_PL011
+/* QEMU bring-up: periodically print the user-mode PC/LR and a frame-pointer walk of every thread of a few named
+ * processes, so a stalled userland (e.g. backboardd) can be located offline in the dyld shared cache. */
+#include <mach/mach_types.h>
+#include <mach/arm/thread_status.h>
+#include <kern/kern_types.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <kern/queue.h>
+#include <vm/vm_map.h>
+#include <string.h>
+
+extern void *find_user_regs(thread_t thread);
+extern void *proc_find(int pid);
+extern void proc_rele(void *p);
+extern void *proc_task(void *p);
+extern void proc_name(int pid, char *buf, int size);
+extern int printf(const char *, ...);
+
+static const char *const j1_targets[] = { "backboardd", "SpringBoard", "syslogd", "notifyd", "configd", "launchd", "aslmanager", "MobileGestaltHel", "launchctl", "tzinit", 0 };
+
+static int
+j1_name_match(const char *name)
+{
+    int i;
+    for (i = 0; j1_targets[i]; i++)
+        if (!strncmp(name, j1_targets[i], 16))
+            return 1;
+    return 0;
+}
+
+static void
+j1_sample_once(void)
+{
+    int pid;
+    for (pid = 1; pid < 600; pid++) {
+        char name[32];
+        void *p = proc_find(pid);
+        task_t task;
+        thread_t th;
+        unsigned n = 0;
+        if (!p)
+            continue;
+        name[0] = 0;
+        proc_name(pid, name, sizeof(name));
+        if (!j1_name_match(name)) {
+            proc_rele(p);
+            continue;
+        }
+        task = (task_t)proc_task(p);
+        task_lock(task);
+        queue_iterate(&task->threads, th, thread_t, task_threads) {
+            arm_saved_state_t *s = (arm_saved_state_t *)find_user_regs(th);
+            uint32_t fp, depth;
+            printf("J1SAMPLE %s[%d] thr%u state=0x%x pc=%08x lr=%08x sp=%08x\n", name, pid, n, th->state,
+                   s->pc, s->lr, s->sp);
+            {
+                /* raw words at the PC (and the return address) so the sliding shared-cache address can be found offline */
+                uint32_t w[8], i, a;
+                uint32_t addrs[2];
+                addrs[0] = s->pc & ~1U;
+                addrs[1] = s->lr & ~1U;
+                for (a = 0; a < 2; a++) {
+                    if (addrs[a] < 0x70000000U && vm_map_read_user(task->map, (vm_map_address_t)addrs[a], w, sizeof(w)) == KERN_SUCCESS) {
+                        printf("J1SAMPLE    %s@%08x:", a ? "lr" : "pc", addrs[a]);
+                        for (i = 0; i < 8; i++)
+                            printf(" %08x", w[i]);
+                        printf("\n");
+                    }
+                }
+            }
+            fp = s->r[7];
+            for (depth = 0; depth < 8; depth++) {
+                uint32_t link[2];
+                if ((fp & 3U) || fp >= 0x70000000U || fp < s->sp || fp > s->sp + 0x200000U)
+                    break;
+                if (vm_map_read_user(task->map, (vm_map_address_t)fp, link, sizeof(link)) != KERN_SUCCESS)
+                    break;
+                printf("J1SAMPLE    frame %u ret=%08x\n", depth, link[1]);
+                if (link[0] <= fp)
+                    break;
+                fp = link[0];
+            }
+            n++;
+        }
+        task_unlock(task);
+        proc_rele(p);
+    }
+}
+
+static void
+j1_sampler_thread(__unused void *arg, __unused wait_result_t wr)
+{
+    for (;;) {
+        /* sample every ~20 s of guest time */
+        uint64_t deadline;
+        clock_interval_to_deadline(20, NSEC_PER_SEC, &deadline);
+        assert_wait_deadline((event_t)&j1_sampler_thread, THREAD_UNINT, deadline);
+        thread_block(THREAD_CONTINUE_NULL);
+        j1_sample_once();
+    }
+}
+
+void
+j1_sampler_start(void)
+{
+    thread_t thr;
+#ifdef J1_S4MINI
+    /* it printf()s p_comm of processes that may be reaped under it: on the S4 a freed name page is unmapped and the %s read
+     * faults inside printf (data abort in cnputc, then 'recursive abort' fatals); it also floods the 256 KB console ring */
+    return;
+#endif
+    if (kernel_thread_start(j1_sampler_thread, NULL, &thr) == KERN_SUCCESS)
+        thread_deallocate(thr);
+}
+#endif
