+        if (!s4_tmr) panic("Tab 2 A9 timer IO mapping failed");
+        s4_wr(T2_PT + 0x08, 0U);                                    /* private timer off */
+        s4_wr(T2_PT + 0x0c, 1U);                                    /* clear its event flag */
+        s4_wr(T2_GT + 0x08, (s4_rd(T2_GT + 0x08) & ~0xff0fU) | 1U); /* global timer on, prescaler 0, no comparator */
+    }
