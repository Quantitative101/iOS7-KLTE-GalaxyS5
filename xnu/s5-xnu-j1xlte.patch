diff --git a/xnu/bsd/kern/decmpfs.c b/xnu/bsd/kern/decmpfs.c
index a2d649e..04b5ec9 100644
--- a/xnu/bsd/kern/decmpfs.c
+++ b/xnu/bsd/kern/decmpfs.c
@@ -1765,6 +1765,248 @@ static decmpfs_registration Type1Reg =
     .get_flags         = NULL  /* no flags */
 };
 
+#pragma mark --- zlib compressors (types 3 and 4) ---
+
+/*
+ Type 3: zlib stream stored in the decmpfs xattr after the 16-byte header.
+ Type 4: zlib stored in the resource fork, in 64KB chunks. The resource fork starts with a big-endian header
+ (dataOffset at +0, dataLength at +8); at dataOffset+4 comes a little-endian chunk count followed by one
+ {offset,length} little-endian pair per chunk, offsets relative to dataOffset+4.
+ In both types a leading byte whose low nibble is 0xF marks data stored raw after that byte.
+ */
+#include <libkern/zlib.h>
+#include <sys/malloc.h>
+
+#define DECMPFS_ZLIB_CHUNK 65536U
+
+static void *
+dz_alloc(__unused void *opaque, uInt items, uInt size)
+{
+    return _MALLOC((size_t)items * size, M_TEMP, M_WAITOK);
+}
+
+static void
+dz_free(__unused void *opaque, void *ptr)
+{
+    _FREE(ptr, M_TEMP);
+}
+
+/* Decode one zlib (or raw-marked) block into dst; returns 0 and the number of bytes produced in *outlen. */
+static int
+dz_decode_block(const uint8_t *src, size_t srclen, uint8_t *dst, size_t dstlen, size_t *outlen)
+{
+    z_stream s;
+    int r;
+
+    if (srclen == 0)
+        return EINVAL;
+    if ((src[0] & 0x0F) == 0x0F) {
+        size_t n = srclen - 1;
+        if (n > dstlen)
+            return EINVAL;
+        memcpy(dst, src + 1, n);
+        *outlen = n;
+        return 0;
+    }
+    bzero(&s, sizeof(s));
+    s.zalloc = dz_alloc;
+    s.zfree = dz_free;
+    if (inflateInit(&s) != Z_OK)
+        return ENOMEM;
+    s.next_in = (Bytef *)(uintptr_t)src;
+    s.avail_in = (uInt)srclen;
+    s.next_out = dst;
+    s.avail_out = (uInt)dstlen;
+    r = inflate(&s, Z_FINISH);
+    *outlen = (size_t)s.total_out;
+    inflateEnd(&s);
+    return (r == Z_STREAM_END) ? 0 : EIO;
+}
+
+static int
+dz_rsrc_read(vnode_t vp, off_t off, void *buf, size_t len)
+{
+    char uio_buf[UIO_SIZEOF(1)];
+    size_t got = len;
+    int err;
+    uio_t u = uio_createwithbuffer(1, off, UIO_SYSSPACE, UIO_READ, &uio_buf[0], sizeof(uio_buf));
+
+    if (!u)
+        return ENOMEM;
+    uio_addiov(u, CAST_USER_ADDR_T(buf), len);
+    err = vn_getxattr(vp, XATTR_RESOURCEFORK_NAME, u, &got, XATTR_NOSECURITY, decmpfs_ctx);
+    if (err == 0 && got != len)
+        err = EIO;
+    return err;
+}
+
+/* Cursor over the caller's scatter list. */
+typedef struct {
+    decmpfs_vector *vec;
+    int nvec;
+    int idx;
+    user_ssize_t used;
+} dz_cursor;
+
+static void
+dz_emit(dz_cursor *c, const uint8_t *data, size_t len)
+{
+    while (len > 0 && c->idx < c->nvec) {
+        user_ssize_t room = c->vec[c->idx].size - c->used;
+        user_ssize_t n = (user_ssize_t)len < room ? (user_ssize_t)len : room;
+        if (n > 0) {
+            memcpy((uint8_t *)c->vec[c->idx].buf + c->used, data, (size_t)n);
+            c->used += n;
+            data += n;
+            len -= (size_t)n;
+        }
+        if (c->used >= c->vec[c->idx].size) {
+            c->idx++;
+            c->used = 0;
+        }
+    }
+}
+
+static void
+decmpfs_adjust_fetch_zlib(__unused vnode_t vp, __unused vfs_context_t ctx, decmpfs_header *hdr, off_t *offset, user_ssize_t *size)
+{
+    off_t start = *offset & ~((off_t)DECMPFS_ZLIB_CHUNK - 1);
+    off_t end = (*offset + *size + DECMPFS_ZLIB_CHUNK - 1) & ~((off_t)DECMPFS_ZLIB_CHUNK - 1);
+    if ((uint64_t)end > hdr->uncompressed_size)
+        end = (off_t)hdr->uncompressed_size;
+    *offset = start;
+    *size = end - start;
+}
+
+static int
+decmpfs_validate_zlib(__unused vnode_t vp, __unused vfs_context_t ctx, decmpfs_header *hdr)
+{
+    if (hdr->attr_size < sizeof(decmpfs_disk_header))
+        return EINVAL;
+    return 0;
+}
+
+static int
+decmpfs_fetch_zlib_attr(__unused vnode_t vp, __unused vfs_context_t ctx, decmpfs_header *hdr, off_t offset, user_ssize_t size, int nvec, decmpfs_vector *vec, uint64_t *bytes_read)
+{
+    uint64_t usize = hdr->uncompressed_size;
+    size_t payload = hdr->attr_size - sizeof(decmpfs_disk_header), outlen = 0;
+    uint8_t *out;
+    int err;
+    dz_cursor cur = { vec, nvec, 0, 0 };
+
+    if (usize == 0 || usize > (16U << 20) || (uint64_t)offset >= usize)
+        return EINVAL;
+    out = _MALLOC((size_t)usize, M_TEMP, M_WAITOK);
+    if (!out)
+        return ENOMEM;
+    err = dz_decode_block(hdr->attr_bytes, payload, out, (size_t)usize, &outlen);
+    if (err == 0) {
+        if ((uint64_t)(offset + size) > outlen)
+            size = (user_ssize_t)(outlen - (size_t)offset);
+        dz_emit(&cur, out + offset, (size_t)size);
+        if (bytes_read)
+            *bytes_read = (uint64_t)size;
+    }
+    _FREE(out, M_TEMP);
+    return err;
+}
+
+static int
+decmpfs_fetch_zlib_rsrc(vnode_t vp, __unused vfs_context_t ctx, decmpfs_header *hdr, off_t offset, user_ssize_t size, int nvec, decmpfs_vector *vec, uint64_t *bytes_read)
+{
+    uint64_t usize = hdr->uncompressed_size;
+    uint8_t head[16];
+    uint32_t dataOffset, count, b, first, last;
+    off_t tableBase;
+    uint8_t *tbl = NULL, *in = NULL, *out = NULL;
+    uint64_t total = 0;
+    dz_cursor cur = { vec, nvec, 0, 0 };
+    int err;
+
+    if ((uint64_t)offset >= usize)
+        return EINVAL;
+    if ((uint64_t)(offset + size) > usize)
+        size = (user_ssize_t)(usize - (uint64_t)offset);
+    if ((err = dz_rsrc_read(vp, 0, head, sizeof(head))) != 0)
+        return err;
+    dataOffset = OSSwapBigToHostInt32(*(uint32_t *)&head[0]);
+    tableBase = (off_t)dataOffset + 4;
+    if ((err = dz_rsrc_read(vp, tableBase, head, 4)) != 0)
+        return err;
+    count = OSSwapLittleToHostInt32(*(uint32_t *)&head[0]);
+    if (count == 0 || count > (uint32_t)((usize + DECMPFS_ZLIB_CHUNK - 1) / DECMPFS_ZLIB_CHUNK) + 1)
+        return EINVAL;
+    tbl = _MALLOC((size_t)count * 8, M_TEMP, M_WAITOK);
+    in = _MALLOC(DECMPFS_ZLIB_CHUNK + 1024, M_TEMP, M_WAITOK);
+    out = _MALLOC(DECMPFS_ZLIB_CHUNK, M_TEMP, M_WAITOK);
+    if (!tbl || !in || !out) {
+        err = ENOMEM;
+        goto done;
+    }
+    if ((err = dz_rsrc_read(vp, tableBase + 4, tbl, (size_t)count * 8)) != 0)
+        goto done;
+    first = (uint32_t)(offset / DECMPFS_ZLIB_CHUNK);
+    last = (uint32_t)((offset + size - 1) / DECMPFS_ZLIB_CHUNK);
+    if (last >= count) {
+        err = EINVAL;
+        goto done;
+    }
+    for (b = first; b <= last; b++) {
+        uint32_t boff = OSSwapLittleToHostInt32(*(uint32_t *)&tbl[b * 8]);
+        uint32_t blen = OSSwapLittleToHostInt32(*(uint32_t *)&tbl[b * 8 + 4]);
+        size_t want = DECMPFS_ZLIB_CHUNK, produced = 0;
+        off_t blockStart = (off_t)b * DECMPFS_ZLIB_CHUNK;
+        size_t from, upto;
+
+        if ((uint64_t)blockStart + want > usize)
+            want = (size_t)(usize - (uint64_t)blockStart);
+        if (blen == 0 || blen > DECMPFS_ZLIB_CHUNK + 1024) {
+            err = EINVAL;
+            goto done;
+        }
+        if ((err = dz_rsrc_read(vp, tableBase + boff, in, blen)) != 0)
+            goto done;
+        if ((err = dz_decode_block(in, blen, out, DECMPFS_ZLIB_CHUNK, &produced)) != 0)
+            goto done;
+        if (produced < want) {
+            err = EIO;
+            goto done;
+        }
+        from = (offset > blockStart) ? (size_t)(offset - blockStart) : 0;
+        upto = ((uint64_t)(offset + size) < (uint64_t)blockStart + want) ? (size_t)(offset + size - blockStart) : want;
+        dz_emit(&cur, out + from, upto - from);
+        total += upto - from;
+    }
+    if (bytes_read)
+        *bytes_read = total;
+done:
+    if (tbl) _FREE(tbl, M_TEMP);
+    if (in) _FREE(in, M_TEMP);
+    if (out) _FREE(out, M_TEMP);
+    return err;
+}
+
+static decmpfs_registration ZlibAttrReg =
+{
+    .decmpfs_registration = DECMPFS_REGISTRATION_VERSION,
+    .validate          = decmpfs_validate_zlib,
+    .adjust_fetch      = NULL,
+    .fetch             = decmpfs_fetch_zlib_attr,
+    .free_data         = NULL,
+    .get_flags         = NULL
+};
+
+static decmpfs_registration ZlibRsrcReg =
+{
+    .decmpfs_registration = DECMPFS_REGISTRATION_VERSION,
+    .validate          = decmpfs_validate_zlib,
+    .adjust_fetch      = decmpfs_adjust_fetch_zlib,
+    .fetch             = decmpfs_fetch_zlib_rsrc,
+    .free_data         = NULL,
+    .get_flags         = NULL
+};
+
 #pragma mark --- decmpfs initialization ---
 
 void decmpfs_init()
@@ -1780,7 +2022,9 @@ void decmpfs_init()
     decompress_channel_mtx = lck_mtx_alloc_init(decmpfs_lockgrp, NULL);
     
     register_decmpfs_decompressor(CMP_Type1, &Type1Reg);
-    
+    register_decmpfs_decompressor(3, &ZlibAttrReg);
+    register_decmpfs_decompressor(4, &ZlibRsrcReg);
+
     done = 1;
 }
 #endif /* HFS_COMPRESSION */
