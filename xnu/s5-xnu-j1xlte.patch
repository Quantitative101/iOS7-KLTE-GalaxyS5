@@ -0,0 +1,539 @@
+#if defined(J1_S4MINI) && !defined(J1_TAB2) && !defined(J1_S5)
+/* Galaxy S4 Mini (MSM8930) external microSD: Qualcomm SDCC3 (legacy PL180-style MCI), polled PIO, read/write.
+ * The card carries the same MBR/0xAF layout as the QEMU disk (tools/make-disk.py), so the generic block driver +
+ * FDisk scheme personalities used by the virtio path publish disk0s1/disk0s2. No DMA, no IRQ, no clock setup:
+ * bring-up relies on whatever state the bootloader left, and logs register state to show what is missing. */
+#include <IOKit/storage/IOBlockStorageDevice.h>
+#include <IOKit/storage/IOBlockStorageDriver.h>
+#include <IOKit/storage/IOMedia.h>
+#include <IOKit/IOCatalogue.h>
+#include <IOKit/IOLib.h>
