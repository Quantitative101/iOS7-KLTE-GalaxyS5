+ __asm__ volatile("mrc p15, 0, %0, c1, c0, 0" : "=r"(sctlr));
+ if(sctlr & 4U){ s5_dcache_sctlr=sctlr; return; }
+ __asm__ volatile("mrc p15, 1, %0, c0, c0, 1" : "=r"(clidr));
