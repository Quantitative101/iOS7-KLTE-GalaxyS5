+/*
+ * Per-frame pixel loops of the S5/S4 Mini GUI mirror, split out of pe_exynos3475_j1.c so they can be built at -O2
+ * (pexpert/conf/Makefile.template: s5_blit.o_CFLAGS_ADD) while the rest of the ARM kernel stays at -O0. At -O0 every
+ * loop variable lives on the stack: the 1.5 MB present copy, the 384000-word row hashes and the 1080-pixel line
+ * expansion cost several times what they do optimized (run 103: ~15% of timer samples in this path plus logging).
+ * Plain leaf functions, no kernel state.
+ */
+#include <stdint.h>
+
+/* FNV-1a over n 32-bit words */
+uint32_t s5_row_hash(const uint32_t *w, unsigned int n)
+{
+	uint32_t h = 2166136261U;
+	unsigned int x;
+	for (x = 0; x < n; x++)
+		h = (h ^ w[x]) * 16777619U;
+	return h;
+}
+
+/* n output pixels as B,G,R bytes from a BGRA row, source pixel index xmap[x] */
+void s5_expand_bgr(uint8_t *line, const uint8_t *src, const unsigned short *xmap, unsigned int n)
+{
+	unsigned int x;
+	for (x = 0; x < n; x++) {
+		const uint8_t *p = src + (unsigned int)xmap[x] * 4U;
+		line[0] = p[0];
+		line[1] = p[1];
+		line[2] = p[2];
+		line += 3;
+	}
+}
+
+/* S4 Mini mirror line: every 2nd of n*2 BGRA source pixels, n as B,G,R bytes then the same n as R,G,B (both byte
+ * orders side by side on the S4 scanout, see s4_mirror in pe_exynos3475_j1.c) */
+void s4_expand_halves(uint8_t *line, const uint8_t *src, unsigned int n)
+{
+	uint8_t *rgb = line + n * 3U;
+	unsigned int x;
+	for (x = 0; x < n; x++) {
+		const uint8_t *p = src + x * 8U;
+		line[0] = p[0];
+		line[1] = p[1];
+		line[2] = p[2];
+		rgb[0] = p[2];
+		rgb[1] = p[1];
+		rgb[2] = p[0];
+		line += 3;
+		rgb += 3;
+	}
+}
