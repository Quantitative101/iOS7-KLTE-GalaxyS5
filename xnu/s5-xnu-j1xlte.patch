+ __asm__ volatile("dsb\n mcr p15, 0, %0, c1, c0, 0\n isb" :: "r"(sctlr) : "memory");
+ __asm__ volatile("mrc p15, 0, %0, c1, c0, 0" : "=r"(s5_dcache_sctlr));
