+/* Per-board physical addresses of the "real hardware without a serial cable" variants (J1_S4MINI and its derivative
+ * J1_TAB2): the text console scanout, the log ring and crumb page that survive a reset, and the tick hardware.
+ * Plain #defines without integer suffixes: included from locore.s too. */
+#ifndef J1_BOARD_H
+#define J1_BOARD_H
+
+#if defined(J1_S5)
+/* Galaxy S5 (SM-G900M klte, MSM8974PRO-AC): LK's continuous splash scans out the RGB0 pipe from 0x03200000, 1080x1920
+ * packed 24-bit with a 3456-byte stride (1152 * 3); the command-mode panel only shows a frame after CTL0 START
+ * (J1B_MDP_PA + 0x61c) is written, which the console and the tick do (pe_exynos3475_j1.c). Ring and crumbs sit below
+ * XNU's RAM (physBase 0x20000000) in System RAM LK does not use. QGIC2 at 0xf9000000/0xf9002000; the tick is the ARM
+ * generic timer (non-secure physical, INTID 19), so J1B_TMR_PA only backs harmless diagnostic reads (the crumb page). */
+#define J1B_FB_PA       0x03200000
+#define J1B_FB_W        1080U
+#define J1B_FB_H        1920U
+#define J1B_FB_BPP      3U
+#define J1B_FB_ROW      3240U          /* 1080 * 3: LK splash stride (3456 sheared the text) */
+#define J1B_RING_PA     0x1f010000     /* header + 256 KiB text */
+#define J1B_CRUMB_PAGE  0x1f000000     /* stage words at +0xf00 (stub), +0xf40 (locore), +0xf80 (arm_init), +0xfc0 (timer) */
+#define J1B_EARLY_SEC0  0x1f000000
+#define J1B_EARLY_SEC1  0x03200000
+#define J1B_GICD_PA     0xf9000000
+#define J1B_GICC_PA     0xf9002000
