+	return;
+#endif
     s = splsched();
     thread_lock(self);
 	if (!(self->sched_flags & TH_SFLAG_DEPRESSED_MASK)) {
diff --git a/xnu/osfmk/kern/thread.c b/xnu/osfmk/kern/thread.c
index 42b1b4b..b1ce9e0 100644
--- a/xnu/osfmk/kern/thread.c
+++ b/xnu/osfmk/kern/thread.c
@@ -1855,3 +1855,87 @@ void dtrace_thread_bootstrap(void)
 
 }
 #endif /* CONFIG_DTRACE */
+
+#ifdef J1_S4MINI
+/* S4 Mini bring-up: dump every thread's wait state and a frame-pointer walk of its saved stack to the console ring.
+ * Thumb frames: r7 is the frame pointer, [r7] = caller's r7, [r7+4] = return address. Racy and read-only, debug only. */
+void s4_dump_threads(void);
+extern int proc_pid(void *);
+extern void proc_name(int, char *, int);
+void s4_dump_threads(void)
+{
+	thread_t th;
+	unsigned n = 0, i;
+	extern int disableConsoleOutput;
+	int quiet = disableConsoleOutput;
+	disableConsoleOutput = 0; /* the video console turns printf off once a GUI frame is up (S5 run 4 lost the dump) */
+	{
+		uint32_t cpsr;
+		__asm__ volatile("mrs %0, cpsr" : "=r"(cpsr));
+		printf("S4CX cpsr=%x irqon=%d preempt=%d pcnt=%d\n", (unsigned)cpsr, (int)ml_get_interrupts_enabled(),
+		       (int)get_preemption_level(), (int)current_thread()->machine.preempt_count);
+	}
+	{
+		processor_t p = current_processor();
+		printf("S4PR p=%x state=%d act=%x next=%x idle=%x cur=%x pri=%d runq=%d bound=%d psetrq=%d rt=%d\n",
+		       (unsigned)p, p->state, (unsigned)p->active_thread, (unsigned)p->next_thread, (unsigned)p->idle_thread,
+		       (unsigned)current_thread(), p->current_pri, p->runq.count, p->runq_bound_count,
+		       p->processor_set->pset_runq.count, rt_runq.count);
+	}
+	queue_iterate(&threads, th, thread_t, threads) {
+		uint32_t *r = th->machine.iss ? (uint32_t *)((uint8_t *)th->machine.iss + 16) : 0;
+		{
+			void *bp = th->task ? get_bsdtask_info(th->task) : 0;
+			char nm[20] = "";
+			int pid;
+			if (!bp)
+				continue;	/* kernel-only threads: skipped to keep the ring short */
+			pid = proc_pid(bp);
+			if (pid == 0)
+				continue;
+			proc_name(pid, nm, sizeof nm);
+			printf("S4TP pid=%d %s ", pid, nm);
+#if defined(J1_S4MINI) /* all real-hardware boards (was S5-only): user pc/lr/frames of the GUI processes */
+			/* the GUI processes: where each thread sits in userland (pc, lr, sp, and the r7 frame chain read from the
+			 * task's own map), to name the call it waits in with the shared-cache symbols */
+			if ((nm[0] == 'S' && nm[1] == 'p') || (nm[0] == 'b' && nm[1] == 'a') || (nm[0] == 'M' && nm[1] == 'o')) { /* + MobileGestaltHelper */
+				extern void *find_user_regs(thread_t);
+				extern kern_return_t copyinmap(vm_map_t, vm_map_offset_t, void *, vm_size_t);
+				arm_saved_state_t *us = (arm_saved_state_t *)find_user_regs(th);
+				if (us && th->task->map) {
+					uint32_t ufp = us->r[7], lk[2];
+					unsigned d;
+					printf("S5U pc=%x lr=%x sp=%x r0=%x r1=%x", (unsigned)us->pc, (unsigned)us->lr, (unsigned)us->sp,
+					       (unsigned)us->r[0], (unsigned)us->r[1]);
+					for (d = 0; d < 12 && ufp > 0x1000 && ufp < 0x70000000U && !(ufp & 3); d++) {
+						if (copyinmap(th->task->map, (vm_map_offset_t)ufp, lk, 8) != KERN_SUCCESS)
+							break;
+						printf(" %x", (unsigned)lk[1]);
+						if (lk[0] <= ufp)
+							break;
+						ufp = lk[0];
+					}
+					printf(" ");
+				}
+			}
+#endif
+		}
+		printf("S4TH %x st=%x ev=%x cn=%x pr=%d rq=%x", (unsigned)th, (unsigned)th->state, (unsigned)th->wait_event,
+		       (unsigned)th->continuation, (int)th->sched_pri, (unsigned)th->runq);
+		if (th->continuation == 0 && r && th != current_thread()) {
+			uint32_t ks = (uint32_t)th->kernel_stack, fp = r[3];
+			printf(" lr=%x", (unsigned)r[9]);
+			for (i = 0; i < 9; i++) {
+				if (!ks || fp < ks || fp >= ks + KERNEL_STACK_SIZE - 8 || (fp & 3))
+					break;
+				printf(" %x", (unsigned)((uint32_t *)fp)[1]);
+				fp = ((uint32_t *)fp)[0];
+			}
+		}
+		printf("\n");
+		if (++n > 90)
+			break;
+	}
+	disableConsoleOutput = quiet;
+}
+#endif
