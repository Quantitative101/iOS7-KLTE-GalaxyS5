+IOReturn IOS7S5SDHCI::reportBlockSize(UInt64 *v) { if (!v) return kIOReturnBadArgument; *v = 512; return kIOReturnSuccess; }
+IOReturn IOS7S5SDHCI::reportMaxValidBlock(UInt64 *v) { if (!v || !initialized) return kIOReturnNotReady; *v = DISK_SECTORS - 1; return kIOReturnSuccess; }
