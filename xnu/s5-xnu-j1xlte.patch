+ * through the timer helpers. */
+static uint32_t s4_rd(uint32_t off) { return *(volatile uint32_t *)(s4_tmr + off); }
+static void s4_wr(uint32_t off, uint32_t v) { *(volatile uint32_t *)(s4_tmr + off) = v; __asm__ volatile("dsb sy" ::: "memory"); }
+static uint64_t gt_count(void);
+static void s4_tmr_init(void)
+{
+    if (!s4_tmr) {
