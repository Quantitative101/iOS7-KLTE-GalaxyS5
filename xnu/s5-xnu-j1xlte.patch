+#include "IOS7LabStoragePersonalities.h"
+class IOS7S4SDCC;
+static IOS7S4SDCC *s4_dev;
+
+#define SD_PA 0x12180000U /* msm_sdcc.3 */
+static volatile UInt32 *s4gcc; /* GCC page 0x00902000 */
+static bool s4_multiOk=true, s4_wide4; static volatile UInt64 s4io_mreqs, s4io_mfail;
+static volatile UInt64 s4io_reqs, s4io_sectors, s4io_hw_ns, s4io_tot_ns; /* I/O statistics for the heartbeat line */
+
+/* MCI registers (PL180 layout with MSM extensions). */
+#define R_POWER 0x00
+#define R_CLK 0x04
+#define R_ARG 0x08
+#define R_CMD 0x0c
+#define R_RESP 0x14
+#define R_DTIMER 0x24
+#define R_DLEN 0x28
+#define R_DCTL 0x2c
+#define R_DCNT 0x30
+#define R_STATUS 0x34
+#define R_CLEAR 0x38
+#define R_MASK0 0x3c
+#define R_MASK1 0x40
+#define R_VERSION 0x50
+#define R_FIFO 0x80
+
+class IOS7S4SDCC : public IOBlockStorageDevice {
+ OSDeclareDefaultStructors(IOS7S4SDCC)
+ IOMemoryDescriptor *mmio; IOMemoryMap *map; volatile UInt8 *regs;
+ IOLock *mutex; UInt64 sectors; UInt32 rca; bool highCap, initialized, faulted;
+ UInt32 rd(unsigned off) { __asm__ __volatile__("dsb sy":::"memory"); return *(volatile UInt32 *)(regs+off); }
+ void wr(unsigned off,UInt32 v) { *(volatile UInt32 *)(regs+off)=v; __asm__ __volatile__("dsb sy":::"memory"); }
+ IOReturn command(UInt32 index,UInt32 arg,unsigned resp,UInt32 out[4]);
+ IOReturn command0(UInt32 index,UInt32 arg,unsigned resp,UInt32 out[4]);
+ IOReturn cardInit();
+ IOReturn ready();
+ IOReturn sector(UInt64 block,UInt8 *bytes,bool writing);
+ IOReturn readBlocks(UInt64 block,UInt32 count,UInt8 *bytes); /* CMD18 + CMD12, polled */
+ bool wide4;
+public:
+ void snapshot(unsigned slot); /* raw-write the PE_state.video buffer into the card's spare tail (read back from Android) */
+ virtual bool init(OSDictionary *properties=0);
+ virtual bool start(IOService *provider);
+ virtual void free();
+ virtual IOReturn doAsyncReadWrite(IOMemoryDescriptor *,UInt64,UInt64,IOStorageAttributes *,IOStorageCompletion *);
+ virtual IOReturn doEjectMedia(){return kIOReturnUnsupported;}
+ virtual IOReturn doFormatMedia(UInt64){return kIOReturnUnsupported;}
+ virtual UInt32 doGetFormatCapacities(UInt64 *,UInt32)const{return 0;}
+ virtual IOReturn doLockUnlockMedia(bool){return kIOReturnUnsupported;}
+ virtual IOReturn doSynchronizeCache(){return kIOReturnSuccess;}
+ virtual char *getVendorString();virtual char *getProductString();
+ virtual char *getRevisionString();virtual char *getAdditionalDeviceInfoString();
+ virtual IOReturn reportBlockSize(UInt64 *);
+ virtual IOReturn reportMaxValidBlock(UInt64 *);
+ virtual IOReturn reportEjectability(bool *);
+ virtual IOReturn reportLockability(bool *);
+ virtual IOReturn reportRemovability(bool *);
+ virtual IOReturn reportMediaState(bool *,bool *);
+ virtual IOReturn reportPollRequirements(bool *,bool *);
+ virtual IOReturn reportWriteProtection(bool *);
+};
+OSDefineMetaClassAndStructors(IOS7S4SDCC,IOBlockStorageDevice)
+
+static const UInt32 r1Errors=0xfdffe008U;
+static const UInt32 dataErrors=(1U<<1)|(1U<<3)|(1U<<4)|(1U<<5);
+static const unsigned pollLimit=2000000;
+
+bool IOS7S4SDCC::init(OSDictionary *p)
+{
+ mmio=0; map=0; regs=0; mutex=0; sectors=0; rca=0; highCap=initialized=faulted=false;
+ return IOBlockStorageDevice::init(p);
+}
+IOReturn IOS7S4SDCC::command(UInt32 index,UInt32 arg,unsigned resp,UInt32 out[4])
+{
+ UInt32 tmp[4]={0,0,0,0};
+ IOReturn rc=command0(index,arg,resp,out?out:tmp);
+ if(rc!=kIOReturnSuccess){
+  static unsigned traced;
+  if(traced++<20) IOLog("S4SD: cmd%u arg=%08x rc=%08x st=%08x r0=%08x\n",(unsigned)index,(unsigned)arg,(unsigned)rc,(unsigned)rd(R_STATUS),(unsigned)(out?out[0]:tmp[0]));
+ }
+ return rc;
+}
+IOReturn IOS7S4SDCC::command0(UInt32 index,UInt32 arg,unsigned resp,UInt32 out[4])
+{
+ /* The status flags cross a clock domain: a CLEAR write is not visible at once (a stale RESP_END from the previous command
+  * made responses lag by one command), so wait for the flags to drop before issuing, and for CMD_ACTIVE to drop after. */
+ wr(R_CLEAR,0xc5); /* completion/error only */
+ for(unsigned n=0;n<pollLimit && (rd(R_STATUS)&((1U<<0)|(1U<<2)|(1U<<6)|(1U<<7)|(1U<<11)));++n){ wr(R_CLEAR,0xc5); IODelay(1); }
+ wr(R_ARG,arg);
+ /* MSM extension: data-transfer commands must carry DATCMD (bit 12). */
+ bool dataCmd=(index==17||index==18||index==24||index==25);
+ wr(R_CMD,index|0x400U|(resp?0x40U:0U)|(resp==2?0x80U:0U)|(dataCmd?0x1000U:0U)|(index==12?0x2000U:0U));
+ for(unsigned n=0;n<pollLimit;++n){
+  UInt32 st=rd(R_STATUS);
+  if(st&(1U<<11)){ IODelay(1); continue; } /* CMD_ACTIVE: command still in flight */
+  if(st&(1U<<2)) return kIOReturnTimeout;
+  /* R3 (ACMD41/CMD1) and R2 carry no valid CRC7: the controller flags CRC fail even on a good response. */
+  bool noCrc=(resp==2 || index==41 || index==1);
+  if((st&1U) && !noCrc) return kIOReturnIOError;
+  if((st&(resp?(1U<<6):(1U<<7))) || ((st&1U) && noCrc)){
+   if(out) for(unsigned i=0;i<4;++i) out[i]=rd(R_RESP+4*i);
+   return kIOReturnSuccess;
+  }
+  IODelay(1);
+ }
+ return kIOReturnTimeout;
+}
+IOReturn IOS7S4SDCC::ready()
+{
+ UInt32 r[4];
+ for(unsigned a=0;a<100;++a){
+  IOReturn rc=command(13,rca,1,r); if(rc!=kIOReturnSuccess) return rc;
+  if(r[0]&r1Errors) return kIOReturnIOError;
+  if((r[0]&(1U<<8)) && ((r[0]>>9)&15U)==4U) return kIOReturnSuccess;
+  IOSleep(1);
+ }
+ return kIOReturnTimeout;
+}
+IOReturn IOS7S4SDCC::cardInit()
+{
+ UInt32 r[4]={0,0,0,0};
+ IOReturn rc=command(0,0,0,0);
+ if(rc!=kIOReturnSuccess) return rc;
+ rc=command(8,0x1aa,1,r);
+ bool v2=(rc==kIOReturnSuccess);
+ if(v2 && r[0]!=0x1aa) return kIOReturnUnsupported;
+ if(!v2 && rc!=kIOReturnTimeout) return rc;
+ bool powered=false;
+ for(unsigned a=0;a<200;++a){
+  rc=command(55,0,1,r); if(rc!=kIOReturnSuccess) return rc;
+  rc=command(41,0x00ff8000U|(v2?0x40000000U:0),1,r); if(rc!=kIOReturnSuccess) return rc;
+  if(r[0]&0x80000000U){ powered=true; highCap=(r[0]&0x40000000U)!=0; break; }
+  IOSleep(10);
+ }
+ if(!powered) return kIOReturnTimeout;
+ rc=command(2,0,2,r); if(rc!=kIOReturnSuccess) return rc;
+ rc=command(3,0,1,r); if(rc!=kIOReturnSuccess) return rc;
+ rca=r[0]&0xffff0000U;
+ rc=command(9,rca,2,r); if(rc!=kIOReturnSuccess) return rc;
+ /* CSD capacity (v2: C_SIZE in bits 69:48, v1: C_SIZE/MULT/READ_BL_LEN). Response words are MSB-first R2. */
+ if(((r[0]>>30)&3U)==1U){
+  UInt64 csize=((UInt64)(r[1]&0x3fU)<<16)|(r[2]>>16);
+  sectors=(csize+1)*1024ULL;
+ }else{
+  UInt32 readBl=(r[1]>>16)&15U, csize=((r[1]&0x3ffU)<<2)|(r[2]>>30), mult=(r[2]>>15)&7U;
+  sectors=((UInt64)(csize+1)<<(mult+2))<<readBl>>9;
+ }
+ rc=command(7,rca,1,r); if(rc!=kIOReturnSuccess) return rc;
+ if(!highCap){ rc=command(16,512,1,r); if(rc!=kIOReturnSuccess) return rc; }
+ return ready();
+}
+IOReturn IOS7S4SDCC::sector(UInt64 block,UInt8 *bytes,bool writing)
+{
+ UInt32 r[4]; UInt32 arg=highCap?(UInt32)block:(UInt32)(block*512ULL);
+ wr(R_DCTL,0); wr(R_CLEAR,0x7ff); wr(R_DTIMER,0xffffffffU); wr(R_DLEN,512);
+ /* MSM block-size field takes bytes (512<<4), not log2; reads also set RX_DATA_PEND (bit 20). */
+ wr(R_DCTL,1U|(writing?0U:(2U|(1U<<20)))|(512U<<4));
+ IOReturn rc=command(writing?24:17,arg,1,r);
+ if(rc==kIOReturnSuccess && (r[0]&r1Errors)) rc=kIOReturnIOError;
+ unsigned words=0;
+ for(unsigned n=0;rc==kIOReturnSuccess && n<pollLimit;++n){
+  UInt32 st=rd(R_STATUS);
+  if(st&dataErrors){
+   static unsigned derr; if(derr++<4) IOLog("S4SD: data err st=%08x words=%u cnt=%08x\n",(unsigned)st,words,(unsigned)rd(R_DCNT));
+   rc=(st&(1U<<3))?kIOReturnTimeout:kIOReturnIOError; break;
+  }
+  if(words<128 && (writing?!(st&(1U<<16)):(st&(1U<<21)))){
+   unsigned p=words*4;
+   if(writing) wr(R_FIFO,(UInt32)bytes[p]|((UInt32)bytes[p+1]<<8)|((UInt32)bytes[p+2]<<16)|((UInt32)bytes[p+3]<<24));
+   else { UInt32 w=rd(R_FIFO); for(unsigned b=0;b<4;++b) bytes[p+b]=(UInt8)(w>>(b*8)); }
+   ++words;
+  }
+  if(words==128 && (st&(1U<<8))) break;
+  if(n==pollLimit-1) rc=kIOReturnTimeout;
+ }
+ wr(R_DCTL,0);
+ if(rc==kIOReturnSuccess && words!=128) rc=kIOReturnUnderrun;
+ if(rc==kIOReturnSuccess && writing) rc=ready();
+ return rc;
+}
+IOReturn IOS7S4SDCC::readBlocks(UInt64 block,UInt32 count,UInt8 *bytes)
+{
+ UInt32 r[4]; UInt32 arg=highCap?(UInt32)block:(UInt32)(block*512ULL);
+ const unsigned total=count*128U; /* 32-bit words */
+ wr(R_DCTL,0); wr(R_CLEAR,0x7ff); wr(R_DTIMER,0xffffffffU); wr(R_DLEN,count*512U);
+ wr(R_DCTL,1U|2U|(1U<<20)|(512U<<4));
+ IOReturn rc=command(18,arg,1,r);
+ if(rc==kIOReturnSuccess && (r[0]&r1Errors)) rc=kIOReturnIOError;
+ unsigned words=0; UInt32 *out=(UInt32 *)bytes; /* destination is a plain malloc buffer: 4-byte aligned, little endian */
+ UInt32 st=0;
+ for(unsigned n=0;rc==kIOReturnSuccess && n<pollLimit*count;++n){
+  st=rd(R_STATUS);
+  if(st&dataErrors){
+   static unsigned derr; if(derr++<4) IOLog("S4SD: multi data err st=%08x words=%u/%u cnt=%08x\n",(unsigned)st,words,total,(unsigned)rd(R_DCNT));
+   rc=(st&(1U<<3))?kIOReturnTimeout:kIOReturnIOError; break;
+  }
+  if(words<total){
+   if(st&(1U<<15)){ /* RX FIFO half full: burst 8 words */
+    for(unsigned k=0;k<8 && words<total;++k) out[words++]=rd(R_FIFO);
+    continue;
+   }
+   if(st&(1U<<21)){ out[words++]=rd(R_FIFO); continue; }
+  }
+  if(words==total && (st&(1U<<8))) break;
+  if(n==pollLimit*count-1) rc=kIOReturnTimeout;
+ }
+ wr(R_DCTL,0);
+ /* stop the open-ended transmission (CMD12, R1b, with the abort bit) */
+ IOReturn rs=command(12,0,1,r);
+ if(rc==kIOReturnSuccess && rs!=kIOReturnSuccess) rc=rs;
+ if(rc==kIOReturnSuccess && words!=total) rc=kIOReturnUnderrun;
+ if(rc==kIOReturnSuccess) rc=ready();
+ return rc;
+}
+void IOS7S4SDCC::snapshot(unsigned slot)
+{
+ /* Raw sectors in the unused tail of the card: header at base, pixels from base+1. Android reads them back with
+  * dd if=/dev/block/mmcblk1 skip=<base> (tools/s4mini/shot.py decodes). 4 slots of 4096 sectors, the last 8 MiB of the card. */
+ if(!initialized || sectors<100000 || slot>3) return;
+ UInt64 w=PE_state.video.v_width,h=PE_state.video.v_height,rb=PE_state.video.v_rowBytes,pa=PE_state.video.v_baseAddr;
+ UInt64 bytes=rb*h;
+ if(!pa||!bytes||bytes>2000000ULL){ IOLog("S4SD: snapshot: no video state (pa=%llx %llux%llu rb=%llu)\n",(unsigned long long)pa,(unsigned long long)w,(unsigned long long)h,(unsigned long long)rb); return; }
+ UInt64 base=sectors-16384ULL+(UInt64)slot*4096ULL;
+ /* PE_state.video.v_baseAddr is the kernel VIRTUAL address of the offscreen buffer (pa=c01c5000 on the first attempt) */
+ const UInt8 *src=(const UInt8 *)(uintptr_t)pa;
+ UInt8 *buf=(UInt8 *)IOMalloc(512);
+ if(!buf) return;
+ UInt64 nsec=(bytes+511)/512;
+ IOReturn rc=kIOReturnSuccess;
+ IOLockLock(mutex);
+ bzero(buf,512);
+ bcopy("S4SHOT01",buf,8);
+ ((UInt32 *)buf)[2]=slot; ((UInt32 *)buf)[3]=(UInt32)w; ((UInt32 *)buf)[4]=(UInt32)h; ((UInt32 *)buf)[5]=(UInt32)rb;
+ ((UInt32 *)buf)[6]=(UInt32)pa; ((UInt32 *)buf)[7]=(UInt32)bytes; ((UInt32 *)buf)[8]=(UInt32)PE_state.video.v_depth;
+ rc=sector(base,buf,true);
+ for(UInt64 i=0;i<nsec && rc==kIOReturnSuccess;++i){
+  UInt64 n=bytes-i*512; if(n>512)n=512;
+  bzero(buf,512);
+  bcopy(src+i*512,buf,(size_t)n);
+  rc=sector(base+1+i,buf,true);
+ }
+ IOLockUnlock(mutex);
+ IOLog("S4SD: snapshot slot %u base=%llu %llux%llu rb=%llu pa=%llx rc=%08x\n",slot,(unsigned long long)base,(unsigned long long)w,(unsigned long long)h,(unsigned long long)rb,(unsigned long long)pa,(unsigned)rc);
+ IOFree(buf,512);
+}
+bool IOS7S4SDCC::start(IOService *provider)
+{
+ s4_dev=this;
+ if(!IOBlockStorageDevice::start(provider)) return false;
+ mutex=IOLockAlloc(); if(!mutex) return false;
+ mmio=IOMemoryDescriptor::withPhysicalAddress(SD_PA,4096,kIODirectionInOut);
+ if(!mmio) return false;
+ map=mmio->map(kIOMapInhibitCache);
+ if(!map||!map->getAddress()){ IOLog("S4SD: map failed\n"); return false; }
+ regs=(volatile UInt8 *)map->getAddress();
+ IOLog("S4SD: probing SDCC3\n");
+ IOLog("S4SD: ver=%08x pwr=%08x clk=%08x st=%08x\n",(unsigned)rd(R_VERSION),(unsigned)rd(R_POWER),(unsigned)rd(R_CLK),(unsigned)rd(R_STATUS));
+ /* GCC SDC3 clock: values read from a running Android (card busy): MD 0x000100fd, NS 0x00fe0b5b, CTL 0x10, 48 MHz. */
+ {
+  IOMemoryDescriptor *gd=IOMemoryDescriptor::withPhysicalAddress(0x00902000U,4096,kIODirectionInOut);
+  IOMemoryMap *gm=gd?gd->map(kIOMapInhibitCache):0;
+  if(gm && gm->getAddress()){
+   volatile UInt32 *g=(volatile UInt32 *)gm->getAddress();
+   IOLog("S4SD: gcc before ctl=%08x md=%08x ns=%08x halt=%08x\n",(unsigned)g[0x860/4],(unsigned)g[0x868/4],(unsigned)g[0x86c/4],(unsigned)g[0xfc8/4]);
+   s4gcc=g;
+   /* MSM SDCC has no MCI divider: the bus rate is the GCC rate. pll8 384 MHz /4 /(n/m): n=240 -> 400 kHz for identification. */
+   g[0x868/4]=0x0001000fU; __asm__ __volatile__("dsb sy":::"memory");
+   g[0x86c/4]=0x00100b5bU; __asm__ __volatile__("dsb sy":::"memory");
+   g[0x860/4]=0x00000010U; __asm__ __volatile__("dsb sy":::"memory");
+   g[0x864/4]=0x0000004fU; __asm__ __volatile__("dsb sy":::"memory"); /* core clk ctl (SDC3_CLK_CTL), Android active value */
+   IOSleep(5);
+   IOLog("S4SD: gcc core=%08x\n",(unsigned)g[0x864/4]);
+   IOLog("S4SD: gcc after ctl=%08x md=%08x ns=%08x halt=%08x\n",(unsigned)g[0x860/4],(unsigned)g[0x868/4],(unsigned)g[0x86c/4],(unsigned)g[0xfc8/4]);
+  }else IOLog("S4SD: gcc map failed\n");
+ }
+ {
+  /* TLMM SDC pad control (Android: 0x802054 = 0x308a30e1) and PLL8 block (Android 0x903140: 0010bf00 0003100e 00000002 00000009 00001000 00c00000) */
+  IOMemoryDescriptor *td=IOMemoryDescriptor::withPhysicalAddress(0x00802000U,4096,kIODirectionInOut);
+  IOMemoryMap *tm=td?td->map(kIOMapInhibitCache):0;
+  if(tm && tm->getAddress()){
+   volatile UInt32 *t=(volatile UInt32 *)tm->getAddress();
+   IOLog("S4SD: tlmm pad=%08x\n",(unsigned)t[0x54/4]);
+   if(t[0x54/4]!=0x308a30e1U){ t[0x54/4]=0x308a30e1U; __asm__ __volatile__("dsb sy":::"memory"); IOLog("S4SD: tlmm pad now=%08x\n",(unsigned)t[0x54/4]); }
+  }
+  IOMemoryDescriptor *pd=IOMemoryDescriptor::withPhysicalAddress(0x00903000U,4096,kIODirectionInOut);
+  IOMemoryMap *pm=pd?pd->map(kIOMapInhibitCache):0;
+  if(pm && pm->getAddress()){
+   volatile UInt32 *p=(volatile UInt32 *)pm->getAddress();
+   IOLog("S4SD: pll8 %08x %08x %08x %08x %08x %08x\n",(unsigned)p[0x140/4],(unsigned)p[0x144/4],(unsigned)p[0x148/4],(unsigned)p[0x14c/4],(unsigned)p[0x150/4],(unsigned)p[0x154/4]);
+  }
+ }
+ {
+  /* Card VDD/VDDIO are RPM-managed PM8917 L6 (sdc_vdd) and L7 (sdc_vdd_io); Android powers them down when idle and nothing
+   * re-enables them after a warm reset. Same protocol as the msm RPM driver: request words in the REQ page, select mask +
+   * context in the CTRL page, IPC doorbell to the RPM, poll the ACK context. L6_0/L6_1/L7_0/L7_1 = words 116..119, selects 43/44. */
+  IOMemoryDescriptor *rd_=IOMemoryDescriptor::withPhysicalAddress(0x00108000U,4096,kIODirectionInOut);
+  IOMemoryDescriptor *id_=IOMemoryDescriptor::withPhysicalAddress(0x02011000U,4096,kIODirectionInOut);
+  IOMemoryMap *rm=rd_?rd_->map(kIOMapInhibitCache):0, *im=id_?id_->map(kIOMapInhibitCache):0;
+  if(rm && rm->getAddress() && im && im->getAddress()){
+   volatile UInt32 *base=(volatile UInt32 *)rm->getAddress();
+   volatile UInt32 *ctrl=base+0x400/4, *req=base+0x600/4, *ack=base+0xa00/4;
+   volatile UInt32 *ipc=(volatile UInt32 *)((UInt8 *)im->getAddress()+0x008);
+   const unsigned REQ_CTX0=3, REQ_SEL0=11, ACK_CTX0=15, ACK_SEL0=23;
+   IOLog("S4SD: rpm ver=%08x %08x ackctx=%08x\n",(unsigned)base[0],(unsigned)base[1],(unsigned)ctrl[ACK_CTX0]);
+   req[116]=2950000U; req[117]=0; req[118]=2950000U; req[119]=0;
+   ctrl[REQ_SEL0+0]=0; ctrl[REQ_SEL0+1]=(1U<<(43-32))|(1U<<(44-32)); ctrl[REQ_SEL0+2]=0;
+   ctrl[REQ_CTX0]=1U;
+   __asm__ __volatile__("dsb sy":::"memory");
+   *ipc=4U; __asm__ __volatile__("dsb sy":::"memory");
+   UInt32 ctx=0; unsigned n;
+   for(n=0;n<200000;++n){ ctx=ctrl[ACK_CTX0]; if(ctx) break; IODelay(10); }
+   IOLog("S4SD: rpm ack ctx=%08x sel=%08x %08x n=%u\n",(unsigned)ctx,(unsigned)ctrl[ACK_SEL0+0],(unsigned)ctrl[ACK_SEL0+1],n);
+   ctrl[ACK_SEL0+0]=0; ctrl[ACK_SEL0+1]=0; ctrl[ACK_SEL0+2]=0; ctrl[ACK_CTX0]=0;
+   __asm__ __volatile__("dsb sy":::"memory");
+   IOSleep(30);
+  }else IOLog("S4SD: rpm map failed\n");
+ }
+ wr(R_MASK0,0); wr(R_MASK1,0);
+ wr(R_POWER,0x03); /* power on */
+ IOSleep(10);
+ wr(R_CLK,0x100U|0x1000U); /* MSM layout: enable (bit 8), flowena (bit 12), widebus 1-bit (bits 11:10); rate from GCC */
+ IOSleep(10);
+ IOLog("S4SD: after pwr=%08x clk=%08x st=%08x\n",(unsigned)rd(R_POWER),(unsigned)rd(R_CLK),(unsigned)rd(R_STATUS));
+ IOReturn rc=cardInit();
+ if(rc!=kIOReturnSuccess){
+  IOLog("S4SD: card init failed rc=0x%x st=%08x\n",(unsigned)rc,(unsigned)rd(R_STATUS));
+  UInt32 r[4]={0,0,0,0};
+  rc=command(13,0x00070000U,1,r); IOLog("S4SD: sdc3 cmd13 rca7 rc=%08x r0=%08x\n",(unsigned)rc,(unsigned)r[0]);
+  /* same driver against the eMMC controller aboot already set up */
+  IOMemoryDescriptor *ed=IOMemoryDescriptor::withPhysicalAddress(0x12400000U,4096,kIODirectionInOut);
+  IOMemoryMap *em=ed?ed->map(kIOMapInhibitCache):0;
+  if(em && em->getAddress()){
+   volatile UInt8 *keep=regs; regs=(volatile UInt8 *)em->getAddress();
+   IOLog("S4SD: sdc1 ver=%08x pwr=%08x clk=%08x st=%08x\n",(unsigned)rd(R_VERSION),(unsigned)rd(R_POWER),(unsigned)rd(R_CLK),(unsigned)rd(R_STATUS));
+   rc=command(13,0x00010000U,1,r); IOLog("S4SD: sdc1 cmd13 rca1 rc=%08x r0=%08x\n",(unsigned)rc,(unsigned)r[0]);
+   rc=command(13,0x00020000U,1,r); IOLog("S4SD: sdc1 cmd13 rca2 rc=%08x r0=%08x\n",(unsigned)rc,(unsigned)r[0]);
+   regs=keep;
+  }
+  return false;
+ }
+ initialized=true;
+ if(s4gcc){
+  /* Data phase: find a clock/sampling setup that reads a valid MBR. Rate = 96 MHz / n (pll8 384 /4 /n), optionally with
+   * the clock inverted (Android runs with INVERTOUT set). */
+  static const unsigned ns_[]={4,4,8,8,16,16,32,32};
+  UInt8 mbr[512]; bool tuned=false;
+  for(unsigned t=0;t<8 && !tuned;++t){
+   unsigned n=ns_[t]; UInt32 fl=(t&1)?0x2000U:0; /* INVERTOUT is bit 13 */
+   s4gcc[0x868/4]=0x00010000U|((~n)&0xffU); __asm__ __volatile__("dsb sy":::"memory");
+   s4gcc[0x86c/4]=((((~(n-1))&0xffU))<<16)|0x0b5bU; __asm__ __volatile__("dsb sy":::"memory");
+   wr(R_CLK,0x100U|0x1000U|fl);
+   IOSleep(2);
+   IOReturn r2=sector(0,mbr,false);
+   IOLog("S4SD: tune n=%u inv=%u rc=%08x sig=%02x%02x\n",n,(unsigned)(fl!=0),(unsigned)r2,mbr[510],mbr[511]);
+   if(r2==kIOReturnSuccess && mbr[510]==0x55 && mbr[511]==0xaa) tuned=true;
+  }
+  if(!tuned) IOLog("S4SD: tune failed\n");
+  else{
+   /* 4-bit bus: ACMD6 arg 2, then controller WIDEBUS=2; verify with an MBR read, else go back to 1-bit */
+   UInt32 r6[4]; IOReturn w=command(55,rca,1,r6);
+   if(w==kIOReturnSuccess) w=command(6,2,1,r6);
+   if(w==kIOReturnSuccess){
+    UInt32 clk=rd(R_CLK); wr(R_CLK,clk|0x800U); IOSleep(1);
+    mbr[510]=mbr[511]=0;
+    w=sector(0,mbr,false);
+    if(w==kIOReturnSuccess && mbr[510]==0x55 && mbr[511]==0xaa){ wide4=true; s4_wide4=true; }
+    else{
+     wr(R_CLK,clk); IOLog("S4SD: 4-bit read failed rc=%08x, card left in 4-bit; retrying 1-bit via ACMD6 0\n",(unsigned)w);
+     if(command(55,rca,1,r6)==kIOReturnSuccess) command(6,0,1,r6);
+    }
+   }
+   IOLog("S4SD: bus width %d-bit\n",wide4?4:1);
+  }
+ }
+ IOLog("S4SD: card ok sectors=%llu hc=%d rca=%08x\n",(unsigned long long)sectors,(int)highCap,(unsigned)rca);
+ OSObject *dec=OSUnserializeXML(ios7labStoragePersonalities);
+ OSArray *drv=OSDynamicCast(OSArray,dec);
+ if(!drv||!gIOCatalogue->addDrivers(drv,false)){ if(dec)dec->release(); return false; }
+ dec->release();
+ return true;
+}
+void IOS7S4SDCC::free()
+{
+ if(mutex)IOLockFree(mutex);
+ if(map)map->release();
+ if(mmio)mmio->release();
+ IOBlockStorageDevice::free();
+}
+char *IOS7S4SDCC::getVendorString(){static char t[]="Qualcomm";return t;}
+char *IOS7S4SDCC::getProductString(){static char t[]="SDCC3 microSD";return t;}
+char *IOS7S4SDCC::getRevisionString(){static char t[]="PIO1";return t;}
+char *IOS7S4SDCC::getAdditionalDeviceInfoString(){static char t[]="MSM8930";return t;}
+IOReturn IOS7S4SDCC::reportBlockSize(UInt64 *v){if(!v)return kIOReturnBadArgument;*v=512;return kIOReturnSuccess;}
+IOReturn IOS7S4SDCC::reportMaxValidBlock(UInt64 *v){if(!v||!initialized)return kIOReturnNotReady;*v=sectors-1;return kIOReturnSuccess;}
+IOReturn IOS7S4SDCC::reportEjectability(bool *v){if(!v)return kIOReturnBadArgument;*v=false;return kIOReturnSuccess;}
+IOReturn IOS7S4SDCC::reportLockability(bool *v){if(!v)return kIOReturnBadArgument;*v=false;return kIOReturnSuccess;}
+IOReturn IOS7S4SDCC::reportRemovability(bool *v){if(!v)return kIOReturnBadArgument;*v=false;return kIOReturnSuccess;}
+IOReturn IOS7S4SDCC::reportMediaState(bool *p,bool *c){if(!p||!c)return kIOReturnBadArgument;*p=initialized;*c=false;return kIOReturnSuccess;}
+IOReturn IOS7S4SDCC::reportPollRequirements(bool *r,bool *e){if(!r||!e)return kIOReturnBadArgument;*r=false;*e=false;return kIOReturnSuccess;}
+IOReturn IOS7S4SDCC::reportWriteProtection(bool *v){if(!v)return kIOReturnBadArgument;*v=false;return kIOReturnSuccess;}
+IOReturn IOS7S4SDCC::doAsyncReadWrite(IOMemoryDescriptor *buffer,UInt64 block,UInt64 count,
+ IOStorageAttributes *attributes,IOStorageCompletion *completion)
+{
+ if(!buffer||!completion||!completion->action||!initialized||count==0||block>=sectors||block+count>sectors||
+    count*512U!=buffer->getLength()) return kIOReturnBadArgument;
+ bool writing=(buffer->getDirection()==kIODirectionOut);
+ IOStorageCompletion saved=*completion;
+ UInt64 done=0; IOReturn result=kIOReturnSuccess;
+ unsigned bytes=(unsigned)(count*512U);
+ static unsigned callN; unsigned myCall=++callN;
+#define MARK(s) do{ }while(0) /* step markers were for the interrupts-masked bisect; see git history / notes */
+ MARK("enter");
+ AbsoluteTime t0; UInt64 t0ns=0,t1ns=0,t2ns=0; clock_get_uptime(&t0); absolutetime_to_nanoseconds(t0,&t0ns);
+ UInt8 *tmp=(UInt8 *)IOMalloc(bytes);
+ if(!tmp) return kIOReturnNoMemory;
+ if(writing && buffer->readBytes(0,tmp,bytes)!=bytes){ IOFree(tmp,bytes); return kIOReturnUnderrun; }
+ IOLockLock(mutex);
+ if(faulted) result=kIOReturnNotReady;
+ UInt64 i=0;
+ if(!writing && count>=2 && s4_multiOk && result==kIOReturnSuccess){
+  /* chunks of up to 128 sectors via CMD18; any failure disables multi-block and falls back to single-sector reads */
+  while(i<count){
+   UInt32 n=(UInt32)((count-i)>128?128:(count-i));
+   IOReturn mr=readBlocks(block+i,n,tmp+i*512U);
+   if(mr!=kIOReturnSuccess){ IOLog("S4SD: multi-block read failed rc=%08x blk=%llu n=%u, disabling\n",(unsigned)mr,(unsigned long long)(block+i),(unsigned)n); s4_multiOk=false; s4io_mfail++; break; }
+   i+=n; done+=n*512ULL; s4io_mreqs++;
+  }
+ }
+ for(;i<count && result==kIOReturnSuccess;++i){
+  result=sector(block+i,tmp+i*512U,writing);
+  if(result==kIOReturnSuccess) done+=512; else faulted=true;
+ }
+ IOLockUnlock(mutex);
+ {
+  AbsoluteTime t1; clock_get_uptime(&t1); absolutetime_to_nanoseconds(t1,&t1ns);
+  s4io_reqs++; s4io_sectors+=count; s4io_hw_ns+=(t1ns-t0ns);
+ }
+ {
+  static unsigned nrw; static UInt64 total;
+  total+=done;
+  if(nrw<3 || (nrw&0x3ff)==0) IOLog("S4SD: io#%u %s blk=%llu n=%llu rc=%08x total=%lluK\n",nrw,writing?"wr":"rd",(unsigned long long)block,(unsigned long long)count,(unsigned)result,(unsigned long long)(total>>10));
+  nrw++;
+ }
+ MARK("logged");
+#ifdef S4SD_ZERO_MBR
+ /* bisect experiment: real hardware read, but hide the partition table from the kernel */
+ if(!writing && block==0 && result==kIOReturnSuccess){ bzero(tmp,bytes); MARK("zeroed"); }
+#endif
+ if(!writing && result==kIOReturnSuccess && buffer->writeBytes(0,tmp,bytes)!=bytes) result=kIOReturnUnderrun;
+ MARK("copied");
+ IOFree(tmp,bytes);
+ MARK("freed");
+ { AbsoluteTime t2; clock_get_uptime(&t2); absolutetime_to_nanoseconds(t2,&t2ns); s4io_tot_ns+=(t2ns-t0ns); }
+ IOStorage::complete(&saved,result,result==kIOReturnSuccess?done:0);
+ MARK("completed");
+ return kIOReturnSuccess;
+}
+
+extern "C" void s4_dump_threads(void);
+extern "C" boolean_t ml_set_interrupts_enabled(boolean_t);
+/* Unattended test cycles: leave XNU and boot Android again. Same sequence as Samsung's msm restart.c: restart_reason 0x12345678
+ * ("normal"), download-mode magic cleared, then PS_HOLD low (TLMM + 0x820); fall back to a watchdog bite like the Linux code. */
+static void s4sdRebootToAndroid(volatile UInt32 *wdt)
+{
+ IOLog("S4SD: reboot-to-android requested\n");
+ IOMemoryDescriptor *id=IOMemoryDescriptor::withPhysicalAddress(0x2a03f000U,4096,kIODirectionInOut);
+ IOMemoryMap *im=id?id->map(kIOMapInhibitCache):0;
+ if(im && im->getAddress()){
+  volatile UInt32 *imem=(volatile UInt32 *)im->getAddress();
+  imem[0]=0; imem[1]=0; imem[0x65c/4]=0x12345678U;
+  __asm__ __volatile__("dsb sy":::"memory");
+ }
+ IOMemoryDescriptor *td=IOMemoryDescriptor::withPhysicalAddress(0x00800000U,4096,kIODirectionInOut);
+ IOMemoryMap *tm=td?td->map(kIOMapInhibitCache):0;
+ if(wdt){
+  wdt[0x40/4]=0; wdt[0x38/4]=1; wdt[0x4c/4]=5U*0x31f3U; wdt[0x5c/4]=0x31f3U; wdt[0x40/4]=1;
+  __asm__ __volatile__("dsb sy":::"memory");
+  IOLog("S4SD: watchdog armed for a bite\n");
+  IOSleep(3000);
+ }
+ if(tm && tm->getAddress()){
+  IOLog("S4SD: PS_HOLD low\n");
+  ((volatile UInt32 *)tm->getAddress())[0x820/4]=0;
+  __asm__ __volatile__("dsb sy":::"memory");
+  IOSleep(6000);
+ }
+ IOLog("S4SD: reboot-to-android failed\n");
+}
+static inline unsigned s4cpsr(void){ unsigned c; __asm__ __volatile__("mrs %0, cpsr":"=r"(c)); return c; }
+static void s4sdHeartbeat(void *)
+{
+ unsigned c0=s4cpsr(); /* first instruction of the thread: before any printing or locking */
+ IOLog("S4SD: hb start cpsr_entry=%08x after_log=%08x\n",c0,s4cpsr());
+ if(s4cpsr()&0x80U){ ml_set_interrupts_enabled(TRUE); IOLog("S4SD: hb irq was masked, enabled -> cpsr=%08x\n",s4cpsr()); }
+ IOMemoryDescriptor *wd=IOMemoryDescriptor::withPhysicalAddress(0x0208a000U,4096,kIODirectionInOut);
+ IOMemoryMap *wm=wd?wd->map(kIOMapInhibitCache):0;
+ volatile UInt32 *wdt=(wm&&wm->getAddress())?(volatile UInt32 *)wm->getAddress():0;
+ for(unsigned n=0;n<300;++n){ /* 25 minutes nominal, then back to Android */
+  unsigned cb=s4cpsr();
+  IOSleep(5000);
+  AbsoluteTime at; UInt64 ns=0; clock_get_uptime(&at); absolutetime_to_nanoseconds(at,&ns);
+  if(n%6==0){ /* every 30 s: the 256 KB console ring is precious */
+   IOLog("S4SD: hb %u t=%llums wide4=%d multi=%d mreqs=%llu mfail=%llu io reqs=%llu sectors=%llu\n",n,(unsigned long long)(ns/1000000ULL),
+         (int)s4_wide4,(int)s4_multiOk,(unsigned long long)s4io_mreqs,(unsigned long long)s4io_mfail,
+         (unsigned long long)s4io_reqs,(unsigned long long)s4io_sectors);
+  }
+  if(wdt){ wdt[0x38/4]=1; __asm__ __volatile__("dsb sy":::"memory"); } /* keepalive for the stub's watchdog while this thread runs */
+  if(n==18||n==30||n==60) s4_dump_threads();
+  if(s4_dev && (n==36||n==100||n==200||n==280)) s4_dev->snapshot(n==36?0:n==100?1:n==200?2:3);
+ }
+ s4sdRebootToAndroid(wdt);
+}
+void ios7s4_register_sd(IOService *platform)
+{
+ IOCreateThread(s4sdHeartbeat,0);
+ IOS7S4SDCC *dev=new IOS7S4SDCC;
+ if(!dev){ IOLog("S4SD: allocation failed\n"); return; }
+ bool attached=false,ok=false;
+ if(dev->init()) attached=dev->attach(platform);
+ if(attached&&dev->start(platform)){ dev->registerService(); ok=true; }
+ if(!ok) IOLog("S4SD: init/attach/start failed\n");
+ if(attached&&!ok) dev->detach(platform);
+ dev->release();
+}
+#endif
diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7S5RPM.cpp b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7S5RPM.cpp
new file mode 100644
index 0000000..db188a5
--- /dev/null
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7S5RPM.cpp
@@ -0,0 +1,276 @@
+#if defined(J1_S5)
+/*
+ * Galaxy S5 (MSM8974): minimal RPM client over SMD, enough to switch an RPM-owned regulator on. Polled, no interrupts.
+ *
+ * Why: LK leaves PMA8084 LVS2 (the touch controller's 1.8 V I/O supply, "8084_lvs2") off, and LVS switches belong to the
+ * RPM processor, so the apps CPU has to ask the RPM firmware (S5 run 71: touch SDA/SCL held low after LDO13 was on).
+ *
+ * From the stock device tree (ref/s5-backup/boot.img QCDT): SMEM at 0x0fa00000 (2 MiB); the RPM SMD edge is 15 and its
+ * doorbell is APCS 0xf9011000 + 8, bit 0; the request channel is "rpm_requests"; LVS2 is resource "vsa" id 2.
+ *
+ * SMEM (legacy layout): proc_comm[4] (64 B), version[32] (128 B), heap_info (16 B), then the table of contents at 0xd0,
+ * 16 B per item {allocated, offset, size, base_ext}. Items: 13 = SMD channel allocation table (64 x {name[20], cid,
+ * type, ref_count}; type & 0xff = edge, (type >> 8) & 0xf = 1 for packet channels), 14 + cid = channel info (two
+ * 20-byte halves: ours (send) then the RPM's (recv): {state, fDSR, fCTS, fCD, fRI, fHEAD, fTAIL, fSTATE,
+ * fBLOCKREADINTR, tail, head}), 338 + cid = FIFOs (send = first half, recv = second half).
+ * SMD states: 0 closed, 1 opening, 2 opened. A packet is a 20-byte header {length, 0, 0, 0, 0} and the payload.
+ *
+ * RPM request (rpm-smd v0): {service 'req', length} {msg_id, set (0 active), resource type, resource id, data length}
+ * then key/value pairs {key, length, value}. Enable = key 'swen' value 1.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+
+#define SMEM_PA 0x0fa00000U
+#define SMEM_SIZE 0x200000U
+#define APCS_PA 0xf9011000U
+#define IPC_RPM_OFF 0x8U
+#define IPC_RPM_BIT 0x1U
+#define EDGE_APPS_RPM 0x0fU
+
+#define SMEM_TOC 0xd0U
+#define ITEM_ALLOC_TBL 13U
+#define ITEM_CH_INFO 14U
+#define ITEM_FIFO 338U
+
+extern "C" void machine_delay_until(uint64_t interval, uint64_t deadline);
+extern "C" uint64_t mach_absolute_time(void);
+static void rpmSpinUs(unsigned us)
+{
+    uint64_t abs = (uint64_t)us * 20U;
+    machine_delay_until(abs, mach_absolute_time() + abs);
+}
+
+static volatile UInt8 *smem, *auxmem;
+static volatile UInt32 *apcs;
+
+/* The RPM edge keeps its channel info and FIFOs in RPM message RAM (SMEM TOC base_ext = 0xfc428000, the DT's
+ * "aux-mem1", run 73), which only takes 32-bit accesses: there every field of a channel half is a word
+ * (44-byte halves, 88-byte info item). In main SMEM the classic 20-byte halves have byte flags. */
+#define AUX_PA 0xfc428000U
+#define AUX_SIZE 0x4000U
+enum { H_STATE, H_FDSR, H_FCTS, H_FCD, H_FRI, H_FHEAD, H_FTAIL, H_FSTATE, H_FBLOCK, H_TAIL, H_HEAD };
+static const UInt8 half_byte_off[11] = {0, 4, 5, 6, 7, 8, 9, 10, 11, 12, 16};
+static int half_words; /* 1: word layout (44-byte halves) */
+static UInt32 half_size = 20;
+
+static inline UInt32 rd32(volatile UInt8 *p) { return *(volatile UInt32 *)p; }
+static inline void wr32(volatile UInt8 *p, UInt32 v) { *(volatile UInt32 *)p = v; }
+static UInt32 frd(volatile UInt8 *h, int f)
+{
+    if (half_words || f == H_STATE || f == H_TAIL || f == H_HEAD)
+        return rd32(h + (half_words ? 4 * f : half_byte_off[f]));
+    return h[half_byte_off[f]];
+}
+static void fwr(volatile UInt8 *h, int f, UInt32 v)
+{
+    if (half_words || f == H_STATE || f == H_TAIL || f == H_HEAD)
+        wr32(h + (half_words ? 4 * f : half_byte_off[f]), v);
+    else
+        h[half_byte_off[f]] = (UInt8)v;
+}
+
+static void kick(void)
+{
+    __asm__ volatile("dsb" ::: "memory");
+    apcs[IPC_RPM_OFF / 4] = IPC_RPM_BIT;
+    __asm__ volatile("dsb" ::: "memory");
+}
+
+/* Returns the item's address, or 0. */
+static volatile UInt8 *smem_item(UInt32 item, UInt32 *size)
+{
+    volatile UInt8 *e = smem + SMEM_TOC + 16U * item;
+    UInt32 alloc = rd32(e), off = rd32(e + 4), sz = rd32(e + 8), ext = rd32(e + 12);
+    if (alloc && ext == AUX_PA && auxmem && off + sz <= AUX_SIZE) {
+        if (size)
+            *size = sz;
+        return auxmem + off;
+    }
+    if (!alloc || ext != 0 || off + sz > SMEM_SIZE) {
+        IOLog("S5RPM: item %u alloc=%u off=%08x size=%08x ext=%08x unusable\n", (unsigned)item, (unsigned)alloc,
+              (unsigned)off, (unsigned)sz, (unsigned)ext);
+        return 0;
+    }
+    if (size)
+        *size = sz;
+    return smem + off;
+}
+
+static void set_state(volatile UInt8 *send, UInt32 st)
+{
+    UInt32 f = st == 2 ? 1 : 0;
+    fwr(send, H_FDSR, f);
+    fwr(send, H_FCTS, f);
+    fwr(send, H_FCD, f);
+    fwr(send, H_STATE, st);
+    fwr(send, H_FSTATE, 1);
+    kick();
+}
+
+/* Copy n bytes (multiple of 4) into the ring at *pos, wrapping. */
+static void fifo_put(volatile UInt8 *fifo, UInt32 size, UInt32 *pos, const UInt32 *w, UInt32 nwords)
+{
+    for (UInt32 i = 0; i < nwords; i++) {
+        *(volatile UInt32 *)(fifo + *pos) = w[i];
+        *pos = (*pos + 4) % size;
+    }
+}
+
+static int rpm_ready, rpm_cid = -1;
+static volatile UInt8 *ch_send, *ch_recv, *fifo_send, *fifo_recv;
+static UInt32 fifo_size;
+
+static int rpm_open(void)
+{
+    IOMemoryDescriptor *sd, *ad;
+    IOMemoryMap *sm, *am;
+    volatile UInt8 *tbl;
+    UInt32 tsz = 0, isz = 0, fsz = 0;
+
+    if (rpm_ready)
+        return 1;
+    sd = IOMemoryDescriptor::withPhysicalAddress(SMEM_PA, SMEM_SIZE, kIODirectionInOut);
+    ad = IOMemoryDescriptor::withPhysicalAddress(APCS_PA, 0x1000, kIODirectionInOut);
+    sm = sd ? sd->map(kIOMapInhibitCache) : 0;
+    am = ad ? ad->map(kIOMapInhibitCache) : 0;
+    if (!sm || !am || !sm->getAddress() || !am->getAddress()) {
+        IOLog("S5RPM: map failed\n");
+        return 0;
+    }
+    smem = (volatile UInt8 *)sm->getAddress();
+    apcs = (volatile UInt32 *)am->getAddress();
+    {
+        IOMemoryDescriptor *xd = IOMemoryDescriptor::withPhysicalAddress(AUX_PA, AUX_SIZE, kIODirectionInOut);
+        IOMemoryMap *xm = xd ? xd->map(kIOMapInhibitCache) : 0;
+        auxmem = (xm && xm->getAddress()) ? (volatile UInt8 *)xm->getAddress() : 0;
+    }
+    IOLog("S5RPM: smem heap init=%u free=%08x remaining=%08x version[8]=%08x\n", (unsigned)rd32(smem + 0xc0),
+          (unsigned)rd32(smem + 0xc4), (unsigned)rd32(smem + 0xc8), (unsigned)rd32(smem + 0x40 + 8 * 4));
+
+    tbl = smem_item(ITEM_ALLOC_TBL, &tsz);
+    if (!tbl)
+        return 0;
+    for (UInt32 i = 0; i < 64 && (i + 1) * 32 <= tsz; i++) {
+        volatile UInt8 *e = tbl + 32 * i;
+        char name[21];
+        UInt32 type = rd32(e + 24);
+        for (int k = 0; k < 20; k++)
+            name[k] = (char)e[k];
+        name[20] = 0;
+        if (!name[0])
+            continue;
+        if ((type & 0xff) == EDGE_APPS_RPM)
+            IOLog("S5RPM: channel '%s' cid %u type %08x ref %u\n", name, (unsigned)rd32(e + 20), (unsigned)type,
+                  (unsigned)rd32(e + 28));
+        if ((type & 0xff) == EDGE_APPS_RPM && !strncmp(name, "rpm_requests", 20))
+            rpm_cid = (int)rd32(e + 20);
+    }
+    if (rpm_cid < 0) {
+        IOLog("S5RPM: rpm_requests channel not in the allocation table\n");
+        return 0;
+    }
+    ch_send = smem_item(ITEM_CH_INFO + (UInt32)rpm_cid, &isz);
+    fifo_send = smem_item(ITEM_FIFO + (UInt32)rpm_cid, &fsz);
+    if (!ch_send || !fifo_send || isz < 40 || fsz < 64) {
+        IOLog("S5RPM: channel info %u bytes, fifo %u bytes: not usable\n", (unsigned)isz, (unsigned)fsz);
+        return 0;
+    }
+    half_words = isz >= 88;
+    half_size = half_words ? 44 : 20;
+    ch_recv = ch_send + half_size;
+    fifo_size = fsz / 2;
+    fifo_recv = fifo_send + fifo_size;
+    IOLog("S5RPM: cid %d info %u B, fifo 2 x %u B; ours state=%u head=%u tail=%u; rpm state=%u head=%u tail=%u\n",
+          rpm_cid, (unsigned)isz, (unsigned)fifo_size, (unsigned)frd(ch_send, H_STATE),
+          (unsigned)frd(ch_send, H_HEAD), (unsigned)frd(ch_send, H_TAIL), (unsigned)frd(ch_recv, H_STATE),
+          (unsigned)frd(ch_recv, H_HEAD), (unsigned)frd(ch_recv, H_TAIL));
+
+    if (frd(ch_send, H_STATE) != 2 || frd(ch_recv, H_STATE) != 2) {
+        /* Open handshake: we go OPENING, the RPM answers OPENING/OPENED, then we go OPENED. Rings start empty. */
+        fwr(ch_send, H_HEAD, 0);
+        fwr(ch_recv, H_TAIL, 0);
+        set_state(ch_send, 1);
+        for (int t = 0; t < 1000; t++) {
+            UInt32 rs = frd(ch_recv, H_STATE);
+            if (rs == 1 || rs == 2)
+                break;
+            IOSleep(1);
+        }
+        IOLog("S5RPM: after OPENING: rpm state=%u\n", (unsigned)frd(ch_recv, H_STATE));
+        set_state(ch_send, 2);
+        for (int t = 0; t < 1000 && frd(ch_recv, H_STATE) != 2; t++)
+            IOSleep(1);
+        IOLog("S5RPM: after OPENED: ours=%u rpm=%u\n", (unsigned)frd(ch_send, H_STATE),
+              (unsigned)frd(ch_recv, H_STATE));
+        if (frd(ch_recv, H_STATE) != 2)
+            return 0;
+    }
+    rpm_ready = 1;
+    return 1;
+}
+
+/* Log and consume whatever the RPM sent back (acks). */
+static void rpm_drain(void)
+{
+    UInt32 head = frd(ch_recv, H_HEAD), tail = frd(ch_recv, H_TAIL), n = 0;
+    char line[9 * 10 + 1];
+    int k = 0;
+    while (tail != head && n < 10 && !(tail & 3)) { /* message RAM: 32-bit reads only */
+        UInt32 w = rd32(fifo_recv + tail);
+        for (int sh = 28; sh >= 0; sh -= 4)
+            line[k++] = "0123456789abcdef"[(w >> sh) & 15];
+        line[k++] = ' ';
+        tail = (tail + 4) % fifo_size;
+        n++;
+    }
+    line[k] = 0;
+    if (n)
+        IOLog("S5RPM: ack %s\n", line);
+    fwr(ch_recv, H_TAIL, head); /* drop the rest too */
+    fwr(ch_recv, H_FTAIL, 1);
+    kick();
+}
+
+/* Switch an RPM regulator resource on: type is the 4-character resource name ("vsa\0" -> 0x00617376). */
+extern "C" int ios7s5_rpm_enable(UInt32 type, UInt32 id)
+{
+    static UInt32 msg_id = 0x4a310000;
+    UInt32 pkt[15], head, tail, used;
+    if (!rpm_open())
+        return 0;
+    rpm_drain();
+    pkt[0] = 40;           /* SMD packet header: payload length */
+    pkt[1] = pkt[2] = pkt[3] = pkt[4] = 0;
+    pkt[5] = 0x00716572;   /* 'req' */
+    pkt[6] = 32;           /* message header (20) + data (12) */
+    pkt[7] = ++msg_id;
+    pkt[8] = 0;            /* active set */
+    pkt[9] = type;
+    pkt[10] = id;
+    pkt[11] = 12;
+    pkt[12] = 0x6e657773;  /* 'swen' */
+    pkt[13] = 4;
+    pkt[14] = 1;
+    head = frd(ch_send, H_HEAD);
+    tail = frd(ch_send, H_TAIL);
+    used = (head + fifo_size - tail) % fifo_size;
+    if (fifo_size - used <= sizeof(pkt) || (head & 3)) {
+        IOLog("S5RPM: send fifo busy head=%u tail=%u\n", (unsigned)head, (unsigned)tail);
+        return 0;
+    }
+    fifo_put(fifo_send, fifo_size, &head, pkt, 15);
+    __asm__ volatile("dsb" ::: "memory");
+    fwr(ch_send, H_HEAD, head);
+    fwr(ch_send, H_FHEAD, 1);
+    kick();
+    for (int t = 0; t < 200 && frd(ch_recv, H_HEAD) == frd(ch_recv, H_TAIL); t++)
+        IOSleep(1);
+    IOLog("S5RPM: sent %08x id %u swen=1 (msg %08x): send head=%u tail=%u, recv head=%u tail=%u\n", (unsigned)type,
+          (unsigned)id, (unsigned)msg_id, (unsigned)head, (unsigned)frd(ch_send, H_TAIL),
+          (unsigned)frd(ch_recv, H_HEAD), (unsigned)frd(ch_recv, H_TAIL));
+    rpm_drain();
+    rpmSpinUs(1);
+    return 1;
+}
+#endif
diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7S5SDHCI.cpp b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7S5SDHCI.cpp
new file mode 100644
index 0000000..5052c15
--- /dev/null
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7S5SDHCI.cpp
@@ -0,0 +1,787 @@
+#if defined(J1_S5)
+/*
+ * Galaxy S5 (SM-G900M klte, MSM8974PRO-AC): the internal eMMC (Hynix H16GE2, 16 GB) on SDCC1, driven through its standard
+ * SDHCI register window (0xf9824900), polled PIO, read/write.
+ *
+ * The disk iOS sees is ONE partition of the eMMC, never the whole device: Android's userdata (GPT p26, sectors
+ * 6010880 + 24766431, read from TWRP's /sys/block/mmcblk0/mmcblk0p26). Block 0 of this disk is eMMC sector 6010880 and
+ * every request outside the window is refused, so the bootloaders, EFS, modem, system, boot and TWRP cannot be touched.
+ * userdata carries the same MBR + 0xAF (HFS) layout as the S4 Mini's card, so the FDisk scheme personalities publish
+ * disk0s1 (root) and disk0s2 (var).
+ *
+ * LK (aboot) runs the eMMC through this SDHCI interface (HS200/HS400 tuning strings in aboot) and puts the card to
+ * sleep before booting the kernel (mmc_put_card_to_sleep: CMD7 deselect, CMD5 sleep). The host side (clock, bus width,
+ * timing, tuning) is left as LK set it, so the driver only wakes the card (CMD5 awake + CMD7 select) at LK's RCA, tried
+ * as 2 then 1. When that fails it does a full eMMC identification at a low clock in 1-bit, legacy timing.
+ * No DMA, no interrupts: status bits are polled. All register accesses are 32-bit (16-bit fields are packed).
+ */
+#include <IOKit/storage/IOBlockStorageDevice.h>
+#include <IOKit/storage/IOBlockStorageDriver.h>
+#include <IOKit/storage/IOMedia.h>
+#include <IOKit/IOCatalogue.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <pexpert/pexpert.h>
+#include "IOS7LabStoragePersonalities.h"
+
+#define SDCC1_PA 0xf9824000U        /* page: MCI core at +0, SDHCI at +0x900 */
+#define SDHCI 0x900U
+#define DISK_FIRST 6010880ULL       /* userdata, in eMMC sectors */
+#define DISK_SECTORS 24766431ULL
+
+/* SDHCI registers (offsets from the SDHCI window) */
+#define H_BLK 0x04      /* block size (15:0) | block count (31:16) */
+#define H_ARG 0x08
+#define H_CMD 0x0c      /* transfer mode (15:0) | command (31:16) */
+#define H_RESP 0x10
+#define H_BUF 0x20
+#define H_PRESENT 0x24
+#define H_HOST 0x28     /* host control 1 (7:0), power (15:8) */
+#define H_CLK 0x2c      /* clock control (15:0), timeout (23:16), software reset (31:24) */
+#define H_INT 0x30      /* normal (15:0) | error (31:16) status, write 1 to clear */
+#define H_INTEN 0x34
+#define H_SIGEN 0x38
+#define H_HC2 0x3c      /* auto CMD12 error (15:0) | host control 2 (31:16) */
+#define H_CAPS 0x40
+
+#define I_CMD_DONE (1U << 0)
+#define I_XFER_DONE (1U << 1)
+#define I_WR_READY (1U << 4)
+#define I_RD_READY (1U << 5)
+#define I_ERROR (1U << 15)
+
+/* command flags (upper half of H_CMD) */
+#define C_NONE 0x00U
+#define C_R2 0x09U      /* 136-bit, CRC */
+#define C_R3 0x02U      /* 48-bit, no CRC, no index */
+#define C_R1 0x1aU      /* 48-bit, CRC, index */
+#define C_R1B 0x1bU     /* 48-bit busy, CRC, index */
+#define C_DATA 0x20U
+
+class IOS7S5SDHCI : public IOBlockStorageDevice {
+    OSDeclareDefaultStructors(IOS7S5SDHCI)
+    IOMemoryDescriptor *mmio;
+    IOMemoryMap *map;
+    volatile UInt8 *regs;
+    IOLock *mutex;
+    UInt32 rca;
+    bool initialized, faulted;
+    UInt32 rd(unsigned off) { __asm__ __volatile__("dsb sy" ::: "memory"); return *(volatile UInt32 *)(regs + SDHCI + off); }
+    void wr(unsigned off, UInt32 v) { *(volatile UInt32 *)(regs + SDHCI + off) = v; __asm__ __volatile__("dsb sy" ::: "memory"); }
+    void resetLines(UInt32 mask);
+    IOReturn command(UInt32 index, UInt32 arg, UInt32 flags, UInt32 xfer, UInt32 blocks, UInt32 out[4]);
+    IOReturn waitTran();
+    IOReturn wake();
+    IOReturn identify();
+    UInt32 baseMHz;
+    void setClockDiv(UInt32 div);
+    IOReturn transfer(UInt64 sector, UInt32 count, UInt8 *bytes, bool writing);
+
+public:
+    void dumpLog(unsigned n);
+    void dumpFrame(unsigned n);
+    void sampleBest(void);
+    void dumpBest(unsigned n);
+    void widen();
+    bool probeRead();
+    virtual bool init(OSDictionary *properties = 0);
+    virtual bool start(IOService *provider);
+    virtual void free();
+    virtual IOReturn doAsyncReadWrite(IOMemoryDescriptor *, UInt64, UInt64, IOStorageAttributes *, IOStorageCompletion *);
+    virtual IOReturn doEjectMedia() { return kIOReturnUnsupported; }
+    virtual IOReturn doFormatMedia(UInt64) { return kIOReturnUnsupported; }
+    virtual UInt32 doGetFormatCapacities(UInt64 *, UInt32) const { return 0; }
+    virtual IOReturn doLockUnlockMedia(bool) { return kIOReturnUnsupported; }
+    virtual IOReturn doSynchronizeCache() { return kIOReturnSuccess; }
+    virtual char *getVendorString();
+    virtual char *getProductString();
+    virtual char *getRevisionString();
+    virtual char *getAdditionalDeviceInfoString();
+    virtual IOReturn reportBlockSize(UInt64 *);
+    virtual IOReturn reportMaxValidBlock(UInt64 *);
+    virtual IOReturn reportEjectability(bool *);
+    virtual IOReturn reportLockability(bool *);
+    virtual IOReturn reportRemovability(bool *);
+    virtual IOReturn reportMediaState(bool *, bool *);
+    virtual IOReturn reportPollRequirements(bool *, bool *);
+    virtual IOReturn reportWriteProtection(bool *);
+};
+OSDefineMetaClassAndStructors(IOS7S5SDHCI, IOBlockStorageDevice)
+
+static const UInt32 r1Errors = 0xfdffe008U;
+static const unsigned pollLimit = 200000; /* x 1 us spin: 0.2 s per wait */
+static volatile unsigned s5io_fails, s5io_reqs; static volatile UInt64 s5io_lastfail; /* reported in every S5LOG line */
+extern "C" unsigned int vm_page_free_count, j1_memerr_site, j1_memerr_count;
+extern "C" unsigned int j1_vfp_traps, j1_vfp_else, j1_vfp_dup_notcur;
+/* IODelay always sleeps on this port (ml_delay_should_spin is FALSE): every 1 us poll became a 10 ms tick and a timeout
+ * hours. Spin on the timebase instead. */
+extern "C" void machine_delay_until(uint64_t interval, uint64_t deadline);
+extern "C" uint64_t mach_absolute_time(void);
+static void spinUs(unsigned us)
+{
+    uint64_t abs;
+    abs = (uint64_t)us * 20U; /* ARM generic timer at 19.2 MHz: ~20 ticks per us */
+    machine_delay_until(abs, mach_absolute_time() + abs);
+}
+
+bool IOS7S5SDHCI::init(OSDictionary *p)
+{
+    mmio = 0;
+    map = 0;
+    regs = 0;
+    mutex = 0;
+    rca = 0;
+    initialized = faulted = false;
+    return IOBlockStorageDevice::init(p);
+}
+
+/* software reset of the CMD (bit 1) and/or DAT (bit 2) line state machines after an error */
+void IOS7S5SDHCI::resetLines(UInt32 mask)
+{
+    wr(H_CLK, (rd(H_CLK) & 0x00ffffffU) | (mask << 24));
+    for (unsigned n = 0; n < pollLimit && (rd(H_CLK) & (mask << 24)); ++n)
+        spinUs(1);
+}
+
+IOReturn IOS7S5SDHCI::command(UInt32 index, UInt32 arg, UInt32 flags, UInt32 xfer, UInt32 blocks, UInt32 out[4])
+{
+    UInt32 inhibit = 1U | (((flags & C_DATA) || (flags & 3U) == 3U) ? 2U : 0U);
+    unsigned n;
+    for (n = 0; n < pollLimit && (rd(H_PRESENT) & inhibit); ++n)
+        spinUs(1);
+    if (n == pollLimit) {
+        resetLines(6);
+        return kIOReturnBusy;
+    }
+    wr(H_INT, 0xffffffffU);
+    if (flags & C_DATA)
+        wr(H_BLK, (blocks << 16) | 512U);
+    wr(H_ARG, arg);
+    wr(H_CMD, (((index & 0x3fU) << 8 | flags) << 16) | xfer);
+    for (n = 0; n < pollLimit; ++n) {
+        UInt32 s = rd(H_INT);
+        if (s & I_ERROR) {
+            static unsigned traced;
+            if (traced++ < 24)
+                IOLog("S5MMC: cmd%u arg=%08x err=%04x present=%08x\n", (unsigned)index, (unsigned)arg, (unsigned)(s >> 16),
+                    (unsigned)rd(H_PRESENT));
+            wr(H_INT, 0xffffffffU);
+            resetLines(6);
+            return (s & (1U << 16)) ? kIOReturnTimeout : kIOReturnIOError;
+        }
+        if (s & I_CMD_DONE) {
+            wr(H_INT, I_CMD_DONE);
+            break;
+        }
+        spinUs(1);
+    }
+    if (n == pollLimit) {
+        resetLines(6);
+        return kIOReturnTimeout;
+    }
+    if (out)
+        for (unsigned i = 0; i < 4; ++i)
+            out[i] = rd(H_RESP + 4 * i);
+    if ((flags & 3U) == 3U && !(flags & C_DATA)) {
+        /* R1b: the busy phase ends with transfer complete */
+        for (n = 0; n < pollLimit; ++n) {
+            UInt32 s = rd(H_INT);
+            if (s & (I_XFER_DONE | I_ERROR))
+                break;
+            spinUs(1);
+        }
+        wr(H_INT, I_XFER_DONE);
+    }
+    return kIOReturnSuccess;
+}
+
+IOReturn IOS7S5SDHCI::waitTran()
+{
+    UInt32 r[4];
+    for (unsigned a = 0; a < 200; ++a) {
+        IOReturn rc = command(13, rca, C_R1, 0, 0, r);
+        if (rc != kIOReturnSuccess)
+            return rc;
+        if (r[0] & r1Errors)
+            return kIOReturnIOError;
+        if ((r[0] & (1U << 8)) && ((r[0] >> 9) & 15U) == 4U)
+            return kIOReturnSuccess;
+        IOSleep(1);
+    }
+    return kIOReturnTimeout;
+}
+
+/* LK left the card asleep (or deselected) at its own RCA: wake (CMD5, sleep bit clear), select (CMD7), check TRAN */
+IOReturn IOS7S5SDHCI::wake()
+{
+    static const UInt32 rcas[] = { 2, 1 };
+    UInt32 r[4];
+    for (unsigned i = 0; i < 2; ++i) {
+        rca = rcas[i] << 16;
+        IOReturn rc = command(13, rca, C_R1, 0, 0, r);
+        IOLog("S5MMC: CMD13 rca %u -> %08x status %08x\n", (unsigned)rcas[i], (unsigned)rc, (unsigned)r[0]);
+        if (rc == kIOReturnSuccess && ((r[0] >> 9) & 15U) == 4U)
+            return kIOReturnSuccess;
+        rc = command(5, rca, C_R1B, 0, 0, r);
+        IOLog("S5MMC: CMD5 awake rca %u -> %08x r=%08x\n", (unsigned)rcas[i], (unsigned)rc, (unsigned)r[0]);
+        if (rc != kIOReturnSuccess)
+            continue;
+        IOSleep(2);
+        rc = command(7, rca, C_R1B, 0, 0, r);
+        IOLog("S5MMC: CMD7 select rca %u -> %08x r=%08x\n", (unsigned)rcas[i], (unsigned)rc, (unsigned)r[0]);
+        if (rc == kIOReturnSuccess && waitTran() == kIOReturnSuccess)
+            return kIOReturnSuccess;
+    }
+    return kIOReturnNotReady;
+}
+
+/* SDHCI 3.0 10-bit divider: card clock = base / (2 * div), div 0 = base */
+void IOS7S5SDHCI::setClockDiv(UInt32 div)
+{
+    UInt32 c = rd(H_CLK);
+    c &= ~4U; /* SD clock off */
+    wr(H_CLK, c);
+    c = (c & 0xffff0000U) | ((div & 0xffU) << 8) | (((div >> 8) & 3U) << 6) | 1U;
+    wr(H_CLK, c);
+    for (unsigned n = 0; n < 100000 && !(rd(H_CLK) & 2U); ++n)
+        spinUs(1);
+    wr(H_CLK, rd(H_CLK) | 4U);
+    IOSleep(1);
+}
+
+/* Full eMMC identification: legacy timing, 1-bit, about 400 kHz, then 25 MHz-ish once in TRAN. */
+IOReturn IOS7S5SDHCI::identify()
+{
+    UInt32 r[4];
+    UInt32 base = (rd(H_CAPS) >> 8) & 0xffU; /* MHz, 0 when the platform does not report it */
+    if (!base)
+        base = 200;
+    wr(H_HC2, rd(H_HC2) & 0x0000ffffU);       /* UHS mode select etc. off: legacy timing */
+    wr(H_HOST, rd(H_HOST) & ~((1U << 5) | (1U << 2) | (1U << 1))); /* 1-bit, normal speed */
+    setClockDiv((base * 1000U + 799U) / 800U); /* <= 400 kHz */
+    rca = 1U << 16;
+    command(0, 0, C_NONE, 0, 0, 0);
+    IOSleep(2);
+    bool ready = false;
+    for (unsigned a = 0; a < 200; ++a) {
+        IOReturn rc = command(1, 0x40ff8080U, C_R3, 0, 0, r);
+        if (rc == kIOReturnSuccess && (r[0] & 0x80000000U)) {
+            ready = true;
+            break;
+        }
+        IOSleep(10);
+    }
+    IOLog("S5MMC: CMD1 ready=%d ocr=%08x\n", (int)ready, (unsigned)r[0]);
+    if (!ready)
+        return kIOReturnTimeout;
+    IOReturn rc = command(2, 0, C_R2, 0, 0, r);
+    IOLog("S5MMC: CMD2 -> %08x\n", (unsigned)rc);
+    if (rc == kIOReturnSuccess) {
+        rc = command(3, rca, C_R1, 0, 0, r);
+        IOLog("S5MMC: CMD3 -> %08x r=%08x\n", (unsigned)rc, (unsigned)r[0]);
+    }
+    if (rc == kIOReturnSuccess) {
+        rc = command(7, rca, C_R1B, 0, 0, r);
+        IOLog("S5MMC: CMD7 -> %08x r=%08x\n", (unsigned)rc, (unsigned)r[0]);
+    }
+    if (rc == kIOReturnSuccess) {
+        rc = waitTran();
+        IOLog("S5MMC: TRAN wait -> %08x\n", (unsigned)rc);
+    }
+    if (rc == kIOReturnSuccess) {
+        baseMHz = base;
+        setClockDiv((base + 49U) / 50U); /* <= 25 MHz */
+    }
+    return rc;
+}
+
+IOReturn IOS7S5SDHCI::transfer(UInt64 sector, UInt32 count, UInt8 *bytes, bool writing)
+{
+    UInt32 r[4];
+    bool multi = count > 1;
+    UInt32 xfer = (writing ? 0U : (1U << 4)) | (multi ? ((1U << 5) | (1U << 1) | (1U << 2)) : 0U);
+    UInt32 index = writing ? (multi ? 25U : 24U) : (multi ? 18U : 17U);
+    IOReturn rc = command(index, (UInt32)sector, C_R1 | C_DATA, xfer, count, r);
+    if (rc == kIOReturnSuccess && (r[0] & r1Errors))
+        rc = kIOReturnIOError;
+    UInt32 *w = (UInt32 *)bytes; /* IOMalloc'd: 4-byte aligned */
+    for (UInt32 b = 0; rc == kIOReturnSuccess && b < count; ++b) {
+        UInt32 want = writing ? I_WR_READY : I_RD_READY;
+        unsigned n;
+        for (n = 0; n < pollLimit; ++n) {
+            UInt32 s = rd(H_INT);
+            if (s & I_ERROR) {
+                IOLog("S5MMC: data err %04x blk %u/%u\n", (unsigned)(s >> 16), (unsigned)b, (unsigned)count);
+                rc = (s & (1U << 20)) ? kIOReturnTimeout : kIOReturnIOError;
+                break;
+            }
+            if (s & want)
+                break;
+            spinUs(1);
+        }
+        if (rc != kIOReturnSuccess)
+            break;
+        if (n == pollLimit) {
+            rc = kIOReturnTimeout;
+            break;
+        }
+        wr(H_INT, want);
+        for (unsigned k = 0; k < 128; ++k) {
+            if (writing)
+                *(volatile UInt32 *)(regs + SDHCI + H_BUF) = w[b * 128U + k];
+            else
+                w[b * 128U + k] = *(volatile UInt32 *)(regs + SDHCI + H_BUF);
+        }
+    }
+    if (rc == kIOReturnSuccess) {
+        unsigned n;
+        for (n = 0; n < pollLimit; ++n) {
+            UInt32 s = rd(H_INT);
+            if (s & I_ERROR) {
+                rc = kIOReturnIOError;
+                break;
+            }
+            if (s & I_XFER_DONE)
+                break;
+            spinUs(1);
+        }
+        if (n == pollLimit)
+            rc = kIOReturnTimeout;
+        wr(H_INT, I_XFER_DONE);
+    }
+    if (rc != kIOReturnSuccess) {
+        wr(H_INT, 0xffffffffU);
+        resetLines(6);
+        if (multi)
+            command(12, 0, C_R1B, 0, 0, r);
+        return rc;
+    }
+    if (writing)
+        rc = waitTran();
+    return rc;
+}
+
+/* userdata sector 0 still reads with the MBR signature: the check after every bus change */
+bool IOS7S5SDHCI::probeRead()
+{
+    static UInt8 s[512] __attribute__((aligned(4)));
+    s[510] = s[511] = 0;
+    return transfer(DISK_FIRST, 1, s, false) == kIOReturnSuccess && s[510] == 0x55 && s[511] == 0xaa;
+}
+
+/*
+ * After a full identification the card runs 1-bit at <= 25 MHz. Go 8-bit (EXT_CSD BUS_WIDTH 183 = 2, host control bit 5),
+ * then high speed (HS_TIMING 185 = 1, host control bit 2, <= 50 MHz), each step checked with a read and undone if the
+ * read fails. Logs a rough read speed (2 MiB) before and after; the timebase is the 19.2 MHz generic timer.
+ */
+void IOS7S5SDHCI::widen()
+{
+    UInt32 r[4];
+    static UInt8 buf[65536] __attribute__((aligned(4)));
+    UInt64 t0 = mach_absolute_time();
+    for (unsigned i = 0; i < 32; ++i)
+        transfer(DISK_FIRST + i * 128U, 128, buf, false);
+    UInt64 t1 = mach_absolute_time();
+    IOLog("S5MMC: 1-bit 25 MHz: 2 MiB in %u ms\n", (unsigned)((t1 - t0) / 19200U));
+    if (command(6, (3U << 24) | (183U << 16) | (2U << 8), C_R1B, 0, 0, r) == kIOReturnSuccess && waitTran() == kIOReturnSuccess) {
+        wr(H_HOST, (rd(H_HOST) & ~(1U << 1)) | (1U << 5));
+        if (probeRead())
+            IOLog("S5MMC: 8-bit bus ok\n");
+        else {
+            wr(H_HOST, rd(H_HOST) & ~(1U << 5));
+            command(6, (3U << 24) | (183U << 16), C_R1B, 0, 0, r);
+            waitTran();
+            IOLog("S5MMC: 8-bit failed, back to 1-bit (read %d)\n", (int)probeRead());
+        }
+    }
+    if (command(6, (3U << 24) | (185U << 16) | (1U << 8), C_R1B, 0, 0, r) == kIOReturnSuccess && waitTran() == kIOReturnSuccess) {
+        wr(H_HOST, rd(H_HOST) | (1U << 2));
+        setClockDiv((baseMHz + 99U) / 100U); /* <= 50 MHz */
+        if (probeRead())
+            IOLog("S5MMC: high speed 50 MHz ok\n");
+        else {
+            setClockDiv((baseMHz + 49U) / 50U);
+            IOLog("S5MMC: high speed failed, back to 25 MHz (read %d)\n", (int)probeRead());
+        }
+    }
+    t0 = mach_absolute_time();
+    for (unsigned i = 0; i < 32; ++i)
+        transfer(DISK_FIRST + i * 128U, 128, buf, false);
+    t1 = mach_absolute_time();
+    IOLog("S5MMC: now: 2 MiB in %u ms, host=%08x clk=%08x\n", (unsigned)((t1 - t0) / 19200U), (unsigned)rd(H_HOST),
+        (unsigned)rd(H_CLK));
+}
+
+bool IOS7S5SDHCI::start(IOService *provider)
+{
+    if (!IOBlockStorageDevice::start(provider))
+        return false;
+    mutex = IOLockAlloc();
+    if (!mutex)
+        return false;
+    mmio = IOMemoryDescriptor::withPhysicalAddress(SDCC1_PA, 4096, kIODirectionInOut);
+    if (!mmio)
+        return false;
+    map = mmio->map(kIOMapInhibitCache);
+    if (!map || !map->getAddress()) {
+        IOLog("S5MMC: map failed\n");
+        return false;
+    }
+    regs = (volatile UInt8 *)map->getAddress();
+    IOLog("S5MMC: present=%08x host=%08x clk=%08x hc2=%08x caps=%08x int=%08x inten=%08x mci_hcmode=%08x\n",
+        (unsigned)rd(H_PRESENT), (unsigned)rd(H_HOST), (unsigned)rd(H_CLK), (unsigned)rd(H_HC2), (unsigned)rd(H_CAPS),
+        (unsigned)rd(H_INT), (unsigned)rd(H_INTEN), (unsigned)*(volatile UInt32 *)(regs + 0x78));
+    /* MSM SDCC core: HC_MODE (MCI +0x78) bit 0 routes the SDHCI interface to the card. LK switches it back to the legacy
+     * MCI mode before booting (the CM kernel's msm_sdcc driver wants that), so every SDHCI command timed out (first S5
+     * storage run: mci_hcmode=0). Turn SDHCI mode back on; LK's SDHCI register state (clock, power, bus) is still there. */
+    if (!(*(volatile UInt32 *)(regs + 0x78) & 1U)) {
+        UInt32 host0 = rd(H_HOST), clk0 = rd(H_CLK);
+        *(volatile UInt32 *)(regs + 0x78) = 1U;
+        __asm__ __volatile__("dsb sy" ::: "memory");
+        spinUs(1000);
+        IOLog("S5MMC: SDHCI mode on: hcmode=%08x present=%08x host=%08x clk=%08x\n", (unsigned)*(volatile UInt32 *)(regs + 0x78),
+            (unsigned)rd(H_PRESENT), (unsigned)rd(H_HOST), (unsigned)rd(H_CLK));
+        /* The switch dropped bus power (power register 0x0b -> 0) and the SD clock (second run). Put LK's values back.
+         * On the MSM core a power-register write raises a power-control request that software must acknowledge (the
+         * regulators are already on: LK used the card): PWRCTL_STATUS +0xdc, CLEAR +0xe4, CTL +0xe8 in the MCI block;
+         * BUS_ON/OFF (bits 1/0) -> BUS_SUCCESS (bit 0), IO_HIGH/LOW (bits 3/2) -> IO_SUCCESS (bit 2). */
+        wr(H_HOST, host0);
+        for (unsigned k = 0; k < 4; ++k) {
+            spinUs(1000);
+            UInt32 st = *(volatile UInt32 *)(regs + 0xdc);
+            if (!st)
+                continue;
+            *(volatile UInt32 *)(regs + 0xe4) = st;
+            *(volatile UInt32 *)(regs + 0xe8) = ((st & 3U) ? 1U : 0U) | ((st & 0xcU) ? 4U : 0U);
+            __asm__ __volatile__("dsb sy" ::: "memory");
+            IOLog("S5MMC: pwrctl status %08x acked\n", (unsigned)st);
+        }
+        wr(H_CLK, (clk0 & ~4U) | 1U);
+        for (unsigned n = 0; n < 100000 && !(rd(H_CLK) & 2U); ++n)
+            spinUs(1);
+        wr(H_CLK, rd(H_CLK) | 4U);
+        spinUs(1000);
+        resetLines(6);
+        IOLog("S5MMC: restored host=%08x clk=%08x present=%08x\n", (unsigned)rd(H_HOST), (unsigned)rd(H_CLK),
+            (unsigned)rd(H_PRESENT));
+    }
+    wr(H_SIGEN, 0);            /* no interrupt lines */
+    wr(H_INTEN, 0x03ff00ffU);  /* latch the normal and error status we poll */
+    wr(H_INT, 0xffffffffU);
+    if (!(rd(H_CLK) & 4U)) {
+        IOLog("S5MMC: SD clock was off, enabling\n");
+        wr(H_CLK, rd(H_CLK) | 1U);
+        IOSleep(1);
+        wr(H_CLK, rd(H_CLK) | 4U);
+    }
+    IOLog("S5MMC: waking card\n");
+    IOReturn rc = wake();
+    if (rc != kIOReturnSuccess) {
+        /* run 8: one identification timed out after CMD1 (worked on runs 3-7): retry from CMD0 a few times */
+        for (unsigned attempt = 0; attempt < 4; ++attempt) {
+            rc = identify();
+            IOLog("S5MMC: identify #%u -> %08x\n", attempt, (unsigned)rc);
+            if (rc == kIOReturnSuccess)
+                break;
+            resetLines(6);
+            IOSleep(50);
+        }
+        if (rc != kIOReturnSuccess)
+            return false;
+        widen();
+    }
+    IOLog("S5MMC: card in TRAN at rca %u\n", (unsigned)(rca >> 16));
+    /* check the window: the first sector of userdata */
+    static UInt8 first[512] __attribute__((aligned(4)));
+    rc = transfer(DISK_FIRST, 1, first, false);
+    IOLog("S5MMC: read userdata sector 0 -> %08x, signature %02x%02x, first words %02x%02x%02x%02x\n", (unsigned)rc,
+        first[510], first[511], first[0], first[1], first[2], first[3]);
+    if (rc != kIOReturnSuccess)
+        return false;
+    initialized = true;
+    {
+        extern void s5LogThread(void *);
+        retain(); /* held by the log thread for the rest of the run */
+        IOCreateThread(s5LogThread, this);
+    }
+    OSObject *dec = OSUnserializeXML(ios7labStoragePersonalities);
+    OSArray *drv = OSDynamicCast(OSArray, dec);
+    if (!drv || !gIOCatalogue->addDrivers(drv, false)) {
+        if (dec)
+            dec->release();
+        return false;
+    }
+    dec->release();
+    return true;
+}
+
+void IOS7S5SDHCI::free()
+{
+    if (mutex)
+        IOLockFree(mutex);
+    if (map)
+        map->release();
+    if (mmio)
+        mmio->release();
+    IOBlockStorageDevice::free();
+}
+
+char *IOS7S5SDHCI::getVendorString() { static char t[] = "Hynix"; return t; }
+char *IOS7S5SDHCI::getProductString() { static char t[] = "H16GE2 eMMC userdata"; return t; }
