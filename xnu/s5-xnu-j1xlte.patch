diff --git a/xnu/security/mac_base.c b/xnu/security/mac_base.c
index 31f625a..12c4601 100644
--- a/xnu/security/mac_base.c
+++ b/xnu/security/mac_base.c
@@ -2125,6 +2125,46 @@ __mac_syscall(proc_t p, struct __mac_syscall_args *uap, int *retv __unused)
 	AUDIT_ARG(value32, uap->call);
 	AUDIT_ARG(mac_string, target);
 
+#ifdef J1_S4MINI
+	/* No Sandbox.kext on these ports: sandbox_init() failed with ENOPOLICY and daemons that sandbox themselves at
+	 * startup (tccd: "sandbox_init: %s" then abort) died in a respawn loop, leaving SpringBoard waiting on them
+	 * (S5 run 13, TCCAccessPreflight). Accept Sandbox policy calls as successful no-ops. */
+	if (strcmp(target, "Sandbox") == 0) {
+		static int logged;
+		if (uap->call != 2 && logged++ < 40)	/* call 2 (checks) floods the log: run 19 */
+			printf("J1SANDBOX pid %d %s call %d\n", proc_pid(p), p->p_comm, uap->call);
+	}
+	if (strcmp(target, "Sandbox") == 0 && (uap->call == 0 || uap->call == 1))	/* 1: named profile (tccd, mDNSResponder; run 21) */
+		return (0);	/* only sandbox_init's "set profile": answering every Sandbox call (queries
+				 * included) with success broke launchctl's bootstrapper in runs 14-17 */
+#if defined(J1_S5) || !defined(J1_TAB2)	/* S4 Mini too (2026-11-08): its tccd/assetsd need the same for Photos */
+	/* Run 104: tccd grants Photos access by issuing a sandbox extension (call 5); it failed with ENOPOLICY, so TCC
+	 * could not grant and assetsd threw "Application should be allowed to access the photo service, but can't".
+	 * libsystem_sandbox ABI (iOS 7): issue = {u64 class, u64 type, u64 path, u64 flags, u64 token_buf[2048]},
+	 * consume (6) = {u64 token, u64 len, u64 handle_out}, release (7). Nothing is enforced without Sandbox.kext,
+	 * so hand out a placeholder token and handle. */
+	if (strcmp(target, "Sandbox") == 0 && (uap->call == 5 || uap->call == 6 || uap->call == 7)) {
+		uint64_t a[5];
+		static int j1_ext_logs;
+		size_t n = uap->call == 5 ? 40 : 24;
+		if (uap->call == 7)
+			return (0);
+		if ((error = copyin(uap->arg, a, n)) != 0)
+			return (error);
+		if (uap->call == 5) {
+			static const char tok[] = "j1-sandbox-extension";
+			error = copyout(tok, (user_addr_t)a[4], sizeof(tok));
+		} else {
+			uint64_t h = 1;
+			error = copyout(&h, (user_addr_t)a[2], sizeof(h));
+		}
+		if (j1_ext_logs++ < 20)
+			printf("J1SANDBOX ext call %d by %s err %d\n", uap->call, p->p_comm, error);
+		return (error);
+	}
+#endif
+#endif
+
 	error = ENOPOLICY;
 
 	for (i = 0; i < mac_policy_list.staticmax; i++) {
